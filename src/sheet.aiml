# Reading a *.chart.yaml into a Sheet (doc/spec/chart.md §4).
- import: "src/sheet_model.aiml"

- class:
    name: SheetIO
    description: "Loads the canonical sheet; the only place a member name appears as text"
    methods:
      # Index of `key` in a mapping node, -1 when absent.
      - def:
          name: kv_index
          static_off: ["same_arg", "str_cmp"]
          args: [[node, ref<yaml_node>], [key, string]]
          return: i32
          body:
            - decl: [idx, i32, 0]
            - decl: [total, i32, { call: [yaml.size, node] }]
            - while:
                condition: { lt: [idx, total] }
                body:
                  - decl: [key_text, string, { call: [yaml.key, node, idx] }]
                  - if: { condition: { eq: [key_text, key] }, then: [{ return: idx }] }
                  - set: [idx, { +: [idx, 1] }]
            - return: -1

      # Scalar value of `key`, or `fallback` when the key is absent.
      - def:
          name: kv_text
          static_off: ["same_arg", "str_cmp"]
          args: [[node, ref<yaml_node>], [key, string], [fallback, string]]
          return: string
          body:
            - decl: [idx, i32, { call: [<.kv_index, node, key] }]
            - if: { condition: { lt: [idx, 0] }, then: [{ return: fallback }] }
            - decl: [val_node, ref<yaml_node>, { call: [yaml.value, node, idx] }]
            - return: { call: [yaml.scalar, val_node] }

      - def:
          name: kv_f32
          static_off: ["same_arg", "str_cmp"]
          args: [[node, ref<yaml_node>], [key, string]]
          return: f32
          body:
            - decl: [text, string, { call: [<.kv_text, node, key, ""] }]
            - if: { condition: { eq: [text, ""] }, then: [{ return: 0.0 }] }
            - return: { call: [text.parse_f32] }

      - def:
          name: kv_i32
          static_off: ["same_arg", "str_cmp"]
          args: [[node, ref<yaml_node>], [key, string]]
          return: i32
          body:
            - decl: [text, string, { call: [<.kv_text, node, key, ""] }]
            - if: { condition: { eq: [text, ""] }, then: [{ return: 0 }] }
            - return: { call: [text.parse_i32] }

      # Member name -> NodeKind.  Returns -1 for an unknown word: spec §4 forbids
      # defaulting it silently, because a sheet that lost a shape without saying so
      # is the same failure class as treating the Mermaid as the document (§2).
      - def:
          name: node_kind
          static_off: ["same_arg", "str_cmp"]
          args: [[word, string]]
          return: i32
          body:
            - if: { condition: { eq: [word, "rect"] },       then: [{ return: NodeKind.rect }] }
            - if: { condition: { eq: [word, "round"] },      then: [{ return: NodeKind.round }] }
            - if: { condition: { eq: [word, "stadium"] },    then: [{ return: NodeKind.stadium }] }
            - if: { condition: { eq: [word, "circle"] },     then: [{ return: NodeKind.circle }] }
            - if: { condition: { eq: [word, "diamond"] },    then: [{ return: NodeKind.diamond }] }
            - if: { condition: { eq: [word, "hexagon"] },    then: [{ return: NodeKind.hexagon }] }
            - if: { condition: { eq: [word, "cylinder"] },   then: [{ return: NodeKind.cylinder }] }
            - if: { condition: { eq: [word, "text"] },       then: [{ return: NodeKind.text }] }
            - if: { condition: { eq: [word, "asymmetric"] },        then: [{ return: NodeKind.asymmetric }] }
            - if: { condition: { eq: [word, "trapezoid"] },         then: [{ return: NodeKind.trapezoid }] }
            - if: { condition: { eq: [word, "trapezoid_alt"] },     then: [{ return: NodeKind.trapezoid_alt }] }
            - if: { condition: { eq: [word, "parallelogram"] },     then: [{ return: NodeKind.parallelogram }] }
            - if: { condition: { eq: [word, "parallelogram_alt"] }, then: [{ return: NodeKind.parallelogram_alt }] }
            - if: { condition: { eq: [word, "double_circle"] },     then: [{ return: NodeKind.double_circle }] }
            - if: { condition: { eq: [word, "actor"] },             then: [{ return: NodeKind.actor }] }
            - if: { condition: { eq: [word, "subroutine"] }, then: [{ return: NodeKind.subroutine }] }
            - if: { condition: { eq: [word, "image"] },      then: [{ return: NodeKind.image }] }
            - return: -1

      - def:
          name: edge_kind
          static_off: ["same_arg", "str_cmp"]
          args: [[word, string]]
          return: i32
          body:
            - if: { condition: { eq: [word, "arrow"] },         then: [{ return: EdgeKind.arrow }] }
            - if: { condition: { eq: [word, "open"] },          then: [{ return: EdgeKind.open }] }
            - if: { condition: { eq: [word, "dotted"] },        then: [{ return: EdgeKind.dotted }] }
            - if: { condition: { eq: [word, "thick"] },         then: [{ return: EdgeKind.thick }] }
            - if: { condition: { eq: [word, "bidirectional"] }, then: [{ return: EdgeKind.bidirectional }] }
            - if: { condition: { eq: [word, "invisible"] },     then: [{ return: EdgeKind.invisible }] }
            - return: -1

      - def:
          name: line_style
          static_off: ["same_arg", "str_cmp"]
          args: [[word, string]]
          return: i32
          body:
            - if: { condition: { eq: [word, "solid"] },     then: [{ return: LineStyle.solid }] }
            - if: { condition: { eq: [word, "dotted"] },    then: [{ return: LineStyle.dotted }] }
            - if: { condition: { eq: [word, "thick"] },     then: [{ return: LineStyle.thick }] }
            - if: { condition: { eq: [word, "invisible"] }, then: [{ return: LineStyle.invisible }] }
            - return: -1

      - def:
          name: end_cap
          static_off: ["same_arg", "str_cmp"]
          args: [[word, string]]
          return: i32
          body:
            - if: { condition: { eq: [word, "none"] },   then: [{ return: EndCap.none }] }
            - if: { condition: { eq: [word, "arrow"] },  then: [{ return: EndCap.arrow }] }
            - if: { condition: { eq: [word, "circle"] }, then: [{ return: EndCap.circle }] }
            - if: { condition: { eq: [word, "cross"] },  then: [{ return: EndCap.cross }] }
            - if: { condition: { eq: [word, "hollow"] }, then: [{ return: EndCap.hollow }] }
            - return: -1

      # §4.1a: the old single `kind:` becomes the three fields.  Read, never written.
      - def:
          name: from_legacy
          args: [[old_kind, i32], [edge, ref<Edge>]]
          body:
            - set: [edge.line, LineStyle.solid]
            - set: [edge.head, EndCap.arrow]
            - set: [edge.tail, EndCap.none]
            - if: { condition: { eq: [old_kind, EdgeKind.open] }, then: [{ set: [edge.head, EndCap.none] }] }
            - if: { condition: { eq: [old_kind, EdgeKind.dotted] }, then: [{ set: [edge.line, LineStyle.dotted] }] }
            - if: { condition: { eq: [old_kind, EdgeKind.thick] }, then: [{ set: [edge.line, LineStyle.thick] }] }
            - if: { condition: { eq: [old_kind, EdgeKind.bidirectional] }, then: [{ set: [edge.tail, EndCap.arrow] }] }
            - if:
                condition: { eq: [old_kind, EdgeKind.invisible] }
                then:
                  - set: [edge.line, LineStyle.invisible]
                  - set: [edge.head, EndCap.none]

      - def:
          name: direction
          static_off: ["same_arg", "str_cmp"]
          args: [[word, string]]
          return: i32
          body:
            - if: { condition: { eq: [word, "TD"] }, then: [{ return: Direction.TD }] }
            - if: { condition: { eq: [word, "LR"] }, then: [{ return: Direction.LR }] }
            - if: { condition: { eq: [word, "BT"] }, then: [{ return: Direction.BT }] }
            - if: { condition: { eq: [word, "RL"] }, then: [{ return: Direction.RL }] }
            - return: -1

      - def:
          name: diagram_type
          static_off: ["same_arg", "str_cmp"]
          args: [[word, string]]
          return: i32
          body:
            - if: { condition: { eq: [word, "flowchart"] },     then: [{ return: DiagramType.flowchart }] }
            - if: { condition: { eq: [word, "sequence"] },      then: [{ return: DiagramType.sequence }] }
            - if: { condition: { eq: [word, "state"] },         then: [{ return: DiagramType.state }] }
            - if: { condition: { eq: [word, "class_diagram"] }, then: [{ return: DiagramType.class_diagram }] }
            - return: -1

      # Read one slide out of a mapping node.  1 on success, 0 on a reported
      # failure -- the caller owns the document and frees it either way.
      - def:
          name: read_sheet
          static_off: ["same_arg", "str_cmp"]
          args: [[path, string], [root, ref<yaml_node>], [sheet, ref<Sheet>]]
          return: i32
          body:
            - decl: [dtype_word, string, { call: [<.kv_text, root, "dtype", "flowchart"] }]
            - decl: [dtype_val, i32, { call: [<.diagram_type, dtype_word] }]
            - if:
                condition: { lt: [dtype_val, 0] }
                then:
                  - call: [log.error, "chart: ${path}: unknown dtype '${dtype_word}'"]
                  - return: 0
            - set: [sheet.dtype, dtype_val]

            - decl: [dir_word, string, { call: [<.kv_text, root, "dir", "TD"] }]
            - decl: [dir_val, i32, { call: [<.direction, dir_word] }]
            - if:
                condition: { lt: [dir_val, 0] }
                then:
                  - call: [log.error, "chart: ${path}: unknown dir '${dir_word}'"]
                  - return: 0
            - set: [sheet.dir, dir_val]
            - set: [sheet.title, { call: [<.kv_text, root, "title", ""] }]
            - set: [sheet.notes, { call: [<.kv_text, root, "notes", ""] }]
            - set: [sheet.next_id, { call: [<.kv_i32, root, "next_id"] }]

            # groups
            - decl: [groups_idx, i32, { call: [<.kv_index, root, "groups"] }]
            - if:
                condition: { ge: [groups_idx, 0] }
                then:
                  - decl: [groups_node, ref<yaml_node>, { call: [yaml.value, root, groups_idx] }]
                  - decl: [gidx, i32, 0]
                  - while:
                      condition: { lt: [gidx, { call: [yaml.size, groups_node] }] }
                      body:
                        - decl: [item, ref<yaml_node>, { call: [yaml.item, groups_node, gidx] }]
                        - decl: [group, Group]
                        - set: [group.ident, { call: [<.kv_text, item, "id", ""] }]
                        - set: [group.title, { call: [<.kv_text, item, "title", ""] }]
                        - set: [group.parent, { call: [<.kv_text, item, "parent", ""] }]
                        - call: [sheet.groups.push, group]
                        - set: [gidx, { +: [gidx, 1] }]

            # nodes
            - decl: [nodes_idx, i32, { call: [<.kv_index, root, "nodes"] }]
            - if:
                condition: { ge: [nodes_idx, 0] }
                then:
                  - decl: [nodes_node, ref<yaml_node>, { call: [yaml.value, root, nodes_idx] }]
                  - decl: [nidx, i32, 0]
                  - while:
                      condition: { lt: [nidx, { call: [yaml.size, nodes_node] }] }
                      body:
                        - decl: [item, ref<yaml_node>, { call: [yaml.item, nodes_node, nidx] }]
                        - decl: [node, Node]
                        - set: [node.ident, { call: [<.kv_text, item, "id", ""] }]
                        - decl: [kind_word, string, { call: [<.kv_text, item, "kind", "rect"] }]
                        - decl: [kind_val, i32, { call: [<.node_kind, kind_word] }]
                        - if:
                            condition: { lt: [kind_val, 0] }
                            then:
                              - call: [log.error, "chart: ${path}: node '${node.ident}' has unknown kind '${kind_word}'"]
                              - return: 0
                        - set: [node.kind, kind_val]
                        - set: [node.pos_x, { call: [<.kv_f32, item, "x"] }]
                        - set: [node.pos_y, { call: [<.kv_f32, item, "y"] }]
                        - set: [node.width, { call: [<.kv_f32, item, "w"] }]
                        - set: [node.height, { call: [<.kv_f32, item, "h"] }]
                        - set: [node.text, { call: [<.kv_text, item, "text", ""] }]
                        - set: [node.src, { call: [<.kv_text, item, "src", ""] }]
                        - set: [node.fill, { call: [<.kv_i32, item, "fill"] }]
                        - set: [node.stroke, { call: [<.kv_i32, item, "stroke"] }]
                        - set: [node.group, { call: [<.kv_text, item, "group", ""] }]
                        - call: [sheet.nodes.push, node]
                        - set: [nidx, { +: [nidx, 1] }]

            # edges
            - decl: [edges_idx, i32, { call: [<.kv_index, root, "edges"] }]
            - if:
                condition: { ge: [edges_idx, 0] }
                then:
                  - decl: [edges_node, ref<yaml_node>, { call: [yaml.value, root, edges_idx] }]
                  - decl: [eidx, i32, 0]
                  - while:
                      condition: { lt: [eidx, { call: [yaml.size, edges_node] }] }
                      body:
                        - decl: [item, ref<yaml_node>, { call: [yaml.item, edges_node, eidx] }]
                        - decl: [edge, Edge]
                        - set: [edge.ident, { call: [<.kv_text, item, "id", ""] }]
                        - set: [edge.from_id, { call: [<.kv_text, item, "from_id", ""] }]
                        - set: [edge.to_id, { call: [<.kv_text, item, "to_id", ""] }]
                        - decl: [old_word, string, { call: [<.kv_text, item, "kind", ""] }]
                        - decl: [line_word, string, { call: [<.kv_text, item, "line", ""] }]
                        - decl: [head_word, string, { call: [<.kv_text, item, "head", ""] }]
                        - decl: [tail_word, string, { call: [<.kv_text, item, "tail", ""] }]
                        - decl: [has_new, i32, 0]
                        - if: { condition: { neq: [line_word, ""] }, then: [{ set: [has_new, 1] }] }
                        - if: { condition: { neq: [head_word, ""] }, then: [{ set: [has_new, 1] }] }
                        - if: { condition: { neq: [tail_word, ""] }, then: [{ set: [has_new, 1] }] }
                        # both spellings would be the file saying two things (§4.1a)
                        - if:
                            condition: { "&&": [{ neq: [old_word, ""] }, { eq: [has_new, 1] }] }
                            then:
                              - call: [log.error, "chart: ${path}: edge '${edge.ident}' hat 'kind' UND 'line/head/tail' -- was gilt? (spec §4.1a)"]
                              - return: 0
                        - if:
                            condition: { neq: [old_word, ""] }
                            then:
                              - decl: [old_val, i32, { call: [<.edge_kind, old_word] }]
                              - if:
                                  condition: { lt: [old_val, 0] }
                                  then:
                                    - call: [log.error, "chart: ${path}: edge '${edge.ident}' has unknown kind '${old_word}'"]
                                    - return: 0
                              - call: [<.from_legacy, old_val, edge]
                            else:
                              - if: { condition: { eq: [line_word, ""] }, then: [{ set: [line_word, "solid"] }] }
                              - if: { condition: { eq: [head_word, ""] }, then: [{ set: [head_word, "arrow"] }] }
                              - if: { condition: { eq: [tail_word, ""] }, then: [{ set: [tail_word, "none"] }] }
                              - decl: [line_val, i32, { call: [<.line_style, line_word] }]
                              - decl: [head_val, i32, { call: [<.end_cap, head_word] }]
                              - decl: [tail_val, i32, { call: [<.end_cap, tail_word] }]
                              - if:
                                  condition: { "||": [{ lt: [line_val, 0] }, { "||": [{ lt: [head_val, 0] }, { lt: [tail_val, 0] }] }] }
                                  then:
                                    - call: [log.error, "chart: ${path}: edge '${edge.ident}': unbekanntes line/head/tail ('${line_word}' '${head_word}' '${tail_word}')"]
                                    - return: 0
                              - set: [edge.line, line_val]
                              - set: [edge.head, head_val]
                              - set: [edge.tail, tail_val]
                        - set: [edge.text, { call: [<.kv_text, item, "text", ""] }]
                        - set: [edge.stroke, { call: [<.kv_i32, item, "stroke"] }]
                        - call: [sheet.edges.push, edge]
                        - set: [eidx, { +: [eidx, 1] }]
            - return: 1

      # Load `path` into `deck`.  A file with `slides:` is a deck; any other mapping
      # is a one-slide deck, so a *.chart.yaml keeps loading as it always did
      # (spec §11.1).  1 on success, 0 on a reported failure.
      - def:
          name: load
          static_off: ["same_arg", "str_cmp"]
          args: [[path, string], [deck, ref<Deck>]]
          return: i32
          body:
            - decl: [document, ptr<yaml_doc>, { call: [yaml.parse_file, path] }]
            - decl: [error_text, string, { call: [yaml.error, document] }]
            - if:
                condition: { neq: [error_text, ""] }
                then:
                  - call: [log.error, "chart: ${path}: ${error_text}"]
                  - call: [yaml.free, document]
                  - return: 0
            - decl: [root, ref<yaml_node>, { call: [yaml.root, document] }]
            - set: [deck.title, { call: [<.kv_text, root, "title", ""] }]
            - decl: [slides_idx, i32, { call: [<.kv_index, root, "slides"] }]
            - if:
                condition: { lt: [slides_idx, 0] }
                then:
                  - decl: [single, Sheet]
                  - decl: [ok_single, i32, { call: [<.read_sheet, path, root, single] }]
                  - if:
                      condition: { eq: [ok_single, 0] }
                      then:
                        - call: [yaml.free, document]
                        - return: 0
                  # A lone sheet carries no deck title of its own; its slide title stands in.
                  - if: { condition: { eq: [deck.title, ""] }, then: [{ set: [deck.title, single.title] }] }
                  - call: [deck.slides.push, single]
                  - call: [yaml.free, document]
                  - return: 1
            - decl: [slides_node, ref<yaml_node>, { call: [yaml.value, root, slides_idx] }]
            - decl: [sidx, i32, 0]
            - while:
                condition: { lt: [sidx, { call: [yaml.size, slides_node] }] }
                body:
                  - decl: [item, ref<yaml_node>, { call: [yaml.item, slides_node, sidx] }]
                  - decl: [slide, Sheet]
                  - decl: [ok_slide, i32, { call: [<.read_sheet, path, item, slide] }]
                  - if:
                      condition: { eq: [ok_slide, 0] }
                      then:
                        - call: [yaml.free, document]
                        - return: 0
                  - call: [deck.slides.push, slide]
                  - set: [sidx, { +: [sidx, 1] }]
            - if:
                condition: { eq: [deck.slides.len, 0] }
                then:
                  - call: [log.error, "chart: ${path}: 'slides' is empty -- a deck needs at least one slide"]
                  - call: [yaml.free, document]
                  - return: 0
            - call: [yaml.free, document]
            - return: 1

      # YAML escaping for a double-quoted scalar.
      - def:
          name: esc_yaml
          static_off: ["same_arg", "str_cmp"]
          args: [[text, string]]
          return: string
          body:
            - decl: [flat, string, { call: [text.replace, "\\", "\\\\"] }]
            - set: [flat, { call: [flat.replace, "\"", "\\\""] }]
            - set: [flat, { call: [flat.replace, "\n", "\\n"] }]
            - return: flat

      # The deck as YAML -- a pure function, so a round trip can be checked byte for
      # byte.  The member words come from enums.name: a second hand-written inverse
      # of the vocabulary would be a second place to forget a member.
      - def:
          name: deck_yaml
          static_off: ["same_arg", "str_cmp"]
          args: [[deck, ref<Deck>]]
          return: string
          body:
            - decl: [out, string, "title: \"${ { call: [<.esc_yaml, deck.title] } }\"\nslides:\n"]
            - decl: [sidx, i32, 0]
            - while:
                condition: { lt: [sidx, deck.slides.len] }
                body:
                  - decl: [slide, ref<Sheet>, { at: [deck.slides, sidx] }]
                  - decl: [dtype_word, string, { call: [enums.name, "DiagramType", slide.dtype] }]
                  - decl: [dir_word, string, { call: [enums.name, "Direction", slide.dir] }]
                  - set: [out, "${out}  - title: \"${ { call: [<.esc_yaml, slide.title] } }\"\n"]
                  - set: [out, "${out}    dtype: ${dtype_word}\n    dir: ${dir_word}\n"]
                  - if:
                      condition: { neq: [slide.notes, ""] }
                      then: [{ set: [out, "${out}    notes: \"${ { call: [<.esc_yaml, slide.notes] } }\"\n"] }]
                  - set: [out, "${out}    next_id: ${slide.next_id}\n"]
                  - if:
                      condition: { gt: [slide.groups.len, 0] }
                      then:
                        - set: [out, "${out}    groups:\n"]
                        - decl: [gidx, i32, 0]
                        - while:
                            condition: { lt: [gidx, slide.groups.len] }
                            body:
                              - decl: [group, ref<Group>, { at: [slide.groups, gidx] }]
                              - set: [out, "${out}      - { id: ${group.ident}, title: \"${ { call: [<.esc_yaml, group.title] } }\", parent: \"${group.parent}\" }\n"]
                              - set: [gidx, { +: [gidx, 1] }]
                  - if:
                      condition: { gt: [slide.nodes.len, 0] }
                      then:
                        - set: [out, "${out}    nodes:\n"]
                        - decl: [nidx, i32, 0]
                        - while:
                            condition: { lt: [nidx, slide.nodes.len] }
                            body:
                              - decl: [node, ref<Node>, { at: [slide.nodes, nidx] }]
                              - decl: [kind_word, string, { call: [enums.name, "NodeKind", node.kind] }]
                              - set: [out, "${out}      - { id: ${node.ident}, kind: ${kind_word}, x: ${node.pos_x}, y: ${node.pos_y}, w: ${node.width}, h: ${node.height}"]
                              - set: [out, "${out}, text: \"${ { call: [<.esc_yaml, node.text] } }\""]
                              - if: { condition: { neq: [node.src, ""] }, then: [{ set: [out, "${out}, src: \"${node.src}\""] }] }
                              - if: { condition: { neq: [node.fill, 0] }, then: [{ set: [out, "${out}, fill: ${node.fill}"] }] }
                              - if: { condition: { neq: [node.stroke, 0] }, then: [{ set: [out, "${out}, stroke: ${node.stroke}"] }] }
                              - if: { condition: { neq: [node.group, ""] }, then: [{ set: [out, "${out}, group: ${node.group}"] }] }
                              - set: [out, "${out} }\n"]
                              - set: [nidx, { +: [nidx, 1] }]
                  - if:
                      condition: { gt: [slide.edges.len, 0] }
                      then:
                        - set: [out, "${out}    edges:\n"]
                        - decl: [eidx, i32, 0]
                        - while:
                            condition: { lt: [eidx, slide.edges.len] }
                            body:
                              - decl: [edge, ref<Edge>, { at: [slide.edges, eidx] }]
                              - decl: [line_word, string, { call: [enums.name, "LineStyle", edge.line] }]
                              - decl: [head_word, string, { call: [enums.name, "EndCap", edge.head] }]
                              - decl: [tail_word, string, { call: [enums.name, "EndCap", edge.tail] }]
                              - set: [out, "${out}      - { id: ${edge.ident}, from_id: ${edge.from_id}, to_id: ${edge.to_id}"]
                              # only what differs from the default: the common edge
                              # stays one short line (spec §4)
                              - if: { condition: { neq: [edge.line, LineStyle.solid] }, then: [{ set: [out, "${out}, line: ${line_word}"] }] }
                              - if: { condition: { neq: [edge.head, EndCap.arrow] }, then: [{ set: [out, "${out}, head: ${head_word}"] }] }
                              - if: { condition: { neq: [edge.tail, EndCap.none] }, then: [{ set: [out, "${out}, tail: ${tail_word}"] }] }
                              - if: { condition: { neq: [edge.text, ""] }, then: [{ set: [out, "${out}, text: \"${ { call: [<.esc_yaml, edge.text] } }\""] }] }
                              # the edge's own colour: set by the menu (§8.2) and by
                              # `linkStyle` on import, and silently dropped here until
                              # an imported linkStyle came back colourless
                              - if: { condition: { neq: [edge.stroke, 0] }, then: [{ set: [out, "${out}, stroke: ${edge.stroke}"] }] }
                              - set: [out, "${out} }\n"]
                              - set: [eidx, { +: [eidx, 1] }]
                  - set: [sidx, { +: [sidx, 1] }]
            - return: out
