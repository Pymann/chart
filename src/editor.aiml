# The editor's hands and its frame (doc/spec/chart.md §15, §8.0): what the pointer
# and the keyboard do on the canvas, and the per-frame loop that drives everything
# below.  The leaf of the editor chain -- the classgroup names this class.
#
# A slide is a fixed 1280x720 page, scaled to fit and centred -- never re-laid-out
# (§14, normative): positions belong to the author, and a presentation that moved
# things to fit would show something the author never saw.
- import: "src/editor_act.aiml"

- class:
    name: Editor
    extends: EditorAct
    description: "Pointer, keyboard and the per-frame loop (spec §15, §8.0)"
    methods:
      # What a connect gesture MAKES depends on the diagram (spec §5.8.3): in a
      # sequence it is a message at the end of the step list -- the list is the time
      # axis -- and everywhere else an edge.  Its own method because canvas_input may
      # not grow past 300 lines (aiml spec/49 §3).
      - def:
          name: join_two
          static_off: ["same_arg", "str_cmp"]
          args: [[slide, ref<Sheet>], [from_id, string], [to_id, string]]
          body:
            - if:
                condition: { eq: [slide.dtype, DiagramType.sequence] }
                then:
                  - decl: [step, Step]
                  - set: [step.ident, "s${slide.next_id}"]
                  - set: [step.kind, StepKind.message]
                  - set: [step.from_id, from_id]
                  - set: [step.to_id, to_id]
                  - call: [slide.steps.push, step]
                  - call: [<.touch]
                  - set: [slide.next_id, { +: [slide.next_id, 1] }]
                  - set: [<.status, "Nachricht angelegt"]
                  - return: null
            - decl: [edge, Edge]
            - set: [edge.ident, "e${slide.next_id}"]
            - set: [edge.from_id, from_id]
            - set: [edge.to_id, to_id]
            - set: [edge.line, LineStyle.solid]
            - set: [edge.head, EndCap.arrow]
            - call: [slide.edges.push, edge]
            - call: [<.touch]
            - set: [slide.next_id, { +: [slide.next_id, 1] }]
            - set: [<.sel_edge, edge.ident]
            - set: [<.status, "Kante gezogen"]
      # What the CONNECT gesture may start or end on (spec §5.8.3): a node as usual,
      # and in a sequence also the participant's lifeline.
      - def:
          name: grab_at
          static_off: ["same_arg", "str_cmp"]
          args: [[slide, ref<Sheet>], [spot_x, f32], [spot_y, f32]]
          return: string
          body:
            - decl: [hit, string, { call: [<.grip.node_at, slide, spot_x, spot_y] }]
            - if: { condition: { neq: [hit, ""] }, then: [{ return: hit }] }
            - if: { condition: { neq: [slide.dtype, DiagramType.sequence] }, then: [{ return: "" }] }
            - return: { call: [<.seq.lane_at, slide, spot_x, spot_y] }

      # ── who owns the pointer (spec §8.0, §8.2) ───────────────────────────────
      # Its own method because canvas_input sits at the 300-line limit.  Returns 1
      # when an overlay consumed the frame.
      - def:
          name: overlay_claim
          args: [[mouse_x, f32], [mouse_y, f32]]
          return: i32
          body:
            # The same claim for the strips' dropdowns (§8.0).  They hang OVER the
            # canvas, and the canvas is asked first: without this a click on
            # `Kante > Fuss Pfeil` also landed on empty canvas, which dropped the
            # selection -- so the action arrived with nothing selected and did
            # nothing.  An overlay that draws on top must claim the pointer.
            - if:
                condition: { "||": [{ eq: [<.top_bar.shown, 1] }, { eq: [<.tools.type_open, 1] }] }
                then:
                  - call: [input.set_cursor, "arrow"]
                  - return: 1
            # §8.2: while the menu is open it owns the pointer.  An overlay that
            # draws on top but claims nothing lets the click through -- here that
            # would draw a stroke THROUGH the menu.
            - if:
                condition: { eq: [<.menu.shown, 1] }
                then:
                  - if:
                      condition: { call: [input.mouse_pressed, 0] }
                      then:
                        - decl: [took, i32, { call: [<.menu.press, mouse_x, mouse_y] }]
                        - if: { condition: { eq: [took, 1] }, then: [{ call: [<.menu_deed] }] }
                  - return: 1
            - return: 0

      # ── pan the view with the middle button (spec §8.4) ──────────────────────
      # Its own method because canvas_input sits at the 300-line limit.  Returns 1
      # when it consumed the frame, so the caller stops before drag and selection.
      - def:
          name: pan_drag
          args: [[mouse_x, f32], [mouse_y, f32], [over_canvas, i32]]
          return: i32
          body:
            # The right button pans, BY THE DRAG (spec §8.4).  It already meant two
            # things -- read the ink, open the element menu -- so the movement decides:
            # past 6 window pixels it is a pan, below it stays the old right click, and
            # that click now fires on RELEASE, because on the press edge nobody can yet
            # know which of the two it was.  The middle button pans straight away.
            - set: [<.right_tap, 0]
            - decl: [right_now, i32, { call: [input.mouse_button, 1] }]
            - if:
                condition: { "&&": [{ call: [input.mouse_pressed, 1] }, { eq: [over_canvas, 1] }] }
                then:
                  - set: [<.pan_armed, 1]
                  - set: [<.pan_hold_x, mouse_x]
                  - set: [<.pan_hold_y, mouse_y]
                  - set: [<.pan_from_x, { -: [mouse_x, <.pan_x] }]
                  - set: [<.pan_from_y, { -: [mouse_y, <.pan_y] }]
                  - set: [<.focus_hold_x, <.focus_x]
                  - set: [<.focus_hold_y, <.focus_y]
            - if:
                condition: { "&&": [{ eq: [<.pan_armed, 1] }, { eq: [right_now, 1] }] }
                then:
                  - decl: [went_x, f32, { call: [math.abs, { -: [mouse_x, <.pan_hold_x] }] }]
                  - decl: [went_y, f32, { call: [math.abs, { -: [mouse_y, <.pan_hold_y] }] }]
                  - if:
                      condition: { "||": [{ gt: [went_x, 6.0] }, { gt: [went_y, 6.0] }] }
                      then: [{ set: [<.panning, 1] }]
            - if:
                condition: { call: [input.mouse_released, 1] }
                then:
                  - if:
                      condition: { "&&": [{ eq: [<.pan_armed, 1] }, { eq: [<.panning, 0] }] }
                      then: [{ set: [<.right_tap, 1] }]
                  - set: [<.pan_armed, 0]
                  - set: [<.panning, 0]
            # the middle button, for mice that have one: no threshold, it means nothing else
            - decl: [mid_now, i32, { call: [input.mouse_button, 2] }]
            - if:
                condition: { "&&": [{ eq: [mid_now, 1] }, { "&&": [{ eq: [<.panning, 0] }, { eq: [over_canvas, 1] }] }] }
                then:
                  - set: [<.panning, 1]
                  - set: [<.pan_from_x, { -: [mouse_x, <.pan_x] }]
                  - set: [<.pan_from_y, { -: [mouse_y, <.pan_y] }]
                  - set: [<.pan_hold_x, mouse_x]
                  - set: [<.pan_hold_y, mouse_y]
                  - set: [<.focus_hold_x, <.focus_x]
                  - set: [<.focus_hold_y, <.focus_y]
            - if:
                condition: { "&&": [{ eq: [mid_now, 0] }, { eq: [right_now, 0] }] }
                then: [{ set: [<.panning, 0] }]
            - if:
                condition: { eq: [<.panning, 1] }
                then:
                  # the plane moves its FOCUS, in plane units; a page moves by pixels
                  - if:
                      condition: { eq: [<.deck.mode, ViewMode.plane] }
                      then:
                        - decl: [grip_scale, f32, <.last_scale]
                        - if: { condition: { le: [grip_scale, 0.0] }, then: [{ set: [grip_scale, 1.0] }] }
                        - set: [<.focus_x, { -: [<.focus_hold_x, { /: [{ -: [mouse_x, <.pan_hold_x] }, grip_scale] }] }]
                        - set: [<.focus_y, { -: [<.focus_hold_y, { /: [{ -: [mouse_y, <.pan_hold_y] }, grip_scale] }] }]
                        - if: { condition: { le: [<.view_zoom, 0.0] }, then: [{ call: [<.set_zoom, grip_scale] }] }
                      else:
                        - set: [<.pan_x, { -: [mouse_x, <.pan_from_x] }]
                        - set: [<.pan_y, { -: [mouse_y, <.pan_from_y] }]
                  - call: [input.set_cursor, "hand"]
                  - return: 1
            - return: 0

      - def:
          name: canvas_input
          static_off: ["same_arg", "str_cmp"]
          args: [[cvs_x, f32], [cvs_y, f32], [cvs_w, f32], [cvs_h, f32]]
          body:
            - if: { condition: { eq: [<.deck.slides.len, 0] }, then: [{ return: null }] }
            - decl: [mouse_x, f32, { call: [input.mouse_pos_x] }]
            - decl: [mouse_y, f32, { call: [input.mouse_pos_y] }]
            # the SAME rect the picture was drawn with (spec §8.4), which in plane mode
            # is the current FRAME's place on the plane (spec §20.3)
            - decl: [on_frame, i32, { call: [<.pick_frame, cvs_x, cvs_y, cvs_w, cvs_h] }]
            - decl: [view, Shape]
            - call: [<.view_for, cvs_x, cvs_y, cvs_w, cvs_h, view]
            - decl: [scale, f32, { /: [view.width, 1280.0] }]
            - decl: [org_x, f32, view.pos_x]
            - decl: [org_y, f32, view.pos_y]
            - decl: [slide_x, f32, { /: [{ -: [mouse_x, org_x] }, scale] }]
            - decl: [slide_y, f32, { /: [{ -: [mouse_y, org_y] }, scale] }]
            - decl: [slide, ref<Sheet>, { at: [<.deck.slides, <.deck.current] }]
            # §8.0: chrome owns its area.  The canvas cell now spans the whole
            # window, so the canvas has to reject the strips' rows itself --
            # otherwise a press on a button also starts a stroke.
            - decl: [over_canvas, i32, 1]
            - if: { condition: { lt: [mouse_x, cvs_x] }, then: [{ set: [over_canvas, 0] }] }
            - if: { condition: { ge: [mouse_x, { +: [cvs_x, cvs_w] }] }, then: [{ set: [over_canvas, 0] }] }
            - if: { condition: { lt: [mouse_y, cvs_y] }, then: [{ set: [over_canvas, 0] }] }
            - if: { condition: { ge: [mouse_y, { +: [cvs_y, cvs_h] }] }, then: [{ set: [over_canvas, 0] }] }
            # on the bare plane there is nothing to draw ON (spec §20.1)
            - if: { condition: { eq: [on_frame, 0] }, then: [{ set: [over_canvas, 0] }] }
            - if: { condition: { eq: [{ call: [<.pan_drag, mouse_x, mouse_y, over_canvas] }, 1] }, then: [{ return: null }] }
            # ── the pointer says what a drag from here would do (spec §15.1a) ─
            - if:
                condition: { "||": [{ eq: [over_canvas, 0] }, { eq: [<.presenting, 1] }] }
                then: [{ call: [input.set_cursor, "arrow"] }]
                else: [{ call: [<.grip.point, slide, <.sel, slide_x, slide_y, scale] }]
            # DIAGNOSE: beide Flanken getrennt -- ui.button feuert auf RELEASED,
            # meine bisherige Diagnose hing an PRESSED.
            - if: { condition: { eq: [{ call: [<.overlay_claim, mouse_x, mouse_y] }, 1] }, then: [{ return: null }] }
            - decl: [down_now, i32, { call: [input.mouse_pressed, 0] }]
            - decl: [up_now, i32, { call: [input.mouse_released, 0] }]
            - decl: [held, i32, { call: [input.mouse_button, 0] }]
            - if:
                condition: { "||": [{ neq: [down_now, 0] }, { neq: [up_now, 0] }] }
                then:
                  # the mouse state belongs in --diag, not in the status strip:
                  # that strip reports to the author now (§8.0), and "P1 R0 H1"
                  # tells an author nothing
                  - decl: [hit_dbg, string, { call: [<.grip.node_at, slide, slide_x, slide_y] }]
                  - decl: [mass_dbg, i32, { cast: [{ "*": [scale, 1000.0] }, i32] }]
                  # Diag.say checks the flag itself.  A `return` here skipped the whole
                  # press handling whenever --diag was off: the canvas ignored every
                  # click, and every live test had happened to run WITH --diag.
                  - call: [<.diag.say, "P${down_now} R${up_now} H${held} fenster=${ { cast: [mouse_x, i32] } },${ { cast: [mouse_y, i32] } } folie=${ { cast: [slide_x, i32] } },${ { cast: [slide_y, i32] } } flaeche=${over_canvas} aktion=${<.last_action} werkzeug=${<.armed} treffer='${hit_dbg}' ursprung=${ { cast: [org_x, i32] } },${ { cast: [org_y, i32] } } mass=${mass_dbg} rahmen=${<.deck.current}"]

            # ── press ────────────────────────────────────────────────────────
            - if:
                condition: { "&&": [{ call: [input.mouse_pressed, 0] }, { eq: [over_canvas, 1] }] }
                then:
                  # A press INSIDE the label being edited places the caret (§6); a
                  # press anywhere else commits first, so the next stroke cannot
                  # silently discard what was just typed.
                  - if:
                      condition: { eq: [<.editing, 1] }
                      then:
                        - decl: [live_box, Shape]
                        - decl: [on_live, i32, { call: [<.live_box, slide, org_x, org_y, scale, live_box] }]
                        - if:
                            condition: { eq: [on_live, 1] }
                            then:
                              - if:
                                  condition: { eq: [{ call: [<.label.click_in, live_box, mouse_x, mouse_y] }, 1] }
                                  then: [{ return: null }]
                        - call: [<.commit_label]
                  # the blue halo resizes (spec §15.1a).  Only with no explicit tool
                  # or the freehand default: an armed stencil still places.
                  - if:
                      condition: { "||": [{ eq: [<.armed, -1] }, { eq: [<.armed, 101] }] }
                      then:
                        - if:
                            condition: { eq: [{ call: [<.grip.start, slide, <.sel, slide_x, slide_y] }, 1] }
                            then:
                              - set: [<.status, "Groesse ziehen"]
                              - return: null
                  # freehand (spec §7): press starts the stroke
                  - if:
                      condition: { eq: [<.armed, 101] }
                      then:
                        - call: [<.ink.begin_stroke, slide_x, slide_y]
                        - return: null
                  # edge tool: press starts the link, release finishes it
                  - if:
                      condition: { eq: [<.armed, 100] }
                      then:
                        - decl: [src, string, { call: [<.grab_at, slide, slide_x, slide_y] }]
                        - if:
                            condition: { neq: [src, ""] }
                            then: [{ set: [<.link_from, src] }, { set: [<.status, "auf das Ziel loslassen"] }]
                            else: [{ set: [<.status, "Kante beginnt auf einem Knoten"] }]
                        - return: null
                  # stencil: place, then straight into the label (spec §15.1)
                  - if:
                      condition: { ge: [<.armed, 0] }
                      then:
                        - decl: [fresh, Node]
                        - set: [fresh.ident, "n${slide.next_id}"]
                        - set: [fresh.kind, <.armed]
                        - set: [fresh.pos_x, { call: [<.snap_val, { -: [slide_x, 100.0] }] }]
                        - set: [fresh.pos_y, { call: [<.snap_val, { -: [slide_y, 45.0] }] }]
                        - set: [fresh.width, 200.0]
                        - set: [fresh.height, 90.0]
                        - call: [slide.nodes.push, fresh]
                        - call: [<.touch]
                        - set: [slide.next_id, { +: [slide.next_id, 1] }]
                        - set: [<.armed, -1]
                        - call: [<.begin_edit, fresh.ident]
                        - return: null
                  - decl: [hit, string, { call: [<.grip.node_at, slide, slide_x, slide_y] }]
                  - if:
                      condition: { eq: [hit, ""] }
                      then:
                        # the heading is part of the page, not a node (§6)
                        - decl: [head_box2, Shape]
                        - call: [<.label.title_box, org_x, org_y, scale, head_box2]
                        - if:
                            condition: { "&&": [{ ge: [mouse_x, head_box2.pos_x] }, { le: [mouse_x, { +: [head_box2.pos_x, head_box2.width] }] }] }
                            then:
                              - if:
                                  condition: { "&&": [{ ge: [mouse_y, head_box2.pos_y] }, { le: [mouse_y, { +: [head_box2.pos_y, head_box2.height] }] }] }
                                  then:
                                    - call: [<.edit_title]
                                    - decl: [head_box3, Shape]
                                    - call: [<.label.title_box, org_x, org_y, scale, head_box3]
                                    - call: [<.label.place, head_box3, mouse_x, mouse_y, 0]
                                    - return: null
                        # An edge under the cursor is selected; otherwise a drag on
                        # empty canvas IS the stroke. Drawing is what the surface is
                        # for, so it costs no mode: a stroke too short to recognise
                        # does nothing, which is what a stray click should do anyway.
                        # In a sequence the thing under the cursor is a STEP: there
                        # are no edges, and a message is what a click on a line means
                        # (spec §5.8.3).
                        - if:
                            condition: { eq: [slide.dtype, DiagramType.sequence] }
                            then:
                              - decl: [near_step, i32, { call: [<.seq.step_at, slide, slide_x, slide_y] }]
                              - set: [<.sel, ""]
                              - set: [<.sel_edge, ""]
                              - set: [<.sel_step, ""]
                              - if:
                                  condition: { ge: [near_step, 0] }
                                  then:
                                    - decl: [picked, ref<Step>, { at: [slide.steps, near_step] }]
                                    - set: [<.sel_step, picked.ident]
                                    - set: [<.status, "Schritt gewaehlt"]
                                    - call: [<.drop_ink]
                                    - return: null
                              - call: [<.ink.begin_stroke, slide_x, slide_y]
                              - return: null
                        - decl: [near_edge, string, { call: [<.grip.edge_at, slide, slide_x, slide_y, 12.0] }]
                        - if:
                            condition: { neq: [near_edge, ""] }
                            then:
                              - set: [<.sel, ""]
                              - set: [<.sel_edge, near_edge]
                              - call: [<.drop_ink]
                              - return: null
                        - set: [<.sel, ""]
                        - set: [<.sel_edge, ""]
                        - call: [<.ink.begin_stroke, slide_x, slide_y]
                        - return: null
                  - if:
                      condition: { neq: [hit, ""] }
                      then:
                        # Drag the RIM to connect, the middle to move. Starting on a
                        # node had no way to mean "draw a line" -- the gesture was
                        # taken, so a connector could never begin on its source.
                        - decl: [rim, i32, 0]
                        - decl: [ridx, i32, 0]
                        - while:
                            condition: { lt: [ridx, slide.nodes.len] }
                            body:
                              - decl: [rnode, ref<Node>, { at: [slide.nodes, ridx] }]
                              - if:
                                  condition: { eq: [rnode.ident, hit] }
                                  then:
                                    - decl: [to_left, f32, { call: [math.abs, { -: [slide_x, rnode.pos_x] }] }]
                                    - decl: [to_right, f32, { call: [math.abs, { -: [slide_x, { +: [rnode.pos_x, rnode.width] }] }] }]
                                    - decl: [to_top, f32, { call: [math.abs, { -: [slide_y, rnode.pos_y] }] }]
                                    - decl: [to_bottom, f32, { call: [math.abs, { -: [slide_y, { +: [rnode.pos_y, rnode.height] }] }] }]
                                    - decl: [nearest, f32, { call: [math.min, { call: [math.min, to_left, to_right] }, { call: [math.min, to_top, to_bottom] }] }]
                                    - if: { condition: { lt: [nearest, 14.0] }, then: [{ set: [rim, 1] }] }
                                    - set: [ridx, slide.nodes.len]
                              - set: [ridx, { +: [ridx, 1] }]
                        - if:
                            condition: { eq: [rim, 1] }
                            then:
                              - set: [<.sel, ""]
                              - set: [<.sel_edge, ""]
                              - call: [<.ink.begin_stroke, slide_x, slide_y]
                              - set: [<.status, "Rand gezogen -- auf ein Ziel loslassen"]
                              - return: null
                        # typing starts by clicking the LETTERS of the already
                        # selected node (§15.1a): a click anywhere inside it used to
                        # open the label, so moving a node by its middle put the
                        # caret in instead
                        - if:
                            condition: { eq: [hit, <.sel] }
                            then:
                              - if:
                                  condition: { eq: [{ call: [<.grip.on_text, slide, hit, slide_x, slide_y, scale] }, 1] }
                                  then: [{ call: [<.begin_edit, hit] }]
                        - set: [<.sel, hit]
                        - call: [<.drop_ink]
                        - set: [<.sel_edge, ""]
                        - set: [<.drag_id, hit]
                        - decl: [grab, ref<Node>]
                        - decl: [pos2, i32, 0]
                        - while:
                            condition: { lt: [pos2, slide.nodes.len] }
                            body:
                              - decl: [node2, ref<Node>, { at: [slide.nodes, pos2] }]
                              - if:
                                  condition: { eq: [node2.ident, hit] }
                                  then:
                                    - set: [<.drag_dx, { -: [slide_x, node2.pos_x] }]
                                    - set: [<.drag_dy, { -: [slide_y, node2.pos_y] }]
                                    - set: [pos2, slide.nodes.len]
                              - set: [pos2, { +: [pos2, 1] }]
                  - return: null

            # §8.2: with no ink waiting, the right button opens the menu on whatever
            # is under the cursor.  With ink waiting, §7.5a has the first claim --
            # that button was given to the author to read the ink.
            - if:
                condition: { "&&": [{ eq: [<.right_tap, 1] }, { "&&": [{ eq: [<.ink.count, 0] }, { eq: [over_canvas, 1] }] }] }
                then:
                  - decl: [on_node, string, { call: [<.grip.node_at, slide, slide_x, slide_y] }]
                  - if:
                      condition: { neq: [on_node, ""] }
                      then:
                        - set: [<.sel, on_node]
                        - call: [<.drop_ink]
                        - set: [<.sel_edge, ""]
                        - call: [<.menu.open_at, 1, on_node, mouse_x, mouse_y]
                        - return: null
                  - decl: [on_edge, string, { call: [<.grip.edge_at, slide, slide_x, slide_y, 14.0] }]
                  - if:
                      condition: { neq: [on_edge, ""] }
                      then:
                        - set: [<.sel, ""]
                        - set: [<.sel_edge, on_edge]
                        - call: [<.drop_ink]
                        - call: [<.menu.open_at, 2, on_edge, mouse_x, mouse_y]
                        - return: null

            # ── the ink is read on the right button, or after one second ──────
            - if:
                condition: { "&&": [{ gt: [<.ink.count, 0] }, { eq: [<.ink.inking, 0] }] }
                then:
                  - decl: [now, f64, { call: [engine.time] }]
                  - decl: [idle, f64, { -: [now, <.ink.last] }]
                  # Re-reading unchanged ink would repeat the same verdict every
                  # settle period -- and did, three times over in the log.
                  - decl: [fresh_ink, i32, 0]
                  - if: { condition: { neq: [<.ink.count, <.read_at] }, then: [{ set: [fresh_ink, 1] }] }
                  - if:
                      condition: { "||": [{ eq: [<.right_tap, 1] }, { "&&": [{ eq: [fresh_ink, 1] }, { gt: [idle, <.settle] }] }] }
                      then:
                        - set: [<.read_at, <.ink.count]
                        - decl: [made, i32, { call: [<.reader.read_ink, slide] }]
                        - set: [<.status, <.reader.status]
                        - if:
                            condition: { neq: [<.reader.made_id, ""] }
                            then:
                              - call: [<.begin_edit, <.reader.made_id]
                              - set: [<.reader.made_id, ""]
                        # a note drawn on a lifeline is a STEP, and its label is
                        # edited the way the menu does it (spec §7.7)
                        - if:
                            condition: { neq: [<.reader.made_step, ""] }
                            then:
                              - set: [<.sel_step, <.reader.made_step]
                              - set: [<.sel, ""]
                              - set: [<.reader.made_step, ""]
                              - call: [<.edit_step]
                        # A group that produced nothing is KEPT: drawing a head first
                        # and then taking a moment over the line must not cost the
                        # head. The right button is the explicit discard.
                        - if:
                            condition: { "||": [{ gt: [made, 0] }, { eq: [<.right_tap, 1] }] }
                            then: [{ call: [<.ink.clear] }, { set: [<.read_at, 0] }]
                            else: [{ set: [<.ink.last, { call: [engine.time] }] }]
                        - return: null

            # ── freehand: collect while held (spec §7.5a) ─────────────────────
            - if:
                condition: { eq: [<.ink.inking, 1] }
                then:
                  - if:
                      condition: { call: [input.mouse_released, 0] }
                      then:
                        - call: [<.ink.add_point, slide_x, slide_y]
                        - set: [<.ink.inking, 0]
                        - set: [<.armed, -1]
                        - set: [<.ink.last, { call: [engine.time] }]
                        - set: [<.status, "Tinte steht -- rechte Taste oder 1 s Pause liest sie"]
                        - return: null
                  - call: [<.ink.add_point, slide_x, slide_y]
                  - return: null

            # ── release: finish a link ───────────────────────────────────────
            - if:
                condition: { call: [input.mouse_released, 0] }
                then:
                  - if:
                      condition: { neq: [<.link_from, ""] }
                      then:
                        - decl: [dst, string, { call: [<.grab_at, slide, slide_x, slide_y] }]
                        - if:
                            condition: { "&&": [{ neq: [dst, ""] }, { neq: [dst, <.link_from] }] }
                            then: [{ call: [<.join_two, slide, <.link_from, dst] }]
                            else:
                              # released on nothing: a dangling edge has no Mermaid form
                              - set: [<.status, "auf keinem Knoten losgelassen -- nichts angelegt"]
                        - set: [<.link_from, ""]
                        - set: [<.armed, -1]
                  - set: [<.drag_id, ""]
                  - return: null

            # ── resize by the halo (spec §15.1a) ─────────────────────────────
            - if:
                condition: { eq: [{ call: [<.grip.active] }, 1] }
                then:
                  - if:
                      condition: { eq: [{ call: [input.mouse_button, 0] }, 0] }
                      then: [{ call: [<.grip.stop] }, { return: null }]
                  - call: [<.grip.drag, slide, slide_x, slide_y]
                  - call: [<.touch]
                  - return: null

            # ── drag a node ──────────────────────────────────────────────────
            - if:
                condition: { eq: [{ call: [input.mouse_button, 0] }, 0] }
                then: [{ set: [<.drag_id, ""] }, { return: null }]
            - if:
                condition: { neq: [<.drag_id, ""] }
                then:
                  - decl: [pos, i32, 0]
                  - while:
                      condition: { lt: [pos, slide.nodes.len] }
                      body:
                        - decl: [node, ref<Node>, { at: [slide.nodes, pos] }]
                        - if:
                            condition: { eq: [node.ident, <.drag_id] }
                            then:
                              - call: [<.touch]
                              - set: [node.pos_x, { call: [<.snap_val, { -: [slide_x, <.drag_dx] }] }]
                              - set: [node.pos_y, { call: [<.snap_val, { -: [slide_y, <.drag_dy] }] }]
                              - set: [pos, slide.nodes.len]
                        - set: [pos, { +: [pos, 1] }]
      # ── keyboard: ONE consumer (spec §6, normative) ────────────────────────
      # Everything comes from the event queue. A key read both as an event and as a
      # poll fires twice, and the symptom is a Backspace that eats two characters.
      - def:
          name: handle_events
          static_off: ["same_arg", "str_cmp"]
          body:
            - while:
                condition: { call: [input.has_event] }
                body:
                  - decl: [evt, input_event, { call: [input.next_event] }]
                  - if:
                      condition: { eq: [<.editing, 1] }
                      then:
                        # Ctrl+C sends no character on most platforms, but a shortcut
                        # that DID would otherwise type a "c" into the label
                        - decl: [holding, i32, 0]
                        - if: { condition: { call: [input.key_down, "LCtrl"] }, then: [{ set: [holding, 1] }] }
                        - if: { condition: { call: [input.key_down, "RCtrl"] }, then: [{ set: [holding, 1] }] }
                        - if:
                            condition: { "&&": [{ eq: [evt.type, "text"] }, { eq: [holding, 0] }] }
                            then: [{ call: [<.label.insert, evt.char_] }]
                        # A held key repeats while typing (aiml spec/44_0: `key_repeat`
                        # is its own event, so the one-press-one-event rule stays
                        # exact).  Slide navigation deliberately does NOT repeat --
                        # holding Right would race through the deck.
                        - decl: [is_key, i32, 0]
                        - if: { condition: { eq: [evt.type, "key_down"] }, then: [{ set: [is_key, 1] }] }
                        - if: { condition: { eq: [evt.type, "key_repeat"] }, then: [{ set: [is_key, 1] }] }
                        - if:
                            condition: { eq: [is_key, 1] }
                            then:
                              - decl: [verdict, i32, { call: [<.label.key, evt.key] }]
                              - if: { condition: { eq: [verdict, 2] }, then: [{ call: [<.commit_label] }] }
                              - if:
                                  condition: { eq: [verdict, 3] }
                                  then:
                                    - set: [<.editing, 0]
                                    - set: [<.edit_id, ""]
                                    - call: [<.label.stop]
                                    - set: [<.status, "verworfen"]
                      else:
                        - if:
                            condition: { eq: [evt.type, "key_down"] }
                            then: [{ call: [<.nav_key, evt.key] }]
      - def:
          name: nav_key
          static_off: ["same_arg", "str_cmp"]
          args: [[key, string]]
          body:
            - if: { condition: { eq: [key, "F5"] }, then: [{ set: [<.presenting, 1] }, { set: [<.sel, ""] }, { return: null }] }
            - if:
                condition: { eq: [key, "Escape"] }
                then:
                  - if: { condition: { eq: [<.menu.shown, 1] }, then: [{ call: [<.menu.close] }, { return: null }] }
                  - set: [<.presenting, 0]
                  - return: null
            - decl: [forward, i32, 0]
            - if: { condition: { eq: [key, "Right"] }, then: [{ set: [forward, 1] }] }
            - if: { condition: { eq: [key, "Space"] }, then: [{ set: [forward, 1] }] }
            - if: { condition: { eq: [key, "PageDown"] }, then: [{ set: [forward, 1] }] }
            - if:
                condition: { eq: [forward, 1] }
                then:
                  - if:
                      condition: { lt: [<.deck.current, { -: [<.deck.slides.len, 1] }] }
                      then: [{ set: [<.deck.current, { +: [<.deck.current, 1] }] }, { call: [<.clear_selection] }]
                  - return: null
            - decl: [back, i32, 0]
            - if: { condition: { eq: [key, "Left"] }, then: [{ set: [back, 1] }] }
            - if: { condition: { eq: [key, "PageUp"] }, then: [{ set: [back, 1] }] }
            - if:
                condition: { eq: [back, 1] }
                then:
                  - if:
                      condition: { gt: [<.deck.current, 0] }
                      then: [{ set: [<.deck.current, { -: [<.deck.current, 1] }] }, { call: [<.clear_selection] }]
                  - return: null
            - if: { condition: { eq: [key, "Home"] }, then: [{ set: [<.deck.current, 0] }, { call: [<.clear_selection] }, { return: null }] }
            - if: { condition: { eq: [key, "End"] }, then: [{ set: [<.deck.current, { -: [<.deck.slides.len, 1] }] }, { call: [<.clear_selection] }, { return: null }] }
            - if: { condition: { eq: [key, "N"] }, then: [{ set: [<.show_notes, { -: [1, <.show_notes] }] }, { return: null }] }
            - if: { condition: { eq: [key, "Delete"] }, then: [{ call: [<.dispatch, 20] }, { return: null }] }
            - decl: [holding, i32, 0]
            - if: { condition: { call: [input.key_down, "LCtrl"] }, then: [{ set: [holding, 1] }] }
            - if: { condition: { call: [input.key_down, "RCtrl"] }, then: [{ set: [holding, 1] }] }
            - call: [<.diag.say, "TASTE ${key} strg=${holding} auswahl='${<.sel}'"]
            - if:
                condition: { "&&": [{ eq: [holding, 1] }, { eq: [<.deck.slides.len, 0] }] }
                then: [{ return: null }]
            - if:
                condition: { eq: [holding, 1] }
                then:
                  - decl: [key_deed, i32, 0]
                  - if: { condition: { eq: [key, "C"] }, then: [{ set: [key_deed, 1] }] }
                  - if: { condition: { eq: [key, "X"] }, then: [{ set: [key_deed, 2] }] }
                  - if: { condition: { eq: [key, "V"] }, then: [{ set: [key_deed, 3] }] }
                  - if: { condition: { eq: [key, "Z"] }, then: [{ call: [<.dispatch, 15] }, { return: null }] }
                  - if: { condition: { eq: [key, "Y"] }, then: [{ call: [<.dispatch, 16] }, { return: null }] }
                  # Ansicht (spec §8.4): digits, because aiml has no name for +/-
                  - if: { condition: { eq: [key, "0"] }, then: [{ call: [<.dispatch, 130] }, { return: null }] }
                  - if: { condition: { eq: [key, "5"] }, then: [{ call: [<.dispatch, 131] }, { return: null }] }
                  - if: { condition: { eq: [key, "1"] }, then: [{ call: [<.dispatch, 132] }, { return: null }] }
                  - if: { condition: { eq: [key, "2"] }, then: [{ call: [<.dispatch, 133] }, { return: null }] }
                  - if:
                      condition: { gt: [key_deed, 0] }
                      then: [{ call: [<.clip_deed, key_deed] }, { return: null }]
            - if: { condition: { eq: [key, "S"] }, then: [{ call: [<.save_deck, ""] }, { return: null }] }
            - if: { condition: { eq: [key, "O"] }, then: [{ call: [<.dispatch, 60] }, { return: null }] }
            # Enter opens the selected node for editing (spec §6)
            - if:
                condition: { eq: [key, "Enter"] }
                then:
                  - if: { condition: { neq: [<.sel, ""] }, then: [{ call: [<.begin_edit, <.sel] }] }
      # ── images ──────────────────────────────────────────────────────────────
      # Loaded once per distinct path when the deck is opened: a texture per frame
      # would re-upload every picture 60 times a second.
      # ── the loop ────────────────────────────────────────────────────────────
      - def:
          name: run
          static_off: ["same_arg", "str_cmp"]
          args: [[path, string], [frame_limit, i32], [shot_path, string], [opts, ref<ChartOptions>]]
          return: i32
          body:
            - set: [<.deck_path, path]
            - set: [<.armed, -1]
            - set: [<.sel, ""]
            - set: [<.drag_id, ""]
            - set: [<.presenting, 0]
            - set: [<.show_notes, 0]
            - set: [<.status, "bereit"]
            - if:
                condition: { eq: [{ call: [<.sheet_io.load, path, <.deck] }, 0] }
                then: [{ return: 1 }]
            - call: [<.ink.setup]
            - call: [<.past.start, <.deck]
            - set: [<.diag.wanted, opts.diag]
            - if:
                condition: { neq: [opts.script, ""] }
                then:
                  - if:
                      condition: { eq: [{ call: [<.script.load, opts.script] }, 0] }
                      then: [{ return: 1 }]
            - set: [<.settle, { /: [{ cast: [opts.settle, f64] }, 1000.0] }]
            - set: [<.presenting, opts.present]
            - set: [<.show_notes, opts.notes]
            - set: [<.deck.current, { -: [opts.start, 1] }]
            - if: { condition: { lt: [<.deck.current, 0] }, then: [{ set: [<.deck.current, 0] }] }
            - if: { condition: { ge: [<.deck.current, <.deck.slides.len] }, then: [{ set: [<.deck.current, { -: [<.deck.slides.len, 1] }] }] }
            - decl: [win, window_handle, { call: [engine.create_window, 1400, 880, "chart"] }]
            - if:
                condition: { eq: [win, null] }
                then:
                  - call: [log.error, "chart: cannot open a window"]
                  - return: 1
            - call: [gl.init]
            - call: [ui.init]
            # Registers the GLFW callbacks. Without it every input call is a no-op
            # (aiml spec/44_0 §2): the window draws and nothing reacts.
            - call: [input.init, win]
            - decl: [font, ui_font, { call: [ui.load_font_default, 15.0] }]
            - if:
                condition: { peq: [font, null] }
                then:
                  - call: [log.error, "chart: no font"]
                  - return: 1
            - call: [ui.set_default_font, font]
            - call: [<.art.load_images, <.deck]

            - decl: [cols_show, buffer<f32>, [1.0]]
            - decl: [rows, buffer<f32>, [1.0]]

            - decl: [frame, i32, 0]
            - while:
                condition: { call: [engine.running, win] }
                body:
                  - set: [frame, { +: [frame, 1] }]
                  - call: [gl.clear_all, 0.09, 0.11, 0.14, 1.0]
                  - decl: [isize, ivec2, { call: [engine.window_size, win] }]
                  - decl: [fsize, vec2, { call: [math.ivec2_to_vec2, isize] }]
                  - decl: [win_w, f32, fsize.x]
                  - decl: [win_h, f32, fsize.y]
                  - call: [ui.begin, win]
                  - call: [ui.set_gap, 0.0, 0.0]
                  # One scripted step per frame (spec §9.1), BEFORE the events are
                  # drained: aiml_input_update clears the queue at the start of each
                  # frame, so a key posted after handle_events is wiped before anyone
                  # reads it -- the clicks worked (they are latches), the keys did not.
                  - if:
                      condition: { eq: [<.script.running, 1] }
                      then:
                        # the same rect the canvas gets: the strips took the top of
                        # the window (§8.0), and a step must land where the slide is
                        - decl: [sc_top, f32, { +: [{ call: [<.top_bar.height] }, { call: [<.tools.height] }] }]
                        - decl: [sc_cvs_h, f32, { -: [{ -: [win_h, sc_top] }, { call: [<.strip_bottom] }] }]
                        - decl: [sc_view, Shape]
                        - call: [<.view_for, 0.0, sc_top, win_w, sc_cvs_h, sc_view]
                        - decl: [sc_scale, f32, { /: [sc_view.width, 1280.0] }]
                        - decl: [sc_org_x, f32, sc_view.pos_x]
                        - decl: [sc_org_y, f32, sc_view.pos_y]
                        - decl: [verdict, i32, { call: [<.script.tick, sc_org_x, sc_org_y, sc_scale] }]
                        - if: { condition: { eq: [verdict, 2] }, then: [{ call: [<.save_deck, ""] }] }
                        # verdict 3 = shot: taken at the end of the frame, below
                        - if:
                            condition: { eq: [verdict, 4] }
                            then:
                              - call: [ui.end]
                              - call: [engine.swap, win]
                              - return: 0
                  - call: [<.handle_events]
                  - decl: [live_now, string, ""]
                  - if: { condition: { eq: [<.editing, 1] }, then: [{ set: [live_now, <.edit_id] }] }
                  - set: [<.art.live_id, live_now]
                  - if:
                      condition: { eq: [<.presenting, 1] }
                      then:
                        - call: [ui.begin_grid, cols_show, rows]
                        - call: [ui.begin_cell, 0, 0, 1, 1]
                        - call: [<.draw_slide, 0.0, 0.0, win_w, win_h]
                        - call: [ui.end_cell]
                        - call: [ui.end_grid]
                      else:
                        # what the menu strip offers depends on the deck (§8.0)
                        - call: [<.feed_bar]
                        - decl: [action, i32, 0]
                        - call: [ui.begin_grid, cols_show, rows]
                        - call: [ui.begin_cell, 0, 0, 1, 1]
                        - decl: [strip_h, f32, { +: [{ call: [<.top_bar.height] }, { call: [<.tools.height] }] }]
                        - decl: [cvs_h, f32, { -: [{ -: [win_h, strip_h] }, { call: [<.strip_bottom] }] }]
                        - if:
                            condition: { eq: [<.deck.mode, ViewMode.plane] }
                            then: [{ call: [<.draw_plane, 0.0, strip_h, win_w, cvs_h] }]
                            else: [{ call: [<.draw_slide, 0.0, strip_h, win_w, cvs_h] }]
                        - call: [<.menu.draw]
                        - call: [<.canvas_input, 0.0, strip_h, win_w, cvs_h]
                        - call: [ui.end_cell]
                        - call: [ui.end_grid]
                        - call: [<.status_strip, win_w, win_h]
                        # The strips draw OUTSIDE the grid, over the full width: a
                        # widget in a cell cannot leave its cell, and a dropdown has to
                        # fall over the canvas (§8.0).
                        - decl: [bar_x, f32, { call: [input.mouse_pos_x] }]
                        - decl: [bar_y, f32, { call: [input.mouse_pos_y] }]
                        - decl: [menu_h, f32, { call: [<.top_bar.height] }]
                        - call: [<.top_bar.draw, win_w, bar_x, bar_y]
                        - decl: [dtype_now, i32, 0]
                        - if:
                            condition: { gt: [<.deck.slides.len, 0] }
                            then:
                              - decl: [slide_t, ref<Sheet>, { at: [<.deck.slides, <.deck.current] }]
                              - set: [dtype_now, slide_t.dtype]
                        - call: [<.tools.draw, win_w, menu_h, dtype_now, bar_x, bar_y]
                        - call: [<.top_bar.draw_open, bar_x, bar_y]
                        - if:
                            condition: { call: [input.mouse_pressed, 0] }
                            then:
                              - decl: [took, i32, { call: [<.top_bar.press, bar_x, bar_y] }]
                              - if:
                                  condition: { eq: [took, 1] }
                                  then: [{ set: [action, <.top_bar.deed] }]
                                  else:
                                    - decl: [took2, i32, { call: [<.tools.press, bar_x, bar_y, menu_h] }]
                                    - if: { condition: { eq: [took2, 1] }, then: [{ set: [action, <.tools.deed] }] }
                        - set: [<.last_action, action]
                        - if: { condition: { neq: [action, 0] }, then: [{ call: [<.diag.say, "LEISTE aktion=${action}"] }] }
                        - call: [<.dispatch, action]
                        # a step for the undo stack, once the gesture is over and the
                        # label editor is closed (spec §16.4)
                        - if:
                            condition: { eq: [<.changed, 1] }
                            then:
                              - decl: [busy, i32, { call: [input.mouse_button, 0] }]
                              - if:
                                  condition: { "&&": [{ eq: [busy, 0] }, { eq: [<.editing, 0] }] }
                                  then:
                                    - call: [<.past.note, <.deck]
                                    - set: [<.changed, 0]
                  - call: [ui.end]
                  - if:
                      condition: { eq: [<.script.shot_due, 1] }
                      then:
                        - call: [<.exporter.capture, <.script.arg, isize.x, isize.y]
                        - set: [<.script.shot_due, 0]
                  # The capture happens BEFORE the swap: after it the back buffer is
                  # undefined, and a screenshot of an undefined buffer is noise that
                  # looks like a rendering bug.
                  - if:
                      condition: { gt: [frame_limit, 0] }
                      then:
                        - if:
                            condition: { ge: [frame, frame_limit] }
                            then:
                              - if:
                                  condition: { neq: [shot_path, ""] }
                                  then: [{ call: [<.exporter.capture, shot_path, isize.x, isize.y] }]
                              - call: [engine.swap, win]
                              - return: 0
                  - call: [engine.swap, win]
            - return: 0

- classgroup:
    name: ChartRuntime
    instances:
      - class: SheetIO
        instance: sheet_io
      - class: SeqLayout
        instance: seq
      - class: SeqArt
        instance: seq_art
        sees: [seq, pen]
      - class: EdgeArt
        instance: edge_art
        sees: [pen, grip]
      - class: Deeds
        instance: deeds
      - class: History
        instance: past
        sees: [sheet_io]
      - class: MermaidOut
        instance: mermaid
        sees: [seq]
      - class: MarkdownOut
        instance: markdown
      - class: SvgOut
        instance: svg
        sees: [pen, seq]
      - class: ZipOut
        instance: zip
      - class: PptxOut
        instance: pptx
        sees: [pen, svg, zip]
      - class: MermaidIn
        instance: mermaid_in
      - class: MarkdownIn
        instance: markdown_in
        sees: [mermaid_in]
      - class: Exporter
        instance: exporter
        sees: [sheet_io, mermaid, markdown, svg, pptx, mermaid_in, markdown_in]
      - class: Recognizer
        instance: recognizer
      - class: Ink
        instance: ink
        sees: [recognizer]
      - class: Pen
        instance: pen
      - class: Grip
        instance: grip
      - class: Menu
        instance: menu
      - class: LabelEdit
        instance: label
      - class: Clip
        instance: clip
      - class: NodeArt
        instance: art
        sees: [pen, label]
      - class: TopBar
        instance: top_bar
      - class: ToolBar
        instance: tools
      - class: Script
        instance: script
        sees: [top_bar, tools]
      - class: FileBrowser
        instance: browse
      - class: Files
        instance: files
        sees: [sheet_io, exporter, mermaid, pptx, browse]
      - class: Diag
        instance: diag
        sees: [exporter]
      - class: Reader
        instance: reader
        sees: [ink, diag, seq]
      - class: Editor
        instance: editor
        sees: [sheet_io, mermaid, markdown, exporter, ink, pen, grip, files, diag, reader, menu, label, clip, script, art, top_bar, tools, seq, seq_art, edge_art, deeds, past]
