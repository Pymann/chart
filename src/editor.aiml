# The editor surface (doc/spec/chart.md §15) and presentation mode (§14).
#
# A slide is a fixed 1280x720 page, scaled to fit and centred -- never re-laid-out
# (§14, normative): positions belong to the author, and a presentation that moved
# things to fit would show something the author never saw.
- import: "src/runtime.aiml"
- import: "src/ink.aiml"
- import: "src/pen.aiml"
- import: "src/grip.aiml"

- class:
    name: Editor
    description: "Window, action bar, canvas, presentation mode"
    members:
      - [sheet_io, ref<SheetIO>]        # borrow, wired dst_cy the classgroup
      - [mermaid, ref<MermaidOut>]
      - [markdown, ref<MarkdownOut>]
      - [exporter, ref<Exporter>]
      - [ink, ref<Ink>]
      - [pen, ref<Pen>]
      - [grip, ref<Grip>]
      - [deck, Deck]
      - [deck_path, string]
      - [armed, i32]                    # NodeKind to place on the next canvas click, -1 = none
      - [sel, string]                   # selected node ident, "" = nothing
      - [drag_id, string]               # node being dragged
      - [drag_dx, f32]
      - [drag_dy, f32]
      - [presenting, i32]
      - [show_notes, i32]
      - [status, string]
      - [editing, i32]                  # 1 while a label is being edited (spec §6)
      - [edit_text, string]
      - [edit_id, string]
      - [link_from, string]             # source node while an edge is being dragged
      - [sel_edge, string]
      - [last_scale, f32]               # slide scale of the last frame, for auto-grow
      - [diag, string]                  # --diag: Klickprotokoll
      - [diag_on, i32]                  # --diag 1
      - [settle, f64]                   # seconds the ink waits (spec §7.5a)
      - [read_at, i32]                  # ink size when it was last read
      - [bar_hov, i32]                  # DIAGNOSE: sieht die Leiste den Zeiger?
      - [last_action, i32]              # DIAGNOSE: was die Leiste zurueckgab
      - [textures, map<string:gl_texture>]
    methods:
      # ── geometry ────────────────────────────────────────────────────────────
      # Scale that fits the 1280x720 page into the canvas rect, with a margin.
      - def:
          name: fit_scale
          args: [[avail_w, f32], [avail_h, f32], [margin, f32]]
          return: f32
          body:
            - decl: [scale_x, f32, { /: [{ "*": [avail_w, margin] }, 1280.0] }]
            - decl: [scale_y, f32, { /: [{ "*": [avail_h, margin] }, 720.0] }]
            - if: { condition: { lt: [scale_x, scale_y] }, then: [{ return: scale_x }] }
            - return: scale_y

      # ── nodes and edges ─────────────────────────────────────────────────────
      - def:
          name: draw_node
          static_off: ["same_arg", "str_cmp"]
          args: [[node, ref<Node>], [org_x, f32], [org_y, f32], [scale, f32]]
          body:
            - decl: [box, Shape]
            - set: [box.pos_x, { +: [org_x, { "*": [node.pos_x, scale] }] }]
            - set: [box.pos_y, { +: [org_y, { "*": [node.pos_y, scale] }] }]
            - set: [box.width, { "*": [node.width, scale] }]
            - set: [box.height, { "*": [node.height, scale] }]
            - set: [box.thick, 2.0]
            - decl: [label, string, node.text]
            - if:
                condition: { "&&": [{ eq: [<.editing, 1] }, { eq: [node.ident, <.edit_id] }] }
                then: [{ set: [label, "${<.edit_text}|"] }]
            - decl: [fill, i32, node.fill]
            - if: { condition: { eq: [fill, 0] }, then: [{ set: [fill, 0xF2F5F9FF] }] }
            - decl: [stroke, i32, node.stroke]
            - if: { condition: { eq: [stroke, 0] }, then: [{ set: [stroke, 0x3A4A5AFF] }] }

            - if:
                condition: { eq: [node.kind, NodeKind.image] }
                then:
                  - if:
                      condition: { eq: [{ call: [<.textures.contains, node.src] }, 1] }
                      then:
                        - decl: [tex, gl_texture, { call: [<.textures.get, node.src] }]
                        - call: [ui.draw_image, box.pos_x, box.pos_y, box.width, box.height, tex]
                      else:
                        # A missing file is a placeholder carrying the path (spec §12):
                        # a blank box would hide WHICH file is absent.
                        - call: [ui.draw_rect, box.pos_x, box.pos_y, box.width, box.height, 0xE8E2D8FF]
                        - set: [box.tint, 0x806030FF]
                        - call: [<.pen.text_block, box, "[${node.src}]"]
                  - set: [box.tint, stroke]
                  - call: [<.pen.frame, box]
                  - if:
                      condition: { neq: [node.text, ""] }
                      then:
                        - decl: [cap, Shape]
                        - set: [cap.pos_x, box.pos_x]
                        - set: [cap.pos_y, { +: [box.pos_y, box.height] }]
                        - set: [cap.width, box.width]
                        - set: [cap.height, { "*": [24.0, scale] }]
                        - set: [cap.tint, 0x4A5A6AFF]
                        - call: [<.pen.text_block, cap, label]
                  - return: null

            - if:
                condition: { eq: [node.kind, NodeKind.diamond] }
                then:
                  - set: [box.tint, stroke]
                  - call: [<.pen.diamond, box]
                  - set: [box.tint, { call: [<.pen.ink_for, fill] }]
                  - call: [<.pen.text_block, box, label]
                  - return: null
            - if:
                condition: { eq: [node.kind, NodeKind.hexagon] }
                then:
                  - set: [box.tint, stroke]
                  - call: [<.pen.hexagon, box]
                  - set: [box.tint, { call: [<.pen.ink_for, fill] }]
                  - call: [<.pen.text_block, box, label]
                  - return: null
            - decl: [rounded, i32, 0]
            - if: { condition: { eq: [node.kind, NodeKind.circle] }, then: [{ set: [rounded, 1] }] }
            - if: { condition: { eq: [node.kind, NodeKind.round] }, then: [{ set: [rounded, 1] }] }
            - if: { condition: { eq: [node.kind, NodeKind.stadium] }, then: [{ set: [rounded, 1] }] }
            - if:
                condition: { eq: [rounded, 1] }
                then:
                  - set: [box.tint, stroke]
                  - call: [<.pen.ellipse, box]
                  - set: [box.tint, { call: [<.pen.ink_for, fill] }]
                  - call: [<.pen.text_block, box, label]
                  - return: null

            # rect, cylinder, subroutine
            - call: [ui.draw_rect, box.pos_x, box.pos_y, box.width, box.height, fill]
            - set: [box.tint, stroke]
            - call: [<.pen.frame, box]
            - if:
                condition: { eq: [node.kind, NodeKind.subroutine] }
                then:
                  - decl: [inset, f32, { "*": [9.0, scale] }]
                  - call: [ui.draw_line, { +: [box.pos_x, inset] }, box.pos_y, { +: [box.pos_x, inset] }, { +: [box.pos_y, box.height] }, 1.0, stroke]
                  - call: [ui.draw_line, { -: [{ +: [box.pos_x, box.width] }, inset] }, box.pos_y, { -: [{ +: [box.pos_x, box.width] }, inset] }, { +: [box.pos_y, box.height] }, 1.0, stroke]
            - set: [box.tint, { call: [<.pen.ink_for, fill] }]
            - call: [<.pen.text_block, box, label]

      - def:
          name: node_by_id
          static_off: ["same_arg", "str_cmp"]
          args: [[slide, ref<Sheet>], [ident, string], [out, ref<Node>]]
          return: i32
          body:
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, slide.nodes.len] }
                body:
                  - decl: [node, ref<Node>, { at: [slide.nodes, idx] }]
                  - if:
                      condition: { eq: [node.ident, ident] }
                      then:
                        - set: [out.kind, node.kind]
                        - set: [out.pos_x, node.pos_x]
                        - set: [out.pos_y, node.pos_y]
                        - set: [out.width, node.width]
                        - set: [out.height, node.height]
                        - return: 1
                  - set: [idx, { +: [idx, 1] }]
            - return: 0

      - def:
          name: draw_edges
          static_off: ["same_arg", "str_cmp"]
          args: [[slide, ref<Sheet>], [org_x, f32], [org_y, f32], [scale, f32]]
          body:
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, slide.edges.len] }
                body:
                  - decl: [edge, ref<Edge>, { at: [slide.edges, idx] }]
                  - decl: [head_node, Node]
                  - decl: [tail_node, Node]
                  - decl: [found, i32, { call: [<.node_by_id, slide, edge.from_id, head_node] }]
                  - if:
                      condition: { eq: [found, 1] }
                      then: [{ set: [found, { call: [<.node_by_id, slide, edge.to_id, tail_node] }] }]
                  - if: { condition: { eq: [edge.kind, EdgeKind.invisible] }, then: [{ set: [found, 0] }] }
                  - if:
                      condition: { eq: [found, 1] }
                      then:
                        - decl: [from_cx, f32, { +: [org_x, { "*": [{ +: [head_node.pos_x, { /: [head_node.width, 2.0] }] }, scale] }] }]
                        - decl: [from_cy, f32, { +: [org_y, { "*": [{ +: [head_node.pos_y, { /: [head_node.height, 2.0] }] }, scale] }] }]
                        - decl: [to_cx, f32, { +: [org_x, { "*": [{ +: [tail_node.pos_x, { /: [tail_node.width, 2.0] }] }, scale] }] }]
                        - decl: [to_cy, f32, { +: [org_y, { "*": [{ +: [tail_node.pos_y, { /: [tail_node.height, 2.0] }] }, scale] }] }]
                        - decl: [del_x, f32, { -: [from_cx, to_cx] }]
                        - decl: [del_y, f32, { -: [from_cy, to_cy] }]
                        - decl: [span, f32, { call: [math.sqrt, { +: [{ "*": [del_x, del_x] }, { "*": [del_y, del_y] }] }] }]
                        - if:
                            condition: { gt: [span, 1.0] }
                            then:
                              - decl: [uni_x, f32, { /: [del_x, span] }]
                              - decl: [uni_y, f32, { /: [del_y, span] }]
                              - decl: [stop_to, f32, { call: [<.pen.edge_stop, { "*": [{ /: [tail_node.width, 2.0] }, scale] }, { "*": [{ /: [tail_node.height, 2.0] }, scale] }, uni_x, uni_y, tail_node.kind] }]
                              - decl: [stop_from, f32, { call: [<.pen.edge_stop, { "*": [{ /: [head_node.width, 2.0] }, scale] }, { "*": [{ /: [head_node.height, 2.0] }, scale] }, uni_x, uni_y, head_node.kind] }]
                              - decl: [tip_x, f32, { +: [to_cx, { "*": [uni_x, stop_to] }] }]
                              - decl: [tip_y, f32, { +: [to_cy, { "*": [uni_y, stop_to] }] }]
                              - decl: [tail_x, f32, { -: [from_cx, { "*": [uni_x, stop_from] }] }]
                              - decl: [tail_y, f32, { -: [from_cy, { "*": [uni_y, stop_from] }] }]
                              - decl: [tint, i32, 0x55687AFF]
                              - decl: [thick, f32, 2.0]
                              - if: { condition: { eq: [edge.kind, EdgeKind.thick] }, then: [{ set: [thick, 4.5] }] }
                              - if: { condition: { eq: [edge.ident, <.sel_edge] }, then: [{ set: [tint, 0x2F80EDFF] }, { set: [thick, { +: [thick, 1.5] }] }] }
                              - if:
                                  condition: { eq: [edge.kind, EdgeKind.dotted] }
                                  then:
                                    - decl: [seg, Segment]
                                    - set: [seg.from_x, tail_x]
                                    - set: [seg.from_y, tail_y]
                                    - set: [seg.to_x, tip_x]
                                    - set: [seg.to_y, tip_y]
                                    - set: [seg.tint, tint]
                                    - set: [seg.thick, thick]
                                    - call: [<.pen.dashed, seg]
                                  else:
                                    - call: [ui.draw_line, tail_x, tail_y, tip_x, tip_y, thick, tint]
                              - decl: [head, f32, { "*": [16.0, scale] }]
                              - call: [ui.draw_line, tip_x, tip_y, { +: [tip_x, { "*": [{ -: [{ "*": [uni_x, 0.92] }, { "*": [uni_y, 0.40] }] }, head] }] }, { +: [tip_y, { "*": [{ +: [{ "*": [uni_y, 0.92] }, { "*": [uni_x, 0.40] }] }, head] }] }, 2.0, 0x55687AFF]
                              - call: [ui.draw_line, tip_x, tip_y, { +: [tip_x, { "*": [{ +: [{ "*": [uni_x, 0.92] }, { "*": [uni_y, 0.40] }] }, head] }] }, { +: [tip_y, { "*": [{ -: [{ "*": [uni_y, 0.92] }, { "*": [uni_x, 0.40] }] }, head] }] }, thick, tint]
                              # a double-headed edge is drawn with both heads --
                              # otherwise it is recognised, exported and stored as
                              # bidirectional while looking one-sided on the slide
                              - if:
                                  condition: { eq: [edge.kind, EdgeKind.bidirectional] }
                                  then:
                                    - call: [ui.draw_line, tail_x, tail_y, { -: [tail_x, { "*": [{ -: [{ "*": [uni_x, 0.92] }, { "*": [uni_y, 0.40] }] }, head] }] }, { -: [tail_y, { "*": [{ +: [{ "*": [uni_y, 0.92] }, { "*": [uni_x, 0.40] }] }, head] }] }, thick, tint]
                                    - call: [ui.draw_line, tail_x, tail_y, { -: [tail_x, { "*": [{ +: [{ "*": [uni_x, 0.92] }, { "*": [uni_y, 0.40] }] }, head] }] }, { -: [tail_y, { "*": [{ -: [{ "*": [uni_y, 0.92] }, { "*": [uni_x, 0.40] }] }, head] }] }, thick, tint]
                              - if:
                                  condition: { neq: [edge.text, ""] }
                                  then:
                                    - decl: [lab, Shape]
                                    - decl: [lab_w, f32, { call: [ui.measure_text, edge.text] }]
                                    - decl: [lab_h, f32, { call: [ui.text_height] }]
                                    - decl: [pad, f32, 7.0]
                                    - set: [lab.pos_x, { -: [{ /: [{ +: [tail_x, tip_x] }, 2.0] }, { +: [{ /: [lab_w, 2.0] }, pad] }] }]
                                    - set: [lab.pos_y, { -: [{ /: [{ +: [tail_y, tip_y] }, 2.0] }, { /: [lab_h, 2.0] }] }]
                                    - set: [lab.width, { +: [lab_w, { "*": [pad, 2.0] }] }]
                                    - set: [lab.height, lab_h]
                                    - set: [lab.tint, 0x33455AFF]
                                    - call: [ui.draw_rect, lab.pos_x, lab.pos_y, lab.width, lab.height, 0xFFFFFFF2]
                                    - call: [<.pen.text_block, lab, edge.text]
                  - set: [idx, { +: [idx, 1] }]

      # ── the page ────────────────────────────────────────────────────────────
      - def:
          name: draw_slide
          static_off: ["same_arg", "str_cmp"]
          args: [[cvs_x, f32], [cvs_y, f32], [cvs_w, f32], [cvs_h, f32], [margin, f32]]
          body:
            - if: { condition: { eq: [<.deck.slides.len, 0] }, then: [{ return: null }] }
            - if: { condition: { lt: [<.deck.current, 0] }, then: [{ set: [<.deck.current, 0] }] }
            - if: { condition: { ge: [<.deck.current, <.deck.slides.len] }, then: [{ set: [<.deck.current, { -: [<.deck.slides.len, 1] }] }] }
            - decl: [slide, ref<Sheet>, { at: [<.deck.slides, <.deck.current] }]
            - decl: [scale, f32, { call: [<.fit_scale, cvs_w, cvs_h, margin] }]
            - set: [<.last_scale, scale]
            - decl: [page_w, f32, { "*": [1280.0, scale] }]
            - decl: [page_h, f32, { "*": [720.0, scale] }]
            - decl: [org_x, f32, { +: [cvs_x, { /: [{ -: [cvs_w, page_w] }, 2.0] }] }]
            - decl: [org_y, f32, { +: [cvs_y, { /: [{ -: [cvs_h, page_h] }, 2.0] }] }]
            # a soft shadow, so the page reads as a sheet of paper
            - call: [ui.draw_rect, { +: [org_x, 6.0] }, { +: [org_y, 7.0] }, page_w, page_h, 0x0A0F1438]
            - call: [ui.draw_rect, org_x, org_y, page_w, page_h, 0xFFFFFFFF]
            - decl: [page, Shape]
            - set: [page.pos_x, org_x]
            - set: [page.pos_y, org_y]
            - set: [page.width, page_w]
            - set: [page.height, page_h]
            - set: [page.tint, 0xC2CCD6FF]
            - set: [page.thick, 1.0]
            - call: [<.pen.frame, page]
            - if:
                condition: { neq: [slide.title, ""] }
                then:
                  - call: [ui.draw_text, { +: [org_x, { "*": [52.0, scale] }] }, { +: [org_y, { "*": [30.0, scale] }] }, slide.title, 0x101A24FF]
                  - call: [ui.draw_line, { +: [org_x, { "*": [52.0, scale] }] }, { +: [org_y, { "*": [62.0, scale] }] }, { -: [{ +: [org_x, page_w] }, { "*": [52.0, scale] }] }, { +: [org_y, { "*": [62.0, scale] }] }, 1.0, 0xD8DEE6FF]
            - call: [<.draw_edges, slide, org_x, org_y, scale]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, slide.nodes.len] }
                body:
                  - decl: [node, ref<Node>, { at: [slide.nodes, idx] }]
                  - call: [<.draw_node, node, org_x, org_y, scale]
                  - if:
                      condition: { eq: [node.ident, <.sel] }
                      then:
                        - if:
                            condition: { eq: [<.presenting, 0] }
                            then:
                              - decl: [halo, Shape]
                              - set: [halo.pos_x, { -: [{ +: [org_x, { "*": [node.pos_x, scale] }] }, 5.0] }]
                              - set: [halo.pos_y, { -: [{ +: [org_y, { "*": [node.pos_y, scale] }] }, 5.0] }]
                              - set: [halo.width, { +: [{ "*": [node.width, scale] }, 10.0] }]
                              - set: [halo.height, { +: [{ "*": [node.height, scale] }, 10.0] }]
                              - set: [halo.tint, 0x2F80EDFF]
                              - set: [halo.thick, 2.0]
                              - call: [<.pen.frame, halo]
                  - set: [idx, { +: [idx, 1] }]
            # the ink: every stroke of the group, until it is read (spec §7.5a)
            - if:
                condition: { gt: [<.ink.count, 1] }
                then:
                  - decl: [sidx, i32, 0]
                  - while:
                      condition: { lt: [sidx, <.ink.starts.len] }
                      body:
                        - decl: [begin, i32, { call: [<.ink.at_from, sidx] }]
                        - decl: [count, i32, { call: [<.ink.at_len, sidx] }]
                        - if:
                            condition: { gt: [count, 1] }
                            then:
                              - decl: [ink, buffer<f32>]
                              - call: [ink.alloc, 16384]
                              - decl: [pidx, i32, 0]
                              - while:
                                  condition: { lt: [pidx, count] }
                                  body:
                                    - call: [<.ink.points.seek, { "*": [{ +: [begin, pidx] }, 8] }]
                                    - decl: [raw_x, f32, { call: [<.ink.points.read, f32] }]
                                    - decl: [raw_y, f32, { call: [<.ink.points.read, f32] }]
                                    - call: [ink.write, { +: [org_x, { "*": [raw_x, scale] }] }, f32]
                                    - call: [ink.write, { +: [org_y, { "*": [raw_y, scale] }] }, f32]
                                    - set: [pidx, { +: [pidx, 1] }]
                              - call: [ui.draw_polyline, ink, 2.5, 0x2F80EDFF]
                        - set: [sidx, { +: [sidx, 1] }]

            # What will be connected, before the button is let go (spec §15.1).
            - if:
                condition: { neq: [<.link_from, ""] }
                then:
                  - decl: [src_node, Node]
                  - if:
                      condition: { eq: [{ call: [<.node_by_id, slide, <.link_from, src_node] }, 1] }
                      then:
                        - call: [ui.draw_line,
                                 { +: [org_x, { "*": [{ +: [src_node.pos_x, { /: [src_node.width, 2.0] }] }, scale] }] },
                                 { +: [org_y, { "*": [{ +: [src_node.pos_y, { /: [src_node.height, 2.0] }] }, scale] }] },
                                 { call: [input.mouse_pos_x] }, { call: [input.mouse_pos_y] }, 2.0, 0x2F80EDC0]

            - if:
                condition: { eq: [<.presenting, 1] }
                then:
                  - decl: [number, i32, { +: [<.deck.current, 1] }]
                  - call: [ui.draw_text, { -: [{ +: [cvs_x, cvs_w] }, 70.0] }, { -: [{ +: [cvs_y, cvs_h] }, 26.0] }, "${number} / ${<.deck.slides.len}", 0x8A97A5FF]
                  - if:
                      condition: { eq: [<.show_notes, 1] }
                      then:
                        - if:
                            condition: { neq: [slide.notes, ""] }
                            then:
                              - call: [ui.draw_rect, cvs_x, { -: [{ +: [cvs_y, cvs_h] }, 58.0] }, cvs_w, 58.0, 0x0A0F14D8]
                              - call: [ui.draw_text, { +: [cvs_x, 18.0] }, { -: [{ +: [cvs_y, cvs_h] }, 42.0] }, slide.notes, 0xF0E8D0FF]

      # ── the action bar (spec §8.1) ──────────────────────────────────────────
      # glbview's pattern: a column of buttons, each setting ONE integer that a
      # single dispatch point consumes afterwards.
      - def:
          name: bar
          static_off: ["same_arg", "str_cmp"]
          return: i32
          body:
            - decl: [action, i32, 0]
            - call: [ui.begin_cell, 0, 0, 1, 1]
            - call: [ui.set_scroll, "y"]
            - set: [<.bar_hov, { call: [ui.cell_hovered] }]
            - call: [ui.label, "chart"]
            - call: [ui.label, "frei zeichnen:"]
            - call: [ui.label, "einfach losziehen"]
            - call: [ui.separator]
            - call: [ui.label, <.status]
            - call: [ui.separator]

            - call: [ui.label, "Datei"]
            - if: { condition: { call: [ui.button, "Speichern"] }, then: [{ set: [action, 1] }] }
            - if: { condition: { call: [ui.button, "Markdown"] }, then: [{ set: [action, 2] }] }
            - if: { condition: { call: [ui.button, "Mermaid"] }, then: [{ set: [action, 3] }] }
            - call: [ui.separator]

            - call: [ui.label, "Formen"]
            - if: { condition: { call: [ui.button, "Kasten"] }, then: [{ set: [action, 10] }] }
            - if: { condition: { call: [ui.button, "Rund"] }, then: [{ set: [action, 11] }] }
            - if: { condition: { call: [ui.button, "Kapsel"] }, then: [{ set: [action, 12] }] }
            - if: { condition: { call: [ui.button, "Kreis"] }, then: [{ set: [action, 13] }] }
            - if: { condition: { call: [ui.button, "Raute"] }, then: [{ set: [action, 14] }] }
            - if: { condition: { call: [ui.button, "Sechseck"] }, then: [{ set: [action, 15] }] }
            - if: { condition: { call: [ui.button, "Zylinder"] }, then: [{ set: [action, 16] }] }
            - if: { condition: { call: [ui.button, "Unterprogramm"] }, then: [{ set: [action, 17] }] }
            - if: { condition: { call: [ui.button, "Bild"] }, then: [{ set: [action, 18] }] }
            - call: [ui.separator]

            - call: [ui.label, "Verbinden"]
            - if: { condition: { call: [ui.button, "Pfeil ziehen"] }, then: [{ set: [action, 19] }] }
            - if:
                condition: { neq: [<.sel_edge, ""] }
                then:
                  - if: { condition: { call: [ui.button, "-- normal"] }, then: [{ set: [action, 50] }] }
                  - if: { condition: { call: [ui.button, "-- offen"] }, then: [{ set: [action, 51] }] }
                  - if: { condition: { call: [ui.button, "-- gepunktet"] }, then: [{ set: [action, 52] }] }
                  - if: { condition: { call: [ui.button, "-- dick"] }, then: [{ set: [action, 53] }] }
                  - if: { condition: { call: [ui.button, "-- beidseitig"] }, then: [{ set: [action, 54] }] }
                  - if: { condition: { call: [ui.button, "-- unsichtbar"] }, then: [{ set: [action, 55] }] }
            - call: [ui.separator]

            - call: [ui.label, "Auswahl"]
            - if: { condition: { call: [ui.button, "Beschriften"] }, then: [{ set: [action, 26] }] }
            - if: { condition: { call: [ui.button, "Entfernen"] }, then: [{ set: [action, 20] }] }
            - call: [ui.separator]

            - call: [ui.label, "Folien"]
            - if: { condition: { call: [ui.button, "< Zurueck"] }, then: [{ set: [action, 21] }] }
            - if: { condition: { call: [ui.button, "Weiter >"] }, then: [{ set: [action, 22] }] }
            - if: { condition: { call: [ui.button, "Neue Folie"] }, then: [{ set: [action, 23] }] }
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, <.deck.slides.len] }
                body:
                  - decl: [slide, ref<Sheet>, { at: [<.deck.slides, idx] }]
                  - decl: [number, i32, { +: [idx, 1] }]
                  - decl: [mark, string, "  "]
                  - if: { condition: { eq: [idx, <.deck.current] }, then: [{ set: [mark, "> "] }] }
                  - decl: [name, string, slide.title]
                  - if: { condition: { eq: [name, ""] }, then: [{ set: [name, "(ohne Titel)"] }] }
                  - if:
                      condition: { call: [ui.button, "${mark}${number} ${name}"] }
                      then: [{ set: [action, { +: [40, idx] }] }]
                  - set: [idx, { +: [idx, 1] }]
            - call: [ui.separator]

            - call: [ui.label, "Ansicht"]
            - if: { condition: { call: [ui.button, "Praesentieren"] }, then: [{ set: [action, 30] }] }
            - call: [ui.end_cell]
            - return: action

      # ── dispatch ────────────────────────────────────────────────────────────
      - def:
          name: dispatch
          static_off: ["same_arg", "str_cmp"]
          args: [[action, i32]]
          body:
            - if: { condition: { eq: [action, 0] }, then: [{ return: null }] }

            - if:
                condition: { eq: [action, 1] }
                then:
                  - decl: [yaml_text, string, { call: [<.sheet_io.deck_yaml, <.deck] }]
                  - if:
                      condition: { eq: [{ call: [<.exporter.write_file, <.deck_path, yaml_text] }, 1] }
                      then: [{ set: [<.status, "gespeichert"] }]
                      else: [{ set: [<.status, "Speichern fehlgeschlagen"] }]
                  - return: null
            - if:
                condition: { eq: [action, 2] }
                then:
                  - if:
                      condition: { eq: [{ call: [<.exporter.write_markdown, <.deck, "export/md"] }, 1] }
                      then: [{ set: [<.status, "Markdown in export/md"] }]
                      else: [{ set: [<.status, "Markdown fehlgeschlagen"] }]
                  - return: null
            - if:
                condition: { eq: [action, 3] }
                then:
                  - decl: [cur_mm, i32, <.deck.current]
                  - decl: [slide_mm, ref<Sheet>, { at: [<.deck.slides, cur_mm] }]
                  - decl: [text, string, { call: [<.mermaid.emit, slide_mm] }]
                  - if:
                      condition: { eq: [{ call: [<.exporter.write_file, "export/slide.mmd", text] }, 1] }
                      then: [{ set: [<.status, "Mermaid in export/slide.mmd"] }]
                      else: [{ set: [<.status, "Mermaid fehlgeschlagen"] }]
                  - return: null

            - if:
                condition: { eq: [action, 27] }
                then:
                  - set: [<.armed, 101]
                  - set: [<.status, "zeichnen -- Form wird erkannt"]
                  - return: null
            - if:
                condition: { eq: [action, 19] }
                then:
                  - set: [<.armed, 100]
                  - set: [<.status, "von Knoten zu Knoten ziehen"]
                  - return: null
            - if:
                condition: { eq: [action, 26] }
                then:
                  - if: { condition: { neq: [<.sel, ""] }, then: [{ call: [<.begin_edit, <.sel] }] }
                  - return: null
            # 50..55: the selected edge's kind (spec §5.3)
            - if:
                condition: { ge: [action, 50] }
                then:
                  - if:
                      condition: { le: [action, 55] }
                      then:
                        - if: { condition: { eq: [<.sel_edge, ""] }, then: [{ return: null }] }
                        - decl: [slide_k, ref<Sheet>, { at: [<.deck.slides, <.deck.current] }]
                        - decl: [kidx, i32, 0]
                        - while:
                            condition: { lt: [kidx, slide_k.edges.len] }
                            body:
                              - decl: [edge_k, ref<Edge>, { at: [slide_k.edges, kidx] }]
                              - if:
                                  condition: { eq: [edge_k.ident, <.sel_edge] }
                                  then:
                                    - set: [edge_k.kind, { -: [action, 50] }]
                                    - set: [<.status, "Kantenart gesetzt"]
                                    - set: [kidx, slide_k.edges.len]
                              - set: [kidx, { +: [kidx, 1] }]
                        - return: null

            # 10..18: arm a stencil.  The next canvas click places it (spec §15.1).
            - if:
                condition: { ge: [action, 10] }
                then:
                  - if:
                      condition: { le: [action, 18] }
                      then:
                        - set: [<.armed, { -: [action, 10] }]
                        - set: [<.status, "Form gewaehlt -- in die Flaeche klicken"]
                        - return: null

            - if:
                condition: { eq: [action, 20] }
                then:
                  - if:
                      condition: { neq: [<.sel_edge, ""] }
                      then:
                        - decl: [slide_e, ref<Sheet>, { at: [<.deck.slides, <.deck.current] }]
                        - decl: [eidx, i32, 0]
                        - while:
                            condition: { lt: [eidx, slide_e.edges.len] }
                            body:
                              - decl: [edge_e, ref<Edge>, { at: [slide_e.edges, eidx] }]
                              - if:
                                  condition: { eq: [edge_e.ident, <.sel_edge] }
                                  then:
                                    - call: [slide_e.edges.remove, eidx]
                                    - set: [<.sel_edge, ""]
                                    - set: [<.status, "Kante entfernt"]
                                    - return: null
                              - set: [eidx, { +: [eidx, 1] }]
                  - if:
                      condition: { neq: [<.sel, ""] }
                      then:
                        - decl: [cur_del, i32, <.deck.current]
                        - decl: [slide_del, ref<Sheet>, { at: [<.deck.slides, cur_del] }]
                        # its edges go with it: a kept edge names an endpoint that is
                        # gone, and §5 would project Mermaid that never declares it.
                        # Backwards, so a removal does not skip the next edge.
                        - decl: [cut, i32, { -: [slide_del.edges.len, 1] }]
                        - while:
                            condition: { ge: [cut, 0] }
                            body:
                              - decl: [edge_c, ref<Edge>, { at: [slide_del.edges, cut] }]
                              - decl: [touches, i32, 0]
                              - if: { condition: { eq: [edge_c.from_id, <.sel] }, then: [{ set: [touches, 1] }] }
                              - if: { condition: { eq: [edge_c.to_id, <.sel] }, then: [{ set: [touches, 1] }] }
                              - if: { condition: { eq: [touches, 1] }, then: [{ call: [slide_del.edges.remove, cut] }] }
                              - set: [cut, { -: [cut, 1] }]
                        - decl: [pos, i32, 0]
                        - while:
                            condition: { lt: [pos, slide_del.nodes.len] }
                            body:
                              - decl: [node, ref<Node>, { at: [slide_del.nodes, pos] }]
                              - if:
                                  condition: { eq: [node.ident, <.sel] }
                                  then:
                                    - call: [slide_del.nodes.remove, pos]
                                    - set: [<.sel, ""]
                                    - set: [<.status, "entfernt"]
                                    - return: null
                              - set: [pos, { +: [pos, 1] }]
                  - return: null

            - if:
                condition: { eq: [action, 21] }
                then:
                  - if: { condition: { gt: [<.deck.current, 0] }, then: [{ set: [<.deck.current, { -: [<.deck.current, 1] }] }, { set: [<.sel, ""] }] }
                  - return: null
            - if:
                condition: { eq: [action, 22] }
                then:
                  - if: { condition: { lt: [<.deck.current, { -: [<.deck.slides.len, 1] }] }, then: [{ set: [<.deck.current, { +: [<.deck.current, 1] }] }, { set: [<.sel, ""] }] }
                  - return: null
            - if:
                condition: { eq: [action, 23] }
                then:
                  - decl: [fresh, Sheet]
                  - set: [fresh.title, "Neue Folie"]
                  - set: [fresh.next_id, 1]
                  - call: [<.deck.slides.push, fresh]
                  - set: [<.deck.current, { -: [<.deck.slides.len, 1] }]
                  - set: [<.sel, ""]
                  - set: [<.status, "Folie angelegt"]
                  - return: null

            - if:
                condition: { eq: [action, 30] }
                then:
                  - set: [<.presenting, 1]
                  - set: [<.sel, ""]
                  - return: null

            # 40+: pick that slide
            - if:
                condition: { ge: [action, 40] }
                then:
                  - set: [<.deck.current, { -: [action, 40] }]
                  - set: [<.sel, ""]

      # ── canvas input (spec §15.1) ──────────────────────────────────────────
      # §7.5: an endpoint hits a node's box GROWN by `reach`. Without it a line has
      # to start and end exactly inside the shape, which is not how anybody draws.
      - def:
          name: node_near
          static_off: ["same_arg", "str_cmp"]
          args: [[slide, ref<Sheet>], [spot_x, f32], [spot_y, f32], [reach, f32]]
          return: string
          body:
            - decl: [pos, i32, { -: [slide.nodes.len, 1] }]
            - while:
                condition: { ge: [pos, 0] }
                body:
                  - decl: [node, ref<Node>, { at: [slide.nodes, pos] }]
                  - if:
                      condition: { ge: [spot_x, { -: [node.pos_x, reach] }] }
                      then:
                        - if:
                            condition: { le: [spot_x, { +: [{ +: [node.pos_x, node.width] }, reach] }] }
                            then:
                              - if:
                                  condition: { ge: [spot_y, { -: [node.pos_y, reach] }] }
                                  then:
                                    - if:
                                        condition: { le: [spot_y, { +: [{ +: [node.pos_y, node.height] }, reach] }] }
                                        then: [{ return: node.ident }]
                  - set: [pos, { -: [pos, 1] }]
            - return: ""

      - def:
          name: node_at
          static_off: ["same_arg", "str_cmp"]
          args: [[slide, ref<Sheet>], [spot_x, f32], [spot_y, f32]]
          return: string
          body:
            # topmost first: the last node drawn is the one on top
            - decl: [pos, i32, { -: [slide.nodes.len, 1] }]
            - while:
                condition: { ge: [pos, 0] }
                body:
                  - decl: [node, ref<Node>, { at: [slide.nodes, pos] }]
                  - if:
                      condition: { ge: [spot_x, node.pos_x] }
                      then:
                        - if:
                            condition: { le: [spot_x, { +: [node.pos_x, node.width] }] }
                            then:
                              - if:
                                  condition: { ge: [spot_y, node.pos_y] }
                                  then:
                                    - if:
                                        condition: { le: [spot_y, { +: [node.pos_y, node.height] }] }
                                        then: [{ return: node.ident }]
                  - set: [pos, { -: [pos, 1] }]
            - return: ""

      # Nearest edge within `reach` slide units of the centre-to-centre line.
      - def:
          name: edge_at
          static_off: ["same_arg", "str_cmp"]
          args: [[slide, ref<Sheet>], [spot_x, f32], [spot_y, f32], [reach, f32]]
          return: string
          body:
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, slide.edges.len] }
                body:
                  - decl: [edge, ref<Edge>, { at: [slide.edges, idx] }]
                  - decl: [head_node, Node]
                  - decl: [tail_node, Node]
                  - decl: [found, i32, { call: [<.node_by_id, slide, edge.from_id, head_node] }]
                  - if:
                      condition: { eq: [found, 1] }
                      then: [{ set: [found, { call: [<.node_by_id, slide, edge.to_id, tail_node] }] }]
                  - if:
                      condition: { eq: [found, 1] }
                      then:
                        - decl: [src_cx, f32, { +: [head_node.pos_x, { /: [head_node.width, 2.0] }] }]
                        - decl: [src_cy, f32, { +: [head_node.pos_y, { /: [head_node.height, 2.0] }] }]
                        - decl: [dst_cx, f32, { +: [tail_node.pos_x, { /: [tail_node.width, 2.0] }] }]
                        - decl: [dst_cy, f32, { +: [tail_node.pos_y, { /: [tail_node.height, 2.0] }] }]
                        - decl: [run_x, f32, { -: [dst_cx, src_cx] }]
                        - decl: [run_y, f32, { -: [dst_cy, src_cy] }]
                        - decl: [vlen, f32, { +: [{ "*": [run_x, run_x] }, { "*": [run_y, run_y] }] }]
                        - if:
                            condition: { gt: [vlen, 0.01] }
                            then:
                              - decl: [part, f32, { /: [{ +: [{ "*": [{ -: [spot_x, src_cx] }, run_x] }, { "*": [{ -: [spot_y, src_cy] }, run_y] }] }, vlen] }]
                              - set: [part, { call: [math.clamp, part, 0.0, 1.0] }]
                              - decl: [nearx, f32, { +: [src_cx, { "*": [run_x, part] }] }]
                              - decl: [neary, f32, { +: [src_cy, { "*": [run_y, part] }] }]
                              - decl: [gap, f32, { call: [math.sqrt, { +: [{ "*": [{ -: [spot_x, nearx] }, { -: [spot_x, nearx] }] }, { "*": [{ -: [spot_y, neary] }, { -: [spot_y, neary] }] }] }] }]
                              - if: { condition: { lt: [gap, reach] }, then: [{ return: edge.ident }] }
                  - set: [idx, { +: [idx, 1] }]
            - return: ""

      - def:
          name: canvas_input
          static_off: ["same_arg", "str_cmp"]
          args: [[cvs_x, f32], [cvs_y, f32], [cvs_w, f32], [cvs_h, f32], [margin, f32]]
          body:
            - if: { condition: { eq: [<.deck.slides.len, 0] }, then: [{ return: null }] }
            - decl: [mouse_x, f32, { call: [input.mouse_pos_x] }]
            - decl: [mouse_y, f32, { call: [input.mouse_pos_y] }]
            - decl: [scale, f32, { call: [<.fit_scale, cvs_w, cvs_h, margin] }]
            - decl: [org_x, f32, { +: [cvs_x, { /: [{ -: [cvs_w, { "*": [1280.0, scale] }] }, 2.0] }] }]
            - decl: [org_y, f32, { +: [cvs_y, { /: [{ -: [cvs_h, { "*": [720.0, scale] }] }, 2.0] }] }]
            - decl: [slide_x, f32, { /: [{ -: [mouse_x, org_x] }, scale] }]
            - decl: [slide_y, f32, { /: [{ -: [mouse_y, org_y] }, scale] }]
            - decl: [slide, ref<Sheet>, { at: [<.deck.slides, <.deck.current] }]
            - decl: [over_canvas, i32, 1]
            - if: { condition: { lt: [mouse_x, cvs_x] }, then: [{ set: [over_canvas, 0] }] }
            # ── the pointer says what a drag from here would do (spec §15.1a) ─
            - if:
                condition: { "||": [{ eq: [over_canvas, 0] }, { eq: [<.presenting, 1] }] }
                then: [{ call: [input.set_cursor, "arrow"] }]
                else:
                  - if:
                      condition: { eq: [<.editing, 1] }
                      then: [{ call: [input.set_cursor, "text"] }]
                      else: [{ call: [<.grip.point, slide, <.sel, slide_x, slide_y] }]
            # DIAGNOSE: beide Flanken getrennt -- ui.button feuert auf RELEASED,
            # meine bisherige Diagnose hing an PRESSED.
            - decl: [down_now, i32, { call: [input.mouse_pressed, 0] }]
            - decl: [up_now, i32, { call: [input.mouse_released, 0] }]
            - decl: [held, i32, { call: [input.mouse_button, 0] }]
            - if:
                condition: { "||": [{ neq: [down_now, 0] }, { neq: [up_now, 0] }] }
                then:
                  - set: [<.status, "P${down_now} R${up_now} H${held} F${over_canvas} W${<.armed}"]
                  - decl: [hit_dbg, string, { call: [<.node_at, slide, slide_x, slide_y] }]
                  - if: { condition: { eq: [<.diag_on, 0] }, then: [{ return: null }] }
                  - set: [<.diag, "${<.diag}P${down_now} R${up_now} H${held} fenster=${ { cast: [mouse_x, i32] } },${ { cast: [mouse_y, i32] } } folie=${ { cast: [slide_x, i32] } },${ { cast: [slide_y, i32] } } flaeche=${over_canvas} leiste_hover=${<.bar_hov} aktion=${<.last_action} werkzeug=${<.armed} treffer='${hit_dbg}'\n"]
                  - call: [<.exporter.write_file, "diag.log", <.diag]

            # ── press ────────────────────────────────────────────────────────
            - if:
                condition: { "&&": [{ call: [input.mouse_pressed, 0] }, { eq: [over_canvas, 1] }] }
                then:
                  # A press anywhere commits an open label first (spec §6): the next
                  # stroke must not silently discard what was just typed.
                  - if: { condition: { eq: [<.editing, 1] }, then: [{ call: [<.commit_label] }] }
                  # the blue halo resizes (spec §15.1a).  Only with no explicit tool
                  # or the freehand default: an armed stencil still places.
                  - if:
                      condition: { "||": [{ eq: [<.armed, -1] }, { eq: [<.armed, 101] }] }
                      then:
                        - if:
                            condition: { eq: [{ call: [<.grip.start, slide, <.sel, slide_x, slide_y] }, 1] }
                            then:
                              - set: [<.status, "Groesse ziehen"]
                              - return: null
                  # freehand (spec §7): press starts the stroke
                  - if:
                      condition: { eq: [<.armed, 101] }
                      then:
                        - call: [<.ink.begin_stroke, slide_x, slide_y]
                        - return: null
                  # edge tool: press starts the link, release finishes it
                  - if:
                      condition: { eq: [<.armed, 100] }
                      then:
                        - decl: [src, string, { call: [<.node_at, slide, slide_x, slide_y] }]
                        - if:
                            condition: { neq: [src, ""] }
                            then: [{ set: [<.link_from, src] }, { set: [<.status, "auf das Ziel loslassen"] }]
                            else: [{ set: [<.status, "Kante beginnt auf einem Knoten"] }]
                        - return: null
                  # stencil: place, then straight into the label (spec §15.1)
                  - if:
                      condition: { ge: [<.armed, 0] }
                      then:
                        - decl: [fresh, Node]
                        - set: [fresh.ident, "n${slide.next_id}"]
                        - set: [fresh.kind, <.armed]
                        - set: [fresh.pos_x, { -: [slide_x, 100.0] }]
                        - set: [fresh.pos_y, { -: [slide_y, 45.0] }]
                        - set: [fresh.width, 200.0]
                        - set: [fresh.height, 90.0]
                        - call: [slide.nodes.push, fresh]
                        - set: [slide.next_id, { +: [slide.next_id, 1] }]
                        - set: [<.armed, -1]
                        - call: [<.begin_edit, fresh.ident]
                        - return: null
                  - decl: [hit, string, { call: [<.node_at, slide, slide_x, slide_y] }]
                  - if:
                      condition: { eq: [hit, ""] }
                      then:
                        # An edge under the cursor is selected; otherwise a drag on
                        # empty canvas IS the stroke. Drawing is what the surface is
                        # for, so it costs no mode: a stroke too short to recognise
                        # does nothing, which is what a stray click should do anyway.
                        - decl: [near_edge, string, { call: [<.edge_at, slide, slide_x, slide_y, 12.0] }]
                        - if:
                            condition: { neq: [near_edge, ""] }
                            then:
                              - set: [<.sel, ""]
                              - set: [<.sel_edge, near_edge]
                              - return: null
                        - set: [<.sel, ""]
                        - set: [<.sel_edge, ""]
                        - call: [<.ink.begin_stroke, slide_x, slide_y]
                        - return: null
                  - if:
                      condition: { neq: [hit, ""] }
                      then:
                        # Drag the RIM to connect, the middle to move. Starting on a
                        # node had no way to mean "draw a line" -- the gesture was
                        # taken, so a connector could never begin on its source.
                        - decl: [rim, i32, 0]
                        - decl: [ridx, i32, 0]
                        - while:
                            condition: { lt: [ridx, slide.nodes.len] }
                            body:
                              - decl: [rnode, ref<Node>, { at: [slide.nodes, ridx] }]
                              - if:
                                  condition: { eq: [rnode.ident, hit] }
                                  then:
                                    - decl: [to_left, f32, { call: [math.abs, { -: [slide_x, rnode.pos_x] }] }]
                                    - decl: [to_right, f32, { call: [math.abs, { -: [slide_x, { +: [rnode.pos_x, rnode.width] }] }] }]
                                    - decl: [to_top, f32, { call: [math.abs, { -: [slide_y, rnode.pos_y] }] }]
                                    - decl: [to_bottom, f32, { call: [math.abs, { -: [slide_y, { +: [rnode.pos_y, rnode.height] }] }] }]
                                    - decl: [nearest, f32, { call: [math.min, { call: [math.min, to_left, to_right] }, { call: [math.min, to_top, to_bottom] }] }]
                                    - if: { condition: { lt: [nearest, 14.0] }, then: [{ set: [rim, 1] }] }
                                    - set: [ridx, slide.nodes.len]
                              - set: [ridx, { +: [ridx, 1] }]
                        - if:
                            condition: { eq: [rim, 1] }
                            then:
                              - set: [<.sel, ""]
                              - set: [<.sel_edge, ""]
                              - call: [<.ink.begin_stroke, slide_x, slide_y]
                              - set: [<.status, "Rand gezogen -- auf ein Ziel loslassen"]
                              - return: null
                        # a click on the ALREADY selected node opens its label -- the
                        # second click is the intent, and it needs no double-click clock
                        - if:
                            condition: { eq: [hit, <.sel] }
                            then: [{ call: [<.begin_edit, hit] }]
                        - set: [<.sel, hit]
                        - set: [<.sel_edge, ""]
                        - set: [<.drag_id, hit]
                        - decl: [grab, ref<Node>]
                        - decl: [pos2, i32, 0]
                        - while:
                            condition: { lt: [pos2, slide.nodes.len] }
                            body:
                              - decl: [node2, ref<Node>, { at: [slide.nodes, pos2] }]
                              - if:
                                  condition: { eq: [node2.ident, hit] }
                                  then:
                                    - set: [<.drag_dx, { -: [slide_x, node2.pos_x] }]
                                    - set: [<.drag_dy, { -: [slide_y, node2.pos_y] }]
                                    - set: [pos2, slide.nodes.len]
                              - set: [pos2, { +: [pos2, 1] }]
                  - return: null

            # ── the ink is read on the right button, or after one second ──────
            - if:
                condition: { "&&": [{ gt: [<.ink.count, 0] }, { eq: [<.ink.inking, 0] }] }
                then:
                  - decl: [now, f64, { call: [engine.time] }]
                  - decl: [idle, f64, { -: [now, <.ink.last] }]
                  # Re-reading unchanged ink would repeat the same verdict every
                  # settle period -- and did, three times over in the log.
                  - decl: [fresh_ink, i32, 0]
                  - if: { condition: { neq: [<.ink.count, <.read_at] }, then: [{ set: [fresh_ink, 1] }] }
                  - if:
                      condition: { "||": [{ call: [input.mouse_pressed, 1] }, { "&&": [{ eq: [fresh_ink, 1] }, { gt: [idle, <.settle] }] }] }
                      then:
                        - set: [<.read_at, <.ink.count]
                        - decl: [made, i32, { call: [<.read_ink, slide] }]
                        # A group that produced nothing is KEPT: drawing a head first
                        # and then taking a moment over the line must not cost the
                        # head. The right button is the explicit discard.
                        - if:
                            condition: { "||": [{ gt: [made, 0] }, { call: [input.mouse_pressed, 1] }] }
                            then: [{ call: [<.ink.clear] }, { set: [<.read_at, 0] }]
                            else: [{ set: [<.ink.last, { call: [engine.time] }] }]
                        - return: null

            # ── freehand: collect while held (spec §7.5a) ─────────────────────
            - if:
                condition: { eq: [<.ink.inking, 1] }
                then:
                  - if:
                      condition: { call: [input.mouse_released, 0] }
                      then:
                        - call: [<.ink.add_point, slide_x, slide_y]
                        - set: [<.ink.inking, 0]
                        - set: [<.armed, -1]
                        - set: [<.ink.last, { call: [engine.time] }]
                        - set: [<.status, "Tinte steht -- rechte Taste oder 1 s Pause liest sie"]
                        - return: null
                  - call: [<.ink.add_point, slide_x, slide_y]
                  - return: null

            # ── release: finish a link ───────────────────────────────────────
            - if:
                condition: { call: [input.mouse_released, 0] }
                then:
                  - if:
                      condition: { neq: [<.link_from, ""] }
                      then:
                        - decl: [dst, string, { call: [<.node_at, slide, slide_x, slide_y] }]
                        - if:
                            condition: { "&&": [{ neq: [dst, ""] }, { neq: [dst, <.link_from] }] }
                            then:
                              - decl: [edge, Edge]
                              - set: [edge.ident, "e${slide.next_id}"]
                              - set: [edge.from_id, <.link_from]
                              - set: [edge.to_id, dst]
                              - set: [edge.kind, EdgeKind.arrow]
                              - call: [slide.edges.push, edge]
                              - set: [slide.next_id, { +: [slide.next_id, 1] }]
                              - set: [<.sel_edge, edge.ident]
                              - set: [<.status, "Kante gezogen"]
                            else:
                              # released on nothing: a dangling edge has no Mermaid form
                              - set: [<.status, "auf keinem Knoten losgelassen -- nichts angelegt"]
                        - set: [<.link_from, ""]
                        - set: [<.armed, -1]
                  - set: [<.drag_id, ""]
                  - return: null

            # ── resize by the halo (spec §15.1a) ─────────────────────────────
            - if:
                condition: { eq: [{ call: [<.grip.active] }, 1] }
                then:
                  - if:
                      condition: { eq: [{ call: [input.mouse_button, 0] }, 0] }
                      then: [{ call: [<.grip.stop] }, { return: null }]
                  - call: [<.grip.drag, slide, slide_x, slide_y]
                  - return: null

            # ── drag a node ──────────────────────────────────────────────────
            - if:
                condition: { eq: [{ call: [input.mouse_button, 0] }, 0] }
                then: [{ set: [<.drag_id, ""] }, { return: null }]
            - if:
                condition: { neq: [<.drag_id, ""] }
                then:
                  - decl: [pos, i32, 0]
                  - while:
                      condition: { lt: [pos, slide.nodes.len] }
                      body:
                        - decl: [node, ref<Node>, { at: [slide.nodes, pos] }]
                        - if:
                            condition: { eq: [node.ident, <.drag_id] }
                            then:
                              - set: [node.pos_x, { -: [slide_x, <.drag_dx] }]
                              - set: [node.pos_y, { -: [slide_y, <.drag_dy] }]
                              - set: [pos, slide.nodes.len]
                        - set: [pos, { +: [pos, 1] }]

      - def:
          name: log_ink
          static_off: ["same_arg", "str_cmp"]
          args: [[what, string], [shape, ref<Guess>], [total, i32]]
          body:
            - if: { condition: { eq: [<.diag_on, 0] }, then: [{ return: null }] }
            # The percentages are computed first: a `"*"` inside a double-quoted
            # scalar ends that scalar, and the parser then reports a flow error
            # 130 characters further along.
            - decl: [closed_pct, i32, { cast: [{ "*": [shape.closed, 100.0] }, i32] }]
            - decl: [fill_pct, i32, { cast: [{ "*": [shape.fill, 100.0] }, i32] }]
            - set: [<.diag, "${<.diag}TINTE striche=${total} punkte=${<.ink.count} geschlossen=${closed_pct}% fuellung=${fill_pct}% ecken=${shape.corners} kopf=${shape.has_head} fuss=${shape.has_tail} -> ${what}\n"]
            - call: [<.exporter.write_file, "diag.log", <.diag]

      # The two ends of the whole group: project every point on the group's own
      # direction and take the extremes. Taking "first point of the first stroke" and
      # "tip of the last" assumes the strokes were drawn in order and none overshot --
      # neither holds for dashes.
      - def:
          name: group_ends
          args: [[ends, ref<Guess>]]
          body:
            - if: { condition: { lt: [<.ink.count, 2] }, then: [{ return: null }] }
            - call: [<.ink.points.seek, 0]
            - decl: [from_x, f32, { call: [<.ink.points.read, f32] }]
            - decl: [from_y, f32, { call: [<.ink.points.read, f32] }]
            - call: [<.ink.points.seek, { "*": [{ -: [<.ink.count, 1] }, 8] }]
            - decl: [to_x, f32, { call: [<.ink.points.read, f32] }]
            - decl: [to_y, f32, { call: [<.ink.points.read, f32] }]
            - decl: [dir_x, f32, { -: [to_x, from_x] }]
            - decl: [dir_y, f32, { -: [to_y, from_y] }]
            - decl: [span, f32, { call: [math.sqrt, { +: [{ "*": [dir_x, dir_x] }, { "*": [dir_y, dir_y] }] }] }]
            - if: { condition: { lt: [span, 1.0] }, then: [{ return: null }] }
            - set: [dir_x, { /: [dir_x, span] }]
            - set: [dir_y, { /: [dir_y, span] }]
            - decl: [least, f32, 1000000.0]
            - decl: [most, f32, -1000000.0]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, <.ink.count] }
                body:
                  - call: [<.ink.points.seek, { "*": [idx, 8] }]
                  - decl: [spot_x, f32, { call: [<.ink.points.read, f32] }]
                  - decl: [spot_y, f32, { call: [<.ink.points.read, f32] }]
                  - decl: [along, f32, { +: [{ "*": [spot_x, dir_x] }, { "*": [spot_y, dir_y] }] }]
                  - if:
                      condition: { lt: [along, least] }
                      then: [{ set: [least, along] }, { set: [ends.pos_x, spot_x] }, { set: [ends.pos_y, spot_y] }]
                  - if:
                      condition: { gt: [along, most] }
                      then: [{ set: [most, along] }, { set: [ends.tip_x, spot_x] }, { set: [ends.tip_y, spot_y] }]
                  - set: [idx, { +: [idx, 1] }]

      - def:
          name: stroke_span
          args: [[which, i32]]
          return: f32
          body:
            - decl: [count, i32, { call: [<.ink.copy, which] }]
            - return: { call: [<.ink.recognizer.path_length, <.ink.scratch, count] }

      # ── reading the ink (spec §7.5a) ────────────────────────────────────────
      # Four rules, first match wins.  The group is the unit: a dotted line, a
      # subroutine and a cylinder are each DRAWN with the pen lifted in between, and
      # reading stroke by stroke cannot see them at all.
      - def:
          name: read_ink
          static_off: ["same_arg", "str_cmp"]
          args: [[slide, ref<Sheet>]]
          return: i32
          body:
            - decl: [total, i32, <.ink.starts.len]
            - if: { condition: { eq: [total, 0] }, then: [{ return: 0 }] }
            - decl: [shape, Guess]
            - decl: [closed_count, i32, 0]
            - decl: [first_closed, i32, -1]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, total] }
                body:
                  - decl: [count, i32, { call: [<.ink.copy, idx] }]
                  - if:
                      condition: { eq: [{ call: [<.ink.recognizer.guess, <.ink.scratch, count, shape] }, 1] }
                      then:
                        - set: [closed_count, { +: [closed_count, 1] }]
                        - if: { condition: { lt: [first_closed, 0] }, then: [{ set: [first_closed, idx] }] }
                  - set: [idx, { +: [idx, 1] }]

            # Rule 3: nothing closed -- one connector along the whole ink.
            - if:
                condition: { eq: [closed_count, 0] }
                then:
                  - decl: [ends, Guess]
                  - call: [<.group_ends, ends]
                  # Which is it: dashes, or a line with heads drawn on it? A head is a
                  # SHORT stroke beside a long one. Counting strokes cannot tell the
                  # two apart, and a double arrow is three strokes just like a dotted
                  # line is.
                  - decl: [longest, f32, 0.0]
                  - decl: [sum_span, f32, 0.0]
                  - decl: [line_at, i32, 0]
                  - set: [idx, 0]
                  - while:
                      condition: { lt: [idx, total] }
                      body:
                        - decl: [one, f32, { call: [<.stroke_span, idx] }]
                        - set: [sum_span, { +: [sum_span, one] }]
                        - if:
                            condition: { gt: [one, longest] }
                            then: [{ set: [longest, one] }, { set: [line_at, idx] }]
                        - set: [idx, { +: [idx, 1] }]
                  - decl: [line_n, i32, { call: [<.ink.copy, line_at] }]
                  - call: [<.ink.recognizer.stroke_end, <.ink.scratch, line_n, shape]
                  - decl: [kind, i32, EdgeKind.open]
                  - decl: [word, string, "Linie"]
                  - if:
                      condition: { "&&": [{ gt: [total, 1] }, { lt: [longest, { "*": [sum_span, 0.40] }] }] }
                      then:
                        # every stroke a similar fraction of the whole: dashes
                        - set: [kind, EdgeKind.dotted]
                        - set: [word, "gepunktete Linie"]
                      else:
                        # one long stroke carries the line; a short stroke whose middle
                        # sits near an end is the head drawn there
                        - decl: [head_at_end, i32, shape.has_head]
                        - decl: [head_at_start, i32, shape.has_tail]
                        - set: [idx, 0]
                        - while:
                            condition: { lt: [idx, total] }
                            body:
                              - if:
                                  condition: { neq: [idx, line_at] }
                                  then:
                                    - decl: [mark, Guess]
                                    - decl: [mark_n, i32, { call: [<.ink.copy, idx] }]
                                    - decl: [skip, i32, { call: [<.ink.recognizer.guess, <.ink.scratch, mark_n, mark] }]
                                    - decl: [mid_x, f32, { +: [mark.pos_x, { /: [mark.width, 2.0] }] }]
                                    - decl: [mid_y, f32, { +: [mark.pos_y, { /: [mark.height, 2.0] }] }]
                                    - decl: [to_start, f32, { call: [math.sqrt, { +: [{ "*": [{ -: [mid_x, ends.pos_x] }, { -: [mid_x, ends.pos_x] }] }, { "*": [{ -: [mid_y, ends.pos_y] }, { -: [mid_y, ends.pos_y] }] }] }] }]
                                    - decl: [to_end, f32, { call: [math.sqrt, { +: [{ "*": [{ -: [mid_x, ends.tip_x] }, { -: [mid_x, ends.tip_x] }] }, { "*": [{ -: [mid_y, ends.tip_y] }, { -: [mid_y, ends.tip_y] }] }] }] }]
                                    - if: { condition: { lt: [to_start, 70.0] }, then: [{ set: [head_at_start, 1] }] }
                                    - if: { condition: { lt: [to_end, 70.0] }, then: [{ set: [head_at_end, 1] }] }
                              - set: [idx, { +: [idx, 1] }]
                        - if:
                            condition: { "&&": [{ eq: [head_at_end, 1] }, { eq: [head_at_start, 1] }] }
                            then: [{ set: [kind, EdgeKind.bidirectional] }, { set: [word, "Doppelpfeil"] }]
                            else:
                              - if:
                                  condition: { "||": [{ eq: [head_at_end, 1] }, { eq: [head_at_start, 1] }] }
                                  then: [{ set: [kind, EdgeKind.arrow] }, { set: [word, "Pfeil"] }]
                        - set: [shape.has_head, head_at_end]
                        - set: [shape.has_tail, head_at_start]
                  # 40 units, not 12: a line is begun beside a shape, not on it
                  - decl: [src, string, { call: [<.node_near, slide, ends.pos_x, ends.pos_y, 40.0] }]
                  - decl: [dst, string, { call: [<.node_near, slide, ends.tip_x, ends.tip_y, 40.0] }]
                  - decl: [made_it, i32, { call: [<.make_edge, slide, src, dst, kind] }]
                  - if:
                      condition: { eq: [made_it, 1] }
                      then: [{ set: [<.status, "${word} erkannt"] }]
                      else: [{ set: [<.status, "${word}: kein Knoten an den Enden"] }]
                  - decl: [long_i, i32, { cast: [longest, i32] }]
                  - decl: [sum_i, i32, { cast: [sum_span, i32] }]
                  - decl: [note, string, "${word} von ${src} nach ${dst} laengster=${long_i} summe=${sum_i}"]
                  - call: [<.log_ink, note, shape, total]
                  - return: made_it

            # Rules 1 and 2: one closed outline, the rest read as marks inside it.
            - if:
                condition: { eq: [closed_count, 1] }
                then:
                  - decl: [outline_n, i32, { call: [<.ink.copy, first_closed] }]
                  - decl: [outline_ok, i32, { call: [<.ink.recognizer.guess, <.ink.scratch, outline_n, shape] }]
                  - decl: [uprights, i32, 0]
                  - decl: [flat_top, i32, 0]
                  - set: [idx, 0]
                  - while:
                      condition: { lt: [idx, total] }
                      body:
                        - if:
                            condition: { neq: [idx, first_closed] }
                            then:
                              - decl: [mark, Guess]
                              - decl: [mark_n, i32, { call: [<.ink.copy, idx] }]
                              - decl: [unused, i32, { call: [<.ink.recognizer.guess, <.ink.scratch, mark_n, mark] }]
                              - decl: [mid_x, f32, { +: [mark.pos_x, { /: [mark.width, 2.0] }] }]
                              - decl: [mid_y, f32, { +: [mark.pos_y, { /: [mark.height, 2.0] }] }]
                              - if:
                                  condition: { "&&": [{ ge: [mid_x, shape.pos_x] }, { "&&": [{ le: [mid_x, { +: [shape.pos_x, shape.width] }] }, { "&&": [{ ge: [mid_y, shape.pos_y] }, { le: [mid_y, { +: [shape.pos_y, shape.height] }] }] }] }] }
                                  then:
                                    - if:
                                        condition: { gt: [mark.height, { "*": [mark.width, 1.6] }] }
                                        then: [{ set: [uprights, { +: [uprights, 1] }] }]
                                    - if:
                                        condition: { gt: [mark.width, { "*": [mark.height, 1.6] }] }
                                        then:
                                          - if:
                                              condition: { lt: [mid_y, { +: [shape.pos_y, { /: [shape.height, 4.0] }] }] }
                                              then: [{ set: [flat_top, { +: [flat_top, 1] }] }]
                        - set: [idx, { +: [idx, 1] }]
                  - decl: [word, string, { call: [enums.name, "NodeKind", shape.kind] }]
                  - if:
                      condition: { ge: [uprights, 2] }
                      then: [{ set: [shape.kind, NodeKind.subroutine] }, { set: [word, "Unterprogramm"] }]
                      else:
                        - if:
                            condition: { ge: [flat_top, 1] }
                            then: [{ set: [shape.kind, NodeKind.cylinder] }, { set: [word, "Zylinder"] }]
                  - decl: [made, string, { call: [<.make_node, slide, shape] }]
                  - set: [<.status, "${word} erkannt"]
                  - call: [<.log_ink, word, shape, total]
                  - call: [<.begin_edit, made]
                  - return: 1

            # Rule 4: several outlines -- each stroke on its own.
            - set: [idx, 0]
            - decl: [built, i32, 0]
            - while:
                condition: { lt: [idx, total] }
                body:
                  - decl: [count, i32, { call: [<.ink.copy, idx] }]
                  - if:
                      condition: { eq: [{ call: [<.ink.recognizer.guess, <.ink.scratch, count, shape] }, 1] }
                      then:
                        - decl: [ignored, string, { call: [<.make_node, slide, shape] }]
                        - set: [built, { +: [built, 1] }]
                  - set: [idx, { +: [idx, 1] }]
            - set: [<.status, "${built} Formen erkannt"]
            - call: [<.log_ink, "${built} Formen (Regel 4)", shape, total]
            - return: built

      - def:
          name: make_node
          static_off: ["same_arg", "str_cmp"]
          args: [[slide, ref<Sheet>], [shape, ref<Guess>]]
          return: string
          body:
            - decl: [fresh, Node]
            - set: [fresh.ident, "n${slide.next_id}"]
            - set: [fresh.kind, shape.kind]
            - set: [fresh.pos_x, shape.pos_x]
            - set: [fresh.pos_y, shape.pos_y]
            - set: [fresh.width, shape.width]
            - set: [fresh.height, shape.height]
            - call: [slide.nodes.push, fresh]
            - set: [slide.next_id, { +: [slide.next_id, 1] }]
            - return: fresh.ident

      - def:
          name: make_edge
          static_off: ["same_arg", "str_cmp"]
          args: [[slide, ref<Sheet>], [src, string], [dst, string], [kind, i32]]
          return: i32
          body:
            - if: { condition: { eq: [src, ""] }, then: [{ return: 0 }] }
            - if: { condition: { eq: [dst, ""] }, then: [{ return: 0 }] }
            - if: { condition: { eq: [src, dst] }, then: [{ return: 0 }] }
            - decl: [edge, Edge]
            - set: [edge.ident, "e${slide.next_id}"]
            - set: [edge.from_id, src]
            - set: [edge.to_id, dst]
            - set: [edge.kind, kind]
            - call: [slide.edges.push, edge]
            - set: [slide.next_id, { +: [slide.next_id, 1] }]
            - return: 1

      # ── keyboard: ONE consumer (spec §6, normative) ────────────────────────
      # Everything comes from the event queue. A key read both as an event and as a
      # poll fires twice, and the symptom is a Backspace that eats two characters.
      - def:
          name: handle_events
          static_off: ["same_arg", "str_cmp"]
          body:
            - while:
                condition: { call: [input.has_event] }
                body:
                  - decl: [evt, input_event, { call: [input.next_event] }]
                  - if:
                      condition: { eq: [<.editing, 1] }
                      then:
                        - if:
                            condition: { eq: [evt.type, "text"] }
                            then: [{ set: [<.edit_text, "${<.edit_text}${evt.char_}"] }]
                        - if:
                            condition: { eq: [evt.type, "key_down"] }
                            then:
                              - if:
                                  condition: { eq: [evt.key, "Backspace"] }
                                  then:
                                    - if:
                                        condition: { gt: [<.edit_text.len, 0] }
                                        then: [{ set: [<.edit_text, { call: [<.edit_text.substr, 0, { -: [<.edit_text.len, 1] }] }] }]
                              - if:
                                  condition: { eq: [evt.key, "Enter"] }
                                  then: [{ call: [<.commit_label] }]
                              - if:
                                  condition: { eq: [evt.key, "Escape"] }
                                  then:
                                    - set: [<.editing, 0]
                                    - set: [<.edit_id, ""]
                                    - set: [<.status, "verworfen"]
                      else:
                        - if:
                            condition: { eq: [evt.type, "key_down"] }
                            then: [{ call: [<.nav_key, evt.key] }]

      - def:
          name: nav_key
          static_off: ["same_arg", "str_cmp"]
          args: [[key, string]]
          body:
            - if: { condition: { eq: [key, "F5"] }, then: [{ set: [<.presenting, 1] }, { set: [<.sel, ""] }, { return: null }] }
            - if: { condition: { eq: [key, "Escape"] }, then: [{ set: [<.presenting, 0] }, { return: null }] }
            - decl: [forward, i32, 0]
            - if: { condition: { eq: [key, "Right"] }, then: [{ set: [forward, 1] }] }
            - if: { condition: { eq: [key, "Space"] }, then: [{ set: [forward, 1] }] }
            - if: { condition: { eq: [key, "PageDown"] }, then: [{ set: [forward, 1] }] }
            - if:
                condition: { eq: [forward, 1] }
                then:
                  - if:
                      condition: { lt: [<.deck.current, { -: [<.deck.slides.len, 1] }] }
                      then: [{ set: [<.deck.current, { +: [<.deck.current, 1] }] }, { call: [<.clear_selection] }]
                  - return: null
            - decl: [back, i32, 0]
            - if: { condition: { eq: [key, "Left"] }, then: [{ set: [back, 1] }] }
            - if: { condition: { eq: [key, "PageUp"] }, then: [{ set: [back, 1] }] }
            - if:
                condition: { eq: [back, 1] }
                then:
                  - if:
                      condition: { gt: [<.deck.current, 0] }
                      then: [{ set: [<.deck.current, { -: [<.deck.current, 1] }] }, { call: [<.clear_selection] }]
                  - return: null
            - if: { condition: { eq: [key, "Home"] }, then: [{ set: [<.deck.current, 0] }, { call: [<.clear_selection] }, { return: null }] }
            - if: { condition: { eq: [key, "End"] }, then: [{ set: [<.deck.current, { -: [<.deck.slides.len, 1] }] }, { call: [<.clear_selection] }, { return: null }] }
            - if: { condition: { eq: [key, "N"] }, then: [{ set: [<.show_notes, { -: [1, <.show_notes] }] }, { return: null }] }
            - if: { condition: { eq: [key, "Delete"] }, then: [{ call: [<.dispatch, 20] }, { return: null }] }
            # Enter opens the selected node for editing (spec §6)
            - if:
                condition: { eq: [key, "Enter"] }
                then:
                  - if: { condition: { neq: [<.sel, ""] }, then: [{ call: [<.begin_edit, <.sel] }] }

      - def:
          name: clear_selection
          body:
            - set: [<.sel, ""]
            - set: [<.sel_edge, ""]
            - set: [<.editing, 0]
            - set: [<.edit_id, ""]

      - def:
          name: begin_edit
          static_off: ["same_arg", "str_cmp"]
          args: [[ident, string]]
          body:
            - if: { condition: { eq: [<.deck.slides.len, 0] }, then: [{ return: null }] }
            - decl: [slide, ref<Sheet>, { at: [<.deck.slides, <.deck.current] }]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, slide.nodes.len] }
                body:
                  - decl: [node, ref<Node>, { at: [slide.nodes, idx] }]
                  - if:
                      condition: { eq: [node.ident, ident] }
                      then:
                        - set: [<.editing, 1]
                        - set: [<.edit_id, ident]
                        - set: [<.edit_text, node.text]
                        - set: [<.sel, ident]
                        - set: [<.status, "tippen, Enter uebernimmt"]
                        - return: null
                  - set: [idx, { +: [idx, 1] }]

      # Commit and grow the box to the text: measured, never estimated (spec §6).
      - def:
          name: commit_label
          static_off: ["same_arg", "str_cmp"]
          body:
            - set: [<.editing, 0]
            - if: { condition: { eq: [<.edit_id, ""] }, then: [{ return: null }] }
            - decl: [slide, ref<Sheet>, { at: [<.deck.slides, <.deck.current] }]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, slide.nodes.len] }
                body:
                  - decl: [node, ref<Node>, { at: [slide.nodes, idx] }]
                  - if:
                      condition: { eq: [node.ident, <.edit_id] }
                      then:
                        - set: [node.text, <.edit_text]
                        - if:
                            condition: { gt: [<.last_scale, 0.0] }
                            then:
                              - decl: [lines, list<string>, { call: [<.edit_text.split, "\n"] }]
                              - decl: [widest, f32, 0.0]
                              - decl: [line_i, i32, 0]
                              - while:
                                  condition: { lt: [line_i, lines.len] }
                                  body:
                                    - decl: [line, string, { at: [lines, line_i] }]
                                    - decl: [line_w, f32, { call: [ui.measure_text, line] }]
                                    - if: { condition: { gt: [line_w, widest] }, then: [{ set: [widest, line_w] }] }
                                    - set: [line_i, { +: [line_i, 1] }]
                              - decl: [want, f32, { +: [{ /: [widest, <.last_scale] }, 48.0] }]
                              - if: { condition: { gt: [want, node.width] }, then: [{ set: [node.width, want] }] }
                        - set: [<.edit_id, ""]
                        - set: [<.status, "uebernommen"]
                        - return: null
                  - set: [idx, { +: [idx, 1] }]
            - set: [<.edit_id, ""]

      # ── images ──────────────────────────────────────────────────────────────
      # Loaded once per distinct path when the deck is opened: a texture per frame
      # would re-upload every picture 60 times a second.
      - def:
          name: load_images
          static_off: ["same_arg", "str_cmp"]
          body:
            - decl: [sidx, i32, 0]
            - while:
                condition: { lt: [sidx, <.deck.slides.len] }
                body:
                  - decl: [slide, ref<Sheet>, { at: [<.deck.slides, sidx] }]
                  - decl: [nidx, i32, 0]
                  - while:
                      condition: { lt: [nidx, slide.nodes.len] }
                      body:
                        - decl: [node, ref<Node>, { at: [slide.nodes, nidx] }]
                        - if:
                            condition: { eq: [node.kind, NodeKind.image] }
                            then:
                              - if:
                                  condition: { neq: [node.src, ""] }
                                  then:
                                    - if:
                                        condition: { eq: [{ call: [<.textures.contains, node.src] }, 0] }
                                        then:
                                          - decl: [tex, gl_texture, { call: [gl.load_texture, node.src] }]
                                          - if:
                                              condition: { neq: [tex, null] }
                                              then: [{ call: [<.textures.put, node.src, tex] }]
                                              else: [{ call: [log.error, "chart: ${node.src}: cannot load image"] }]
                        - set: [nidx, { +: [nidx, 1] }]
                  - set: [sidx, { +: [sidx, 1] }]

      # ── the loop ────────────────────────────────────────────────────────────
      - def:
          name: run
          static_off: ["same_arg", "str_cmp"]
          args: [[path, string], [frame_limit, i32], [shot_path, string], [opts, ref<ChartOptions>]]
          return: i32
          body:
            - set: [<.deck_path, path]
            - set: [<.armed, -1]
            - set: [<.sel, ""]
            - set: [<.drag_id, ""]
            - set: [<.presenting, 0]
            - set: [<.show_notes, 0]
            - set: [<.status, "bereit"]
            - if:
                condition: { eq: [{ call: [<.sheet_io.load, path, <.deck] }, 0] }
                then: [{ return: 1 }]
            - call: [<.ink.setup]
            - set: [<.diag_on, opts.diag]
            - set: [<.settle, { /: [{ cast: [opts.settle, f64] }, 1000.0] }]
            - set: [<.presenting, opts.present]
            - set: [<.show_notes, opts.notes]
            - set: [<.deck.current, { -: [opts.start, 1] }]
            - if: { condition: { lt: [<.deck.current, 0] }, then: [{ set: [<.deck.current, 0] }] }
            - if: { condition: { ge: [<.deck.current, <.deck.slides.len] }, then: [{ set: [<.deck.current, { -: [<.deck.slides.len, 1] }] }] }
            - decl: [win, window_handle, { call: [engine.create_window, 1400, 880, "chart"] }]
            - if:
                condition: { eq: [win, null] }
                then:
                  - call: [log.error, "chart: cannot open a window"]
                  - return: 1
            - call: [gl.init]
            - call: [ui.init]
            # Registers the GLFW callbacks. Without it every input call is a no-op
            # (aiml spec/44_0 §2): the window draws and nothing reacts.
            - call: [input.init, win]
            - decl: [font, ui_font, { call: [ui.load_font_default, 15.0] }]
            - if:
                condition: { peq: [font, null] }
                then:
                  - call: [log.error, "chart: no font"]
                  - return: 1
            - call: [ui.set_default_font, font]
            - call: [<.load_images]

            - decl: [cols_edit, buffer<f32>, [0.18, 0.82]]
            - decl: [cols_show, buffer<f32>, [1.0]]
            - decl: [rows, buffer<f32>, [1.0]]

            - decl: [frame, i32, 0]
            - while:
                condition: { call: [engine.running, win] }
                body:
                  - set: [frame, { +: [frame, 1] }]
                  - call: [gl.clear_all, 0.09, 0.11, 0.14, 1.0]
                  - decl: [isize, ivec2, { call: [engine.window_size, win] }]
                  - decl: [fsize, vec2, { call: [math.ivec2_to_vec2, isize] }]
                  - decl: [win_w, f32, fsize.x]
                  - decl: [win_h, f32, fsize.y]
                  - call: [ui.begin, win]
                  - call: [ui.set_gap, 0.0, 0.0]
                  - call: [<.handle_events]
                  - if:
                      condition: { eq: [<.presenting, 1] }
                      then:
                        - call: [ui.begin_grid, cols_show, rows]
                        - call: [ui.begin_cell, 0, 0, 1, 1]
                        - call: [<.draw_slide, 0.0, 0.0, win_w, win_h, 0.98]
                        - call: [ui.end_cell]
                        - call: [ui.end_grid]
                      else:
                        - call: [ui.begin_grid, cols_edit, rows]
                        - decl: [action, i32, { call: [<.bar] }]
                        - set: [<.last_action, action]
                        # DIAGNOSE: eine Leisten-Aktion wird eigenstaendig vermerkt,
                        # unabhaengig von der Maus-Flanke -- sonst haengt der Beweis,
                        # dass ein Knopf feuert, an der Protokollstelle daneben.
                        - if:
                            condition: { "&&": [{ neq: [action, 0] }, { neq: [<.diag_on, 0] }] }
                            then:
                              - set: [<.diag, "${<.diag}LEISTE aktion=${action} hover=${<.bar_hov}\n"]
                              - call: [<.exporter.write_file, "diag.log", <.diag]
                        - call: [ui.begin_cell, 1, 0, 1, 1]
                        - decl: [cvs_x, f32, { "*": [win_w, 0.18] }]
                        - decl: [cvs_w, f32, { "*": [win_w, 0.82] }]
                        - call: [<.draw_slide, cvs_x, 0.0, cvs_w, win_h, 0.88]
                        - call: [<.canvas_input, cvs_x, 0.0, cvs_w, win_h, 0.88]
                        - call: [ui.end_cell]
                        - call: [ui.end_grid]
                        - call: [<.dispatch, action]
                  - call: [ui.end]
                  # The capture happens BEFORE the swap: after it the back buffer is
                  # undefined, and a screenshot of an undefined buffer is noise that
                  # looks like a rendering bug.
                  - if:
                      condition: { gt: [frame_limit, 0] }
                      then:
                        - if:
                            condition: { ge: [frame, frame_limit] }
                            then:
                              - if:
                                  condition: { neq: [shot_path, ""] }
                                  then: [{ call: [<.capture, shot_path, isize.x, isize.y] }]
                              - call: [engine.swap, win]
                              - return: 0
                  - call: [engine.swap, win]
            - return: 0

      # The final frame as a PNG (same path glbview uses: read_rgba8 + encode_png).
      - def:
          name: capture
          static_off: ["same_arg", "str_cmp"]
          args: [[file_path, string], [width, i32], [height, i32]]
          body:
            - decl: [pixels, buffer<u8>, { call: [gl.read_rgba8, 0, 0, width, height] }]
            - decl: [png, buffer]
            - call: [png.alloc, { +: [{ "*": [{ "*": [width, height] }, 5] }, 1024] }]
            - decl: [written, i32, { call: [png.encode_png, pixels, width, height] }]
            - if:
                condition: { le: [written, 0] }
                then:
                  - call: [log.error, "chart: ${file_path}: cannot encode the capture"]
                  - return: null
            - decl: [out_file, file_handle, { call: [io.open, file_path, "wb"] }]
            - if:
                condition: { eq: [out_file, null] }
                then:
                  - call: [log.error, "chart: ${file_path}: cannot write the capture"]
                  - return: null
            - decl: [stored, i32, { call: [png.write_to, out_file] }]
            - call: [io.close, out_file]
            - if:
                condition: { le: [stored, 0] }
                then: [{ call: [log.error, "chart: ${file_path}: short write on the capture"] }]

- classgroup:
    name: ChartRuntime
    instances:
      - class: SheetIO
        instance: sheet_io
      - class: MermaidOut
        instance: mermaid
      - class: MarkdownOut
        instance: markdown
      - class: Exporter
        instance: exporter
        sees: [sheet_io, mermaid, markdown]
      - class: Recognizer
        instance: recognizer
      - class: Ink
        instance: ink
        sees: [recognizer]
      - class: Pen
        instance: pen
      - class: Grip
        instance: grip
      - class: Editor
        instance: editor
        sees: [sheet_io, mermaid, markdown, exporter, ink, pen, grip]
