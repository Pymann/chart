# The editor surface (doc/spec/chart.md §15) and presentation mode (§14).
#
# A slide is a fixed 1280x720 page, scaled to fit and centred -- never re-laid-out
# (§14, normative): positions belong to the author, and a presentation that moved
# things to fit would show something the author never saw.
- import: "src/runtime.aiml"
- import: "src/ink.aiml"
- import: "src/pen.aiml"
- import: "src/grip.aiml"
- import: "src/files.aiml"
- import: "src/reader.aiml"
- import: "src/menu.aiml"
- import: "src/label.aiml"
- import: "src/clip.aiml"
- import: "src/script.aiml"
- import: "src/node_art.aiml"
- import: "src/topbar.aiml"
- import: "src/toolbar.aiml"
- import: "src/seq_art.aiml"
- import: "src/edge_art.aiml"

- class:
    name: Editor
    description: "Window, strips, canvas, presentation mode (spec §8.0)"
    members:
      - [sheet_io, ref<SheetIO>]        # borrow, wired dst_cy the classgroup
      - [mermaid, ref<MermaidOut>]
      - [markdown, ref<MarkdownOut>]
      - [exporter, ref<Exporter>]
      - [ink, ref<Ink>]
      - [pen, ref<Pen>]
      - [grip, ref<Grip>]
      - [files, ref<Files>]
      - [menu, ref<Menu>]
      - [dirty, i32]                   # unsaved changes (spec §16.2)
      - [deck, Deck]
      - [deck_path, string]
      - [armed, i32]                    # NodeKind to place on the next canvas click, -1 = none
      - [sel, string]                   # selected node ident, "" = nothing
      - [drag_id, string]               # node being dragged
      - [drag_dx, f32]
      - [drag_dy, f32]
      - [presenting, i32]
      - [show_notes, i32]
      - [status, string]
      - [editing, i32]                  # 1 while a label is being edited (spec §6)
      - [label, ref<LabelEdit>]        # caret, selection, clipboard (spec §6)
      - [clip, ref<Clip>]              # copy/cut/paste of an element
      - [script, ref<Script>]          # --script: input steps, one per frame
      - [edit_id, string]              # "#titel" edits the slide heading
      - [link_from, string]             # source node while an edge is being dragged
      - [sel_edge, string]
      - [sel_step, string]              # selected step of a sequence (spec §5.8.3)
      - [last_scale, f32]               # slide scale of the last frame, for auto-grow
      - [diag, ref<Diag>]               # --diag 1: the shared log
      - [reader, ref<Reader>]           # turns ink into sheet elements (spec §7)
      - [settle, f64]                   # seconds the ink waits (spec §7.5a)
      - [read_at, i32]                  # ink size when it was last read
      - [last_action, i32]              # DIAGNOSE: was die Leiste zurueckgab
      - [art, ref<NodeArt>]            # draws one node (spec §15.2)
      - [edge_art, ref<EdgeArt>]       # draws the connectors (spec §5.3)
      - [seq, ref<SeqLayout>]          # derived geometry of a sequence (spec §5.8.3)
      - [seq_art, ref<SeqArt>]         # lifelines, messages, notes, blocks
      - [top_bar, ref<TopBar>]         # the menu strip (spec §8.0)
      - [tools, ref<ToolBar>]          # the tool strip
    methods:
      # ── geometry ────────────────────────────────────────────────────────────
      # Scale that fits the 1280x720 page into the canvas rect, with a margin.
      - def:
          name: fit_scale
          args: [[avail_w, f32], [avail_h, f32], [margin, f32]]
          return: f32
          body:
            - decl: [scale_x, f32, { /: [{ "*": [avail_w, margin] }, 1280.0] }]
            - decl: [scale_y, f32, { /: [{ "*": [avail_h, margin] }, 720.0] }]
            - if: { condition: { lt: [scale_x, scale_y] }, then: [{ return: scale_x }] }
            - return: scale_y

      # ── the page ────────────────────────────────────────────────────────────
      - def:
          name: draw_slide
          static_off: ["same_arg", "str_cmp"]
          args: [[cvs_x, f32], [cvs_y, f32], [cvs_w, f32], [cvs_h, f32], [margin, f32]]
          body:
            - if: { condition: { eq: [<.deck.slides.len, 0] }, then: [{ return: null }] }
            - if: { condition: { lt: [<.deck.current, 0] }, then: [{ set: [<.deck.current, 0] }] }
            - if: { condition: { ge: [<.deck.current, <.deck.slides.len] }, then: [{ set: [<.deck.current, { -: [<.deck.slides.len, 1] }] }] }
            - decl: [slide, ref<Sheet>, { at: [<.deck.slides, <.deck.current] }]
            - decl: [scale, f32, { call: [<.fit_scale, cvs_w, cvs_h, margin] }]
            - set: [<.last_scale, scale]
            - decl: [page_w, f32, { "*": [1280.0, scale] }]
            - decl: [page_h, f32, { "*": [720.0, scale] }]
            - decl: [org_x, f32, { +: [cvs_x, { /: [{ -: [cvs_w, page_w] }, 2.0] }] }]
            - decl: [org_y, f32, { +: [cvs_y, { /: [{ -: [cvs_h, page_h] }, 2.0] }] }]
            # a soft shadow, so the page reads as a sheet of paper
            - call: [ui.draw_rect, { +: [org_x, 6.0] }, { +: [org_y, 7.0] }, page_w, page_h, 0x0A0F1438]
            - call: [ui.draw_rect, org_x, org_y, page_w, page_h, 0xFFFFFFFF]
            - decl: [page, Shape]
            - set: [page.pos_x, org_x]
            - set: [page.pos_y, org_y]
            - set: [page.width, page_w]
            - set: [page.height, page_h]
            - set: [page.tint, 0xC2CCD6FF]
            - set: [page.thick, 1.0]
            - call: [<.pen.frame, page]
            - decl: [head_live, i32, 0]
            - if:
                condition: { "&&": [{ eq: [<.editing, 1] }, { eq: [<.edit_id, "#titel"] }] }
                then: [{ set: [head_live, 1] }]
            - if:
                condition: { "&&": [{ neq: [slide.title, ""] }, { eq: [head_live, 0] }] }
                then:
                  - call: [ui.draw_text, { +: [org_x, { "*": [52.0, scale] }] }, { +: [org_y, { "*": [30.0, scale] }] }, slide.title, 0x101A24FF]
            - if:
                condition: { eq: [head_live, 1] }
                then:
                  - decl: [head_box, Shape]
                  - call: [<.label.title_box, org_x, org_y, scale, head_box]
                  - call: [<.label.draw_in, head_box]
                  - call: [ui.draw_line, { +: [org_x, { "*": [52.0, scale] }] }, { +: [org_y, { "*": [62.0, scale] }] }, { -: [{ +: [org_x, page_w] }, { "*": [52.0, scale] }] }, { +: [org_y, { "*": [62.0, scale] }] }, 1.0, 0xD8DEE6FF]
            # A sequence is laid out, not placed (spec §5.8.3): the derived geometry
            # goes INTO the nodes first, so hit testing, dragging and the label
            # editor keep working on ordinary rectangles.
            - decl: [is_seq, i32, 0]
            - if: { condition: { eq: [slide.dtype, DiagramType.sequence] }, then: [{ set: [is_seq, 1] }] }
            - if:
                condition: { eq: [is_seq, 1] }
                then:
                  - call: [<.seq.apply, slide]
                  - call: [<.seq_art.draw, slide, org_x, org_y, scale, <.sel_step]
                else: [{ call: [<.edge_art.draw_edges, slide, org_x, org_y, scale, <.sel_edge] }]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, slide.nodes.len] }
                body:
                  - decl: [node, ref<Node>, { at: [slide.nodes, idx] }]
                  - call: [<.art.draw_node, node, org_x, org_y, scale]
                  - if:
                      condition: { eq: [node.ident, <.sel] }
                      then:
                        - if:
                            condition: { eq: [<.presenting, 0] }
                            then:
                              - decl: [halo, Shape]
                              - set: [halo.pos_x, { -: [{ +: [org_x, { "*": [node.pos_x, scale] }] }, 5.0] }]
                              - set: [halo.pos_y, { -: [{ +: [org_y, { "*": [node.pos_y, scale] }] }, 5.0] }]
                              - set: [halo.width, { +: [{ "*": [node.width, scale] }, 10.0] }]
                              - set: [halo.height, { +: [{ "*": [node.height, scale] }, 10.0] }]
                              - set: [halo.tint, 0x2F80EDFF]
                              - set: [halo.thick, 2.0]
                              - call: [<.pen.frame, halo]
                  - set: [idx, { +: [idx, 1] }]
            # the ink: every stroke of the group, until it is read (spec §7.5a)
            - if:
                condition: { gt: [<.ink.count, 1] }
                then:
                  - decl: [sidx, i32, 0]
                  - while:
                      condition: { lt: [sidx, <.ink.starts.len] }
                      body:
                        - decl: [begin, i32, { call: [<.ink.at_from, sidx] }]
                        - decl: [count, i32, { call: [<.ink.at_len, sidx] }]
                        - if:
                            condition: { gt: [count, 1] }
                            then:
                              - decl: [ink, buffer<f32>]
                              - call: [ink.alloc, 16384]
                              - decl: [pidx, i32, 0]
                              - while:
                                  condition: { lt: [pidx, count] }
                                  body:
                                    - call: [<.ink.points.seek, { "*": [{ +: [begin, pidx] }, 8] }]
                                    - decl: [raw_x, f32, { call: [<.ink.points.read, f32] }]
                                    - decl: [raw_y, f32, { call: [<.ink.points.read, f32] }]
                                    - call: [ink.write, { +: [org_x, { "*": [raw_x, scale] }] }, f32]
                                    - call: [ink.write, { +: [org_y, { "*": [raw_y, scale] }] }, f32]
                                    - set: [pidx, { +: [pidx, 1] }]
                              - call: [ui.draw_polyline, ink, 2.5, 0x2F80EDFF]
                        - set: [sidx, { +: [sidx, 1] }]

            # What will be connected, before the button is let go (spec §15.1).
            - if:
                condition: { neq: [<.link_from, ""] }
                then:
                  - decl: [src_node, Node]
                  - if:
                      condition: { eq: [{ call: [<.grip.node_by_id, slide, <.link_from, src_node] }, 1] }
                      then:
                        - call: [ui.draw_line,
                                 { +: [org_x, { "*": [{ +: [src_node.pos_x, { /: [src_node.width, 2.0] }] }, scale] }] },
                                 { +: [org_y, { "*": [{ +: [src_node.pos_y, { /: [src_node.height, 2.0] }] }, scale] }] },
                                 { call: [input.mouse_pos_x] }, { call: [input.mouse_pos_y] }, 2.0, 0x2F80EDC0]

            - if:
                condition: { eq: [<.presenting, 1] }
                then:
                  - decl: [number, i32, { +: [<.deck.current, 1] }]
                  - call: [ui.draw_text, { -: [{ +: [cvs_x, cvs_w] }, 70.0] }, { -: [{ +: [cvs_y, cvs_h] }, 26.0] }, "${number} / ${<.deck.slides.len}", 0x8A97A5FF]
                  - if:
                      condition: { eq: [<.show_notes, 1] }
                      then:
                        - if:
                            condition: { neq: [slide.notes, ""] }
                            then:
                              - call: [ui.draw_rect, cvs_x, { -: [{ +: [cvs_y, cvs_h] }, 58.0] }, cvs_w, 58.0, 0x0A0F14D8]
                              - call: [ui.draw_text, { +: [cvs_x, 18.0] }, { -: [{ +: [cvs_y, cvs_h] }, 42.0] }, slide.notes, 0xF0E8D0FF]

      # ── the status strip (spec §8.0) ────────────────────────────────────────
      # Drawn, not built from widgets, and it claims no input: a report of state
      # that swallows a click would be lying about what it is.
      - def:
          name: status_strip
          static_off: ["same_arg", "str_cmp"]
          args: [[win_w, f32], [win_h, f32]]
          body:
            - decl: [tall, f32, { call: [<.strip_bottom] }]
            - decl: [top, f32, { -: [win_h, tall] }]
            - call: [ui.draw_rect, 0.0, top, win_w, tall, 0x182430FF]
            - call: [ui.draw_rect, 0.0, top, win_w, 1.0, 0x2A3744FF]
            - call: [ui.draw_text, 12.0, { +: [top, 4.0] }, <.status, 0xA8B6C4FF]
            - decl: [where, string, ""]
            - if:
                condition: { gt: [<.deck.slides.len, 0] }
                then:
                  - decl: [number, i32, { +: [<.deck.current, 1] }]
                  - set: [where, "Folie ${number}/${<.deck.slides.len}"]
            - if: { condition: { eq: [<.dirty, 1] }, then: [{ set: [where, "${where}  *"] }] }
            - decl: [wide, f32, { call: [ui.measure_text, where] }]
            - call: [ui.draw_text, { -: [win_w, { +: [wide, 14.0] }] }, { +: [top, 4.0] }, where, 0xA8B6C4FF]

      - def:
          name: strip_bottom
          return: f32
          body:
            - return: 24.0

      # The menu strip asks the deck what it should offer (spec §8.0): the slide
      # list under `Ansicht`, and `Kante` only while an edge is selected.
      - def:
          name: feed_bar
          static_off: ["same_arg", "str_cmp"]
          body:
            - decl: [edge_on, i32, 0]
            - if: { condition: { neq: [<.sel_edge, ""] }, then: [{ set: [edge_on, 1] }] }
            - set: [<.top_bar.has_edge, edge_on]
            - call: [<.top_bar.clear_slides]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, <.deck.slides.len] }
                body:
                  - decl: [slide, ref<Sheet>, { at: [<.deck.slides, idx] }]
                  - decl: [number, i32, { +: [idx, 1] }]
                  - decl: [mark, string, "  "]
                  - if: { condition: { eq: [idx, <.deck.current] }, then: [{ set: [mark, "> "] }] }
                  - decl: [name, string, slide.title]
                  - if: { condition: { eq: [name, ""] }, then: [{ set: [name, "(ohne Titel)"] }] }
                  - call: [<.top_bar.add_slide, "${mark}${number} ${name}", { +: [40, idx] }]
                  - set: [idx, { +: [idx, 1] }]


      # What a connect gesture MAKES depends on the diagram (spec §5.8.3): in a
      # sequence it is a message at the end of the step list -- the list is the time
      # axis -- and everywhere else an edge.  Its own method because canvas_input may
      # not grow past 300 lines (aiml spec/49 §3).
      - def:
          name: join_two
          static_off: ["same_arg", "str_cmp"]
          args: [[slide, ref<Sheet>], [from_id, string], [to_id, string]]
          body:
            - if:
                condition: { eq: [slide.dtype, DiagramType.sequence] }
                then:
                  - decl: [step, Step]
                  - set: [step.ident, "s${slide.next_id}"]
                  - set: [step.kind, StepKind.message]
                  - set: [step.from_id, from_id]
                  - set: [step.to_id, to_id]
                  - call: [slide.steps.push, step]
                  - call: [<.touch]
                  - set: [slide.next_id, { +: [slide.next_id, 1] }]
                  - set: [<.status, "Nachricht angelegt"]
                  - return: null
            - decl: [edge, Edge]
            - set: [edge.ident, "e${slide.next_id}"]
            - set: [edge.from_id, from_id]
            - set: [edge.to_id, to_id]
            - set: [edge.line, LineStyle.solid]
            - set: [edge.head, EndCap.arrow]
            - call: [slide.edges.push, edge]
            - call: [<.touch]
            - set: [slide.next_id, { +: [slide.next_id, 1] }]
            - set: [<.sel_edge, edge.ident]
            - set: [<.status, "Kante gezogen"]

      # A note or a block, appended to the step list (spec §5.8.3).  A note needs a
      # participant to hang on; a block is a pair, opened and closed at once, so the
      # file is never half a block.
      - def:
          name: add_step
          static_off: ["same_arg", "str_cmp"]
          args: [[action, i32]]
          body:
            - if: { condition: { eq: [<.deck.slides.len, 0] }, then: [{ return: null }] }
            - decl: [slide, ref<Sheet>, { at: [<.deck.slides, <.deck.current] }]
            - if:
                condition: { neq: [slide.dtype, DiagramType.sequence] }
                then:
                  - set: [<.status, "Notiz und Block gibt es nur in einer Sequenz (spec 5.8.3)"]
                  - return: null
            - if:
                condition: { eq: [action, 202] }
                then:
                  - decl: [opener, Step]
                  - set: [opener.ident, "s${slide.next_id}"]
                  - set: [opener.kind, StepKind.block_open]
                  - set: [opener.word, "loop"]
                  - call: [slide.steps.push, opener]
                  - set: [slide.next_id, { +: [slide.next_id, 1] }]
                  - decl: [closer, Step]
                  - set: [closer.ident, "s${slide.next_id}"]
                  - set: [closer.kind, StepKind.block_close]
                  - call: [slide.steps.push, closer]
                  - set: [slide.next_id, { +: [slide.next_id, 1] }]
                  - call: [<.touch]
                  - set: [<.sel_step, opener.ident]
                  - call: [<.edit_step]
                  - return: null
            - decl: [host, string, <.sel]
            - if:
                condition: { eq: [host, ""] }
                then:
                  - if: { condition: { eq: [slide.nodes.len, 0] }, then: [{ set: [<.status, "erst einen Teilnehmer anlegen"] }, { return: null }] }
                  - decl: [first, ref<Node>, { at: [slide.nodes, 0] }]
                  - set: [host, first.ident]
            - decl: [note, Step]
            - set: [note.ident, "s${slide.next_id}"]
            - set: [note.kind, StepKind.note]
            - set: [note.from_id, host]
            - call: [slide.steps.push, note]
            - set: [slide.next_id, { +: [slide.next_id, 1] }]
            - call: [<.touch]
            - set: [<.sel_step, note.ident]
            - call: [<.edit_step]

      - def:
          name: drop_step
          static_off: ["same_arg", "str_cmp"]
          body:
            - decl: [slide, ref<Sheet>, { at: [<.deck.slides, <.deck.current] }]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, slide.steps.len] }
                body:
                  - decl: [step, ref<Step>, { at: [slide.steps, idx] }]
                  - if:
                      condition: { eq: [step.ident, <.sel_step] }
                      then:
                        - call: [slide.steps.remove, idx]
                        - set: [<.sel_step, ""]
                        - call: [<.touch]
                        - set: [<.status, "Schritt entfernt"]
                        - return: null
                  - set: [idx, { +: [idx, 1] }]

      # A step's text is edited with the same editor as a label (§6).  The id is
      # prefixed so commit_label can tell a step from a node without guessing.
      - def:
          name: edit_step
          static_off: ["same_arg", "str_cmp"]
          body:
            - if: { condition: { eq: [<.sel_step, ""] }, then: [{ return: null }] }
            - decl: [slide, ref<Sheet>, { at: [<.deck.slides, <.deck.current] }]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, slide.steps.len] }
                body:
                  - decl: [step, ref<Step>, { at: [slide.steps, idx] }]
                  - if:
                      condition: { eq: [step.ident, <.sel_step] }
                      then:
                        - set: [<.editing, 1]
                        - set: [<.edit_id, "#step:${step.ident}"]
                        - call: [<.label.begin, step.ident, step.text]
                        - set: [<.status, "tippen, Enter uebernimmt"]
                        - return: null
                  - set: [idx, { +: [idx, 1] }]

      # ── dispatch ────────────────────────────────────────────────────────────
      - def:
          name: dispatch
          static_off: ["same_arg", "str_cmp"]
          args: [[action, i32]]
          body:
            - if: { condition: { eq: [action, 0] }, then: [{ return: null }] }

            - if: { condition: { eq: [action, 1] }, then: [{ call: [<.save_deck, ""] }, { return: null }] }
            - if:
                condition: { eq: [action, 61] }
                then:
                  - decl: [where, string, { call: [<.files.ask_save_as] }]
                  - if: { condition: { neq: [where, ""] }, then: [{ call: [<.save_deck, where] }] }
                  - return: null
            - if:
                condition: { eq: [action, 60] }
                then:
                  # dirty first (§16.2): the open dialog's cancel is the third answer
                  - if:
                      condition: { eq: [<.dirty, 1] }
                      then:
                        - if:
                            condition: { eq: [{ call: [<.files.ask_keep, "Die Aenderungen vorher speichern?"] }, 1] }
                            then: [{ call: [<.save_deck, ""] }]
                  - decl: [chosen, string, { call: [<.files.ask_open] }]
                  - if: { condition: { eq: [chosen, ""] }, then: [{ set: [<.status, "abgebrochen"] }, { return: null }] }
                  - if:
                      condition: { eq: [{ call: [<.files.load, <.deck, chosen] }, 1] }
                      then:
                        - set: [<.deck_path, chosen]
                        - set: [<.dirty, 0]
                        - call: [<.clear_selection]
                        - call: [<.ink.clear]
                  - set: [<.status, <.files.status]
                  - return: null
            - decl: [exports, i32, 0]
            - if: { condition: { eq: [action, 2] }, then: [{ set: [exports, 1] }] }
            - if: { condition: { eq: [action, 3] }, then: [{ set: [exports, 1] }] }
            - if: { condition: { eq: [action, 65] }, then: [{ set: [exports, 1] }] }
            - if: { condition: { eq: [action, 66] }, then: [{ set: [exports, 1] }] }
            - if: { condition: { eq: [action, 67] }, then: [{ set: [exports, 1] }] }
            - if:
                condition: { eq: [exports, 1] }
                then:
                  - call: [<.files.export_to, <.deck, action, <.deck_path]
                  - set: [<.status, <.files.status]
                  - return: null
            - if:
                condition: { eq: [action, 68] }
                then:
                  - if: { condition: { eq: [<.sel, ""] }, then: [{ set: [<.status, "erst ein Bild-Element waehlen"] }, { return: null }] }
                  - decl: [picture, string, { call: [<.files.browse.ask, 2, ""] }]
                  - if: { condition: { eq: [picture, ""] }, then: [{ return: null }] }
                  - call: [<.set_image, picture]
                  - return: null

            - if:
                condition: { eq: [action, 27] }
                then:
                  - set: [<.armed, 101]
                  - set: [<.status, "zeichnen -- Form wird erkannt"]
                  - return: null
            - if:
                condition: { eq: [action, 19] }
                then:
                  - set: [<.armed, 100]
                  - set: [<.status, "von Knoten zu Knoten ziehen"]
                  - return: null
            - if:
                condition: { eq: [action, 26] }
                then:
                  - if: { condition: { neq: [<.sel_step, ""] }, then: [{ call: [<.edit_step] }, { return: null }] }
                  - if: { condition: { neq: [<.sel, ""] }, then: [{ call: [<.begin_edit, <.sel] }] }
                  - return: null
            # 201/202: the parts of a sequence that are not nodes (spec §5.8.3)
            - if:
                condition: { "||": [{ eq: [action, 201] }, { eq: [action, 202] }] }
                then:
                  - call: [<.add_step, action]
                  - return: null
            # The selected edge's connector (spec §5.3): line 50..53, head 54..58,
            # tail 80..84.  The tail used to start at 59, where 60 and 61 are open
            # and save-as -- tested earlier, so those two caps were unreachable (§8.1).
            - decl: [edge_deed, i32, 0]
            - if: { condition: { "&&": [{ ge: [action, 50] }, { le: [action, 58] }] }, then: [{ set: [edge_deed, 1] }] }
            - if: { condition: { "&&": [{ ge: [action, 80] }, { le: [action, 84] }] }, then: [{ set: [edge_deed, 1] }] }
            - if:
                condition: { eq: [edge_deed, 1] }
                then:
                  - if: { condition: { eq: [<.sel_edge, ""] }, then: [{ return: null }] }
                  - decl: [slide_k, ref<Sheet>, { at: [<.deck.slides, <.deck.current] }]
                  - decl: [kidx, i32, 0]
                  - while:
                      condition: { lt: [kidx, slide_k.edges.len] }
                      body:
                        - decl: [edge_k, ref<Edge>, { at: [slide_k.edges, kidx] }]
                        - if:
                            condition: { eq: [edge_k.ident, <.sel_edge] }
                            then:
                              - if:
                                  condition: { le: [action, 53] }
                                  then:
                                    - set: [edge_k.line, { -: [action, 50] }]
                                    - set: [<.status, "Linienart gesetzt"]
                                  else:
                                    - if:
                                        condition: { le: [action, 58] }
                                        then:
                                          - set: [edge_k.head, { -: [action, 54] }]
                                          - set: [<.status, "Kopf gesetzt"]
                                        else:
                                          - set: [edge_k.tail, { -: [action, 80] }]
                                          - set: [<.status, "Fuss gesetzt"]
                              - call: [<.touch]
                              - set: [kidx, slide_k.edges.len]
                        - set: [kidx, { +: [kidx, 1] }]
                  - return: null

            # 110+: a shape from the tool strip (§8.0).  Its own range, because
            # 10..18 ends at 18 and 20..30 are already taken.
            - if:
                condition: { ge: [action, 110] }
                then:
                  - set: [<.armed, { -: [action, 110] }]
                  - set: [<.status, "Form gewaehlt -- in die Flaeche klicken"]
                  - return: null
            # 70..73: the diagram type (§8.0).  Only flowchart is projected (§1.1),
            # and the status says so rather than hiding the choice.
            - if:
                condition: { "&&": [{ ge: [action, 70] }, { le: [action, 73] }] }
                then:
                  - if: { condition: { eq: [<.deck.slides.len, 0] }, then: [{ return: null }] }
                  - decl: [slide_d, ref<Sheet>, { at: [<.deck.slides, <.deck.current] }]
                  - set: [slide_d.dtype, { -: [action, 70] }]
                  - call: [<.touch]
                  - if:
                      condition: { eq: [slide_d.dtype, DiagramType.flowchart] }
                      then: [{ set: [<.status, "Flussdiagramm"] }]
                      else: [{ set: [<.status, "nur flowchart wird exportiert (spec 1.1)"] }]
                  - return: null

            # 10..18: arm a stencil.  The next canvas click places it (spec §15.1).
            - if:
                condition: { ge: [action, 10] }
                then:
                  - if:
                      condition: { le: [action, 18] }
                      then:
                        - set: [<.armed, { -: [action, 10] }]
                        - set: [<.status, "Form gewaehlt -- in die Flaeche klicken"]
                        - return: null

            - if:
                condition: { eq: [action, 20] }
                then:
                  - if:
                      condition: { neq: [<.sel_step, ""] }
                      then:
                        - call: [<.drop_step]
                        - return: null
                  - if:
                      condition: { neq: [<.sel_edge, ""] }
                      then:
                        - decl: [slide_e, ref<Sheet>, { at: [<.deck.slides, <.deck.current] }]
                        - decl: [eidx, i32, 0]
                        - while:
                            condition: { lt: [eidx, slide_e.edges.len] }
                            body:
                              - decl: [edge_e, ref<Edge>, { at: [slide_e.edges, eidx] }]
                              - if:
                                  condition: { eq: [edge_e.ident, <.sel_edge] }
                                  then:
                                    - call: [slide_e.edges.remove, eidx]
                                    - set: [<.sel_edge, ""]
                                    - set: [<.status, "Kante entfernt"]
                                    - return: null
                              - set: [eidx, { +: [eidx, 1] }]
                  - if:
                      condition: { neq: [<.sel, ""] }
                      then:
                        - decl: [cur_del, i32, <.deck.current]
                        - decl: [slide_del, ref<Sheet>, { at: [<.deck.slides, cur_del] }]
                        # its edges go with it: a kept edge names an endpoint that is
                        # gone, and §5 would project Mermaid that never declares it.
                        # Backwards, so a removal does not skip the next edge.
                        - decl: [cut, i32, { -: [slide_del.edges.len, 1] }]
                        - while:
                            condition: { ge: [cut, 0] }
                            body:
                              - decl: [edge_c, ref<Edge>, { at: [slide_del.edges, cut] }]
                              - decl: [touches, i32, 0]
                              - if: { condition: { eq: [edge_c.from_id, <.sel] }, then: [{ set: [touches, 1] }] }
                              - if: { condition: { eq: [edge_c.to_id, <.sel] }, then: [{ set: [touches, 1] }] }
                              - if: { condition: { eq: [touches, 1] }, then: [{ call: [slide_del.edges.remove, cut] }] }
                              - set: [cut, { -: [cut, 1] }]
                        - decl: [pos, i32, 0]
                        - while:
                            condition: { lt: [pos, slide_del.nodes.len] }
                            body:
                              - decl: [node, ref<Node>, { at: [slide_del.nodes, pos] }]
                              - if:
                                  condition: { eq: [node.ident, <.sel] }
                                  then:
                                    - call: [slide_del.nodes.remove, pos]
                                    - call: [<.touch]
                                    - set: [<.sel, ""]
                                    - set: [<.status, "entfernt"]
                                    - return: null
                              - set: [pos, { +: [pos, 1] }]
                  - return: null

            - if:
                condition: { eq: [action, 21] }
                then:
                  - if: { condition: { gt: [<.deck.current, 0] }, then: [{ set: [<.deck.current, { -: [<.deck.current, 1] }] }, { set: [<.sel, ""] }] }
                  - return: null
            - if:
                condition: { eq: [action, 22] }
                then:
                  - if: { condition: { lt: [<.deck.current, { -: [<.deck.slides.len, 1] }] }, then: [{ set: [<.deck.current, { +: [<.deck.current, 1] }] }, { set: [<.sel, ""] }] }
                  - return: null
            - if: { condition: { eq: [action, 24] }, then: [{ call: [<.edit_title] }, { return: null }] }
            - if:
                condition: { eq: [action, 23] }
                then:
                  - decl: [fresh, Sheet]
                  - set: [fresh.title, "Neue Folie"]
                  - set: [fresh.next_id, 1]
                  - call: [<.deck.slides.push, fresh]
                  - set: [<.deck.current, { -: [<.deck.slides.len, 1] }]
                  - set: [<.sel, ""]
                  - set: [<.status, "Folie angelegt"]
                  - return: null

            - if:
                condition: { eq: [action, 30] }
                then:
                  - set: [<.presenting, 1]
                  - set: [<.sel, ""]
                  - return: null

            # 40+: pick that slide
            - if:
                condition: { ge: [action, 40] }
                then:
                  - set: [<.deck.current, { -: [action, 40] }]
                  - set: [<.sel, ""]

      # The rect the live label is drawn in: the heading's, or the node's.
      - def:
          name: live_box
          static_off: ["same_arg", "str_cmp"]
          args: [[slide, ref<Sheet>], [org_x, f32], [org_y, f32], [scale, f32], [box, ref<Shape>]]
          return: i32
          body:
            - if:
                condition: { eq: [<.edit_id, "#titel"] }
                then:
                  - call: [<.label.title_box, org_x, org_y, scale, box]
                  - return: 1
            - decl: [spot, i32, 0]
            - while:
                condition: { lt: [spot, slide.nodes.len] }
                body:
                  - decl: [node, ref<Node>, { at: [slide.nodes, spot] }]
                  - if:
                      condition: { eq: [node.ident, <.edit_id] }
                      then:
                        - set: [box.pos_x, { +: [org_x, { "*": [node.pos_x, scale] }] }]
                        - set: [box.pos_y, { +: [org_y, { "*": [node.pos_y, scale] }] }]
                        - set: [box.width, { "*": [node.width, scale] }]
                        - set: [box.height, { "*": [node.height, scale] }]
                        - return: 1
                  - set: [spot, { +: [spot, 1] }]
            - return: 0

      - def:
          name: edit_title
          static_off: ["same_arg", "str_cmp"]
          body:
            - if: { condition: { eq: [<.deck.slides.len, 0] }, then: [{ return: null }] }
            - decl: [slide, ref<Sheet>, { at: [<.deck.slides, <.deck.current] }]
            - set: [<.editing, 1]
            - set: [<.edit_id, "#titel"]
            - set: [<.sel, ""]
            - set: [<.sel_edge, ""]
            - call: [<.label.begin, "#titel", slide.title]
            - set: [<.status, "Ueberschrift: tippen, Enter uebernimmt"]

      - def:
          name: canvas_input
          static_off: ["same_arg", "str_cmp"]
          args: [[cvs_x, f32], [cvs_y, f32], [cvs_w, f32], [cvs_h, f32], [margin, f32]]
          body:
            - if: { condition: { eq: [<.deck.slides.len, 0] }, then: [{ return: null }] }
            - decl: [mouse_x, f32, { call: [input.mouse_pos_x] }]
            - decl: [mouse_y, f32, { call: [input.mouse_pos_y] }]
            - decl: [scale, f32, { call: [<.fit_scale, cvs_w, cvs_h, margin] }]
            - decl: [org_x, f32, { +: [cvs_x, { /: [{ -: [cvs_w, { "*": [1280.0, scale] }] }, 2.0] }] }]
            - decl: [org_y, f32, { +: [cvs_y, { /: [{ -: [cvs_h, { "*": [720.0, scale] }] }, 2.0] }] }]
            - decl: [slide_x, f32, { /: [{ -: [mouse_x, org_x] }, scale] }]
            - decl: [slide_y, f32, { /: [{ -: [mouse_y, org_y] }, scale] }]
            - decl: [slide, ref<Sheet>, { at: [<.deck.slides, <.deck.current] }]
            # §8.0: chrome owns its area.  The canvas cell now spans the whole
            # window, so the canvas has to reject the strips' rows itself --
            # otherwise a press on a button also starts a stroke.
            - decl: [over_canvas, i32, 1]
            - if: { condition: { lt: [mouse_x, cvs_x] }, then: [{ set: [over_canvas, 0] }] }
            - if: { condition: { ge: [mouse_x, { +: [cvs_x, cvs_w] }] }, then: [{ set: [over_canvas, 0] }] }
            - if: { condition: { lt: [mouse_y, cvs_y] }, then: [{ set: [over_canvas, 0] }] }
            - if: { condition: { ge: [mouse_y, { +: [cvs_y, cvs_h] }] }, then: [{ set: [over_canvas, 0] }] }
            # ── the pointer says what a drag from here would do (spec §15.1a) ─
            - if:
                condition: { "||": [{ eq: [over_canvas, 0] }, { eq: [<.presenting, 1] }] }
                then: [{ call: [input.set_cursor, "arrow"] }]
                else: [{ call: [<.grip.point, slide, <.sel, slide_x, slide_y, scale] }]
            # DIAGNOSE: beide Flanken getrennt -- ui.button feuert auf RELEASED,
            # meine bisherige Diagnose hing an PRESSED.
            # The same claim for the strips' dropdowns (§8.0).  They hang OVER the
            # canvas, and the canvas is asked first: without this a click on
            # `Kante > Fuss Pfeil` also landed on empty canvas, which dropped the
            # selection -- so the action arrived with nothing selected and did
            # nothing.  An overlay that draws on top must claim the pointer.
            - if:
                condition: { "||": [{ eq: [<.top_bar.shown, 1] }, { eq: [<.tools.type_open, 1] }] }
                then:
                  - call: [input.set_cursor, "arrow"]
                  - return: null
            # §8.2: while the menu is open it owns the pointer.  An overlay that
            # draws on top but claims nothing lets the click through -- here that
            # would draw a stroke THROUGH the menu.
            - if:
                condition: { eq: [<.menu.shown, 1] }
                then:
                  - if:
                      condition: { call: [input.mouse_pressed, 0] }
                      then:
                        - decl: [took, i32, { call: [<.menu.press, mouse_x, mouse_y] }]
                        - if: { condition: { eq: [took, 1] }, then: [{ call: [<.menu_deed] }] }
                  - return: null
            - decl: [down_now, i32, { call: [input.mouse_pressed, 0] }]
            - decl: [up_now, i32, { call: [input.mouse_released, 0] }]
            - decl: [held, i32, { call: [input.mouse_button, 0] }]
            - if:
                condition: { "||": [{ neq: [down_now, 0] }, { neq: [up_now, 0] }] }
                then:
                  # the mouse state belongs in --diag, not in the status strip:
                  # that strip reports to the author now (§8.0), and "P1 R0 H1"
                  # tells an author nothing
                  - decl: [hit_dbg, string, { call: [<.grip.node_at, slide, slide_x, slide_y] }]
                  # Diag.say checks the flag itself.  A `return` here skipped the whole
                  # press handling whenever --diag was off: the canvas ignored every
                  # click, and every live test had happened to run WITH --diag.
                  - call: [<.diag.say, "P${down_now} R${up_now} H${held} fenster=${ { cast: [mouse_x, i32] } },${ { cast: [mouse_y, i32] } } folie=${ { cast: [slide_x, i32] } },${ { cast: [slide_y, i32] } } flaeche=${over_canvas} aktion=${<.last_action} werkzeug=${<.armed} treffer='${hit_dbg}'"]

            # ── press ────────────────────────────────────────────────────────
            - if:
                condition: { "&&": [{ call: [input.mouse_pressed, 0] }, { eq: [over_canvas, 1] }] }
                then:
                  # A press INSIDE the label being edited places the caret (§6); a
                  # press anywhere else commits first, so the next stroke cannot
                  # silently discard what was just typed.
                  - if:
                      condition: { eq: [<.editing, 1] }
                      then:
                        - decl: [live_box, Shape]
                        - decl: [on_live, i32, { call: [<.live_box, slide, org_x, org_y, scale, live_box] }]
                        - if:
                            condition: { eq: [on_live, 1] }
                            then:
                              - if:
                                  condition: { eq: [{ call: [<.label.click_in, live_box, mouse_x, mouse_y] }, 1] }
                                  then: [{ return: null }]
                        - call: [<.commit_label]
                  # the blue halo resizes (spec §15.1a).  Only with no explicit tool
                  # or the freehand default: an armed stencil still places.
                  - if:
                      condition: { "||": [{ eq: [<.armed, -1] }, { eq: [<.armed, 101] }] }
                      then:
                        - if:
                            condition: { eq: [{ call: [<.grip.start, slide, <.sel, slide_x, slide_y] }, 1] }
                            then:
                              - set: [<.status, "Groesse ziehen"]
                              - return: null
                  # freehand (spec §7): press starts the stroke
                  - if:
                      condition: { eq: [<.armed, 101] }
                      then:
                        - call: [<.ink.begin_stroke, slide_x, slide_y]
                        - return: null
                  # edge tool: press starts the link, release finishes it
                  - if:
                      condition: { eq: [<.armed, 100] }
                      then:
                        - decl: [src, string, { call: [<.grip.node_at, slide, slide_x, slide_y] }]
                        - if:
                            condition: { neq: [src, ""] }
                            then: [{ set: [<.link_from, src] }, { set: [<.status, "auf das Ziel loslassen"] }]
                            else: [{ set: [<.status, "Kante beginnt auf einem Knoten"] }]
                        - return: null
                  # stencil: place, then straight into the label (spec §15.1)
                  - if:
                      condition: { ge: [<.armed, 0] }
                      then:
                        - decl: [fresh, Node]
                        - set: [fresh.ident, "n${slide.next_id}"]
                        - set: [fresh.kind, <.armed]
                        - set: [fresh.pos_x, { -: [slide_x, 100.0] }]
                        - set: [fresh.pos_y, { -: [slide_y, 45.0] }]
                        - set: [fresh.width, 200.0]
                        - set: [fresh.height, 90.0]
                        - call: [slide.nodes.push, fresh]
                        - call: [<.touch]
                        - set: [slide.next_id, { +: [slide.next_id, 1] }]
                        - set: [<.armed, -1]
                        - call: [<.begin_edit, fresh.ident]
                        - return: null
                  - decl: [hit, string, { call: [<.grip.node_at, slide, slide_x, slide_y] }]
                  - if:
                      condition: { eq: [hit, ""] }
                      then:
                        # the heading is part of the page, not a node (§6)
                        - decl: [head_box2, Shape]
                        - call: [<.label.title_box, org_x, org_y, scale, head_box2]
                        - if:
                            condition: { "&&": [{ ge: [mouse_x, head_box2.pos_x] }, { le: [mouse_x, { +: [head_box2.pos_x, head_box2.width] }] }] }
                            then:
                              - if:
                                  condition: { "&&": [{ ge: [mouse_y, head_box2.pos_y] }, { le: [mouse_y, { +: [head_box2.pos_y, head_box2.height] }] }] }
                                  then:
                                    - call: [<.edit_title]
                                    - decl: [head_box3, Shape]
                                    - call: [<.label.title_box, org_x, org_y, scale, head_box3]
                                    - call: [<.label.place, head_box3, mouse_x, mouse_y, 0]
                                    - return: null
                        # An edge under the cursor is selected; otherwise a drag on
                        # empty canvas IS the stroke. Drawing is what the surface is
                        # for, so it costs no mode: a stroke too short to recognise
                        # does nothing, which is what a stray click should do anyway.
                        # In a sequence the thing under the cursor is a STEP: there
                        # are no edges, and a message is what a click on a line means
                        # (spec §5.8.3).
                        - if:
                            condition: { eq: [slide.dtype, DiagramType.sequence] }
                            then:
                              - decl: [near_step, i32, { call: [<.seq.step_at, slide, slide_x, slide_y] }]
                              - set: [<.sel, ""]
                              - set: [<.sel_edge, ""]
                              - set: [<.sel_step, ""]
                              - if:
                                  condition: { ge: [near_step, 0] }
                                  then:
                                    - decl: [picked, ref<Step>, { at: [slide.steps, near_step] }]
                                    - set: [<.sel_step, picked.ident]
                                    - set: [<.status, "Schritt gewaehlt"]
                                    - call: [<.drop_ink]
                                    - return: null
                              - call: [<.ink.begin_stroke, slide_x, slide_y]
                              - return: null
                        - decl: [near_edge, string, { call: [<.grip.edge_at, slide, slide_x, slide_y, 12.0] }]
                        - if:
                            condition: { neq: [near_edge, ""] }
                            then:
                              - set: [<.sel, ""]
                              - set: [<.sel_edge, near_edge]
                              - call: [<.drop_ink]
                              - return: null
                        - set: [<.sel, ""]
                        - set: [<.sel_edge, ""]
                        - call: [<.ink.begin_stroke, slide_x, slide_y]
                        - return: null
                  - if:
                      condition: { neq: [hit, ""] }
                      then:
                        # Drag the RIM to connect, the middle to move. Starting on a
                        # node had no way to mean "draw a line" -- the gesture was
                        # taken, so a connector could never begin on its source.
                        - decl: [rim, i32, 0]
                        - decl: [ridx, i32, 0]
                        - while:
                            condition: { lt: [ridx, slide.nodes.len] }
                            body:
                              - decl: [rnode, ref<Node>, { at: [slide.nodes, ridx] }]
                              - if:
                                  condition: { eq: [rnode.ident, hit] }
                                  then:
                                    - decl: [to_left, f32, { call: [math.abs, { -: [slide_x, rnode.pos_x] }] }]
                                    - decl: [to_right, f32, { call: [math.abs, { -: [slide_x, { +: [rnode.pos_x, rnode.width] }] }] }]
                                    - decl: [to_top, f32, { call: [math.abs, { -: [slide_y, rnode.pos_y] }] }]
                                    - decl: [to_bottom, f32, { call: [math.abs, { -: [slide_y, { +: [rnode.pos_y, rnode.height] }] }] }]
                                    - decl: [nearest, f32, { call: [math.min, { call: [math.min, to_left, to_right] }, { call: [math.min, to_top, to_bottom] }] }]
                                    - if: { condition: { lt: [nearest, 14.0] }, then: [{ set: [rim, 1] }] }
                                    - set: [ridx, slide.nodes.len]
                              - set: [ridx, { +: [ridx, 1] }]
                        - if:
                            condition: { eq: [rim, 1] }
                            then:
                              - set: [<.sel, ""]
                              - set: [<.sel_edge, ""]
                              - call: [<.ink.begin_stroke, slide_x, slide_y]
                              - set: [<.status, "Rand gezogen -- auf ein Ziel loslassen"]
                              - return: null
                        # typing starts by clicking the LETTERS of the already
                        # selected node (§15.1a): a click anywhere inside it used to
                        # open the label, so moving a node by its middle put the
                        # caret in instead
                        - if:
                            condition: { eq: [hit, <.sel] }
                            then:
                              - if:
                                  condition: { eq: [{ call: [<.grip.on_text, slide, hit, slide_x, slide_y, scale] }, 1] }
                                  then: [{ call: [<.begin_edit, hit] }]
                        - set: [<.sel, hit]
                        - call: [<.drop_ink]
                        - set: [<.sel_edge, ""]
                        - set: [<.drag_id, hit]
                        - decl: [grab, ref<Node>]
                        - decl: [pos2, i32, 0]
                        - while:
                            condition: { lt: [pos2, slide.nodes.len] }
                            body:
                              - decl: [node2, ref<Node>, { at: [slide.nodes, pos2] }]
                              - if:
                                  condition: { eq: [node2.ident, hit] }
                                  then:
                                    - set: [<.drag_dx, { -: [slide_x, node2.pos_x] }]
                                    - set: [<.drag_dy, { -: [slide_y, node2.pos_y] }]
                                    - set: [pos2, slide.nodes.len]
                              - set: [pos2, { +: [pos2, 1] }]
                  - return: null

            # §8.2: with no ink waiting, the right button opens the menu on whatever
            # is under the cursor.  With ink waiting, §7.5a has the first claim --
            # that button was given to the author to read the ink.
            - if:
                condition: { "&&": [{ call: [input.mouse_pressed, 1] }, { "&&": [{ eq: [<.ink.count, 0] }, { eq: [over_canvas, 1] }] }] }
                then:
                  - decl: [on_node, string, { call: [<.grip.node_at, slide, slide_x, slide_y] }]
                  - if:
                      condition: { neq: [on_node, ""] }
                      then:
                        - set: [<.sel, on_node]
                        - call: [<.drop_ink]
                        - set: [<.sel_edge, ""]
                        - call: [<.menu.open_at, 1, on_node, mouse_x, mouse_y]
                        - return: null
                  - decl: [on_edge, string, { call: [<.grip.edge_at, slide, slide_x, slide_y, 14.0] }]
                  - if:
                      condition: { neq: [on_edge, ""] }
                      then:
                        - set: [<.sel, ""]
                        - set: [<.sel_edge, on_edge]
                        - call: [<.drop_ink]
                        - call: [<.menu.open_at, 2, on_edge, mouse_x, mouse_y]
                        - return: null

            # ── the ink is read on the right button, or after one second ──────
            - if:
                condition: { "&&": [{ gt: [<.ink.count, 0] }, { eq: [<.ink.inking, 0] }] }
                then:
                  - decl: [now, f64, { call: [engine.time] }]
                  - decl: [idle, f64, { -: [now, <.ink.last] }]
                  # Re-reading unchanged ink would repeat the same verdict every
                  # settle period -- and did, three times over in the log.
                  - decl: [fresh_ink, i32, 0]
                  - if: { condition: { neq: [<.ink.count, <.read_at] }, then: [{ set: [fresh_ink, 1] }] }
                  - if:
                      condition: { "||": [{ call: [input.mouse_pressed, 1] }, { "&&": [{ eq: [fresh_ink, 1] }, { gt: [idle, <.settle] }] }] }
                      then:
                        - set: [<.read_at, <.ink.count]
                        - decl: [made, i32, { call: [<.reader.read_ink, slide] }]
                        - set: [<.status, <.reader.status]
                        - if:
                            condition: { neq: [<.reader.made_id, ""] }
                            then:
                              - call: [<.begin_edit, <.reader.made_id]
                              - set: [<.reader.made_id, ""]
                        # A group that produced nothing is KEPT: drawing a head first
                        # and then taking a moment over the line must not cost the
                        # head. The right button is the explicit discard.
                        - if:
                            condition: { "||": [{ gt: [made, 0] }, { call: [input.mouse_pressed, 1] }] }
                            then: [{ call: [<.ink.clear] }, { set: [<.read_at, 0] }]
                            else: [{ set: [<.ink.last, { call: [engine.time] }] }]
                        - return: null

            # ── freehand: collect while held (spec §7.5a) ─────────────────────
            - if:
                condition: { eq: [<.ink.inking, 1] }
                then:
                  - if:
                      condition: { call: [input.mouse_released, 0] }
                      then:
                        - call: [<.ink.add_point, slide_x, slide_y]
                        - set: [<.ink.inking, 0]
                        - set: [<.armed, -1]
                        - set: [<.ink.last, { call: [engine.time] }]
                        - set: [<.status, "Tinte steht -- rechte Taste oder 1 s Pause liest sie"]
                        - return: null
                  - call: [<.ink.add_point, slide_x, slide_y]
                  - return: null

            # ── release: finish a link ───────────────────────────────────────
            - if:
                condition: { call: [input.mouse_released, 0] }
                then:
                  - if:
                      condition: { neq: [<.link_from, ""] }
                      then:
                        - decl: [dst, string, { call: [<.grip.node_at, slide, slide_x, slide_y] }]
                        - if:
                            condition: { "&&": [{ neq: [dst, ""] }, { neq: [dst, <.link_from] }] }
                            then: [{ call: [<.join_two, slide, <.link_from, dst] }]
                            else:
                              # released on nothing: a dangling edge has no Mermaid form
                              - set: [<.status, "auf keinem Knoten losgelassen -- nichts angelegt"]
                        - set: [<.link_from, ""]
                        - set: [<.armed, -1]
                  - set: [<.drag_id, ""]
                  - return: null

            # ── resize by the halo (spec §15.1a) ─────────────────────────────
            - if:
                condition: { eq: [{ call: [<.grip.active] }, 1] }
                then:
                  - if:
                      condition: { eq: [{ call: [input.mouse_button, 0] }, 0] }
                      then: [{ call: [<.grip.stop] }, { return: null }]
                  - call: [<.grip.drag, slide, slide_x, slide_y]
                  - call: [<.touch]
                  - return: null

            # ── drag a node ──────────────────────────────────────────────────
            - if:
                condition: { eq: [{ call: [input.mouse_button, 0] }, 0] }
                then: [{ set: [<.drag_id, ""] }, { return: null }]
            - if:
                condition: { neq: [<.drag_id, ""] }
                then:
                  - decl: [pos, i32, 0]
                  - while:
                      condition: { lt: [pos, slide.nodes.len] }
                      body:
                        - decl: [node, ref<Node>, { at: [slide.nodes, pos] }]
                        - if:
                            condition: { eq: [node.ident, <.drag_id] }
                            then:
                              - call: [<.touch]
                              - set: [node.pos_x, { -: [slide_x, <.drag_dx] }]
                              - set: [node.pos_y, { -: [slide_y, <.drag_dy] }]
                              - set: [pos, slide.nodes.len]
                        - set: [pos, { +: [pos, 1] }]

      # ── keyboard: ONE consumer (spec §6, normative) ────────────────────────
      # Everything comes from the event queue. A key read both as an event and as a
      # poll fires twice, and the symptom is a Backspace that eats two characters.
      - def:
          name: handle_events
          static_off: ["same_arg", "str_cmp"]
          body:
            - while:
                condition: { call: [input.has_event] }
                body:
                  - decl: [evt, input_event, { call: [input.next_event] }]
                  - if:
                      condition: { eq: [<.editing, 1] }
                      then:
                        # Ctrl+C sends no character on most platforms, but a shortcut
                        # that DID would otherwise type a "c" into the label
                        - decl: [holding, i32, 0]
                        - if: { condition: { call: [input.key_down, "LCtrl"] }, then: [{ set: [holding, 1] }] }
                        - if: { condition: { call: [input.key_down, "RCtrl"] }, then: [{ set: [holding, 1] }] }
                        - if:
                            condition: { "&&": [{ eq: [evt.type, "text"] }, { eq: [holding, 0] }] }
                            then: [{ call: [<.label.insert, evt.char_] }]
                        # A held key repeats while typing (aiml spec/44_0: `key_repeat`
                        # is its own event, so the one-press-one-event rule stays
                        # exact).  Slide navigation deliberately does NOT repeat --
                        # holding Right would race through the deck.
                        - decl: [is_key, i32, 0]
                        - if: { condition: { eq: [evt.type, "key_down"] }, then: [{ set: [is_key, 1] }] }
                        - if: { condition: { eq: [evt.type, "key_repeat"] }, then: [{ set: [is_key, 1] }] }
                        - if:
                            condition: { eq: [is_key, 1] }
                            then:
                              - decl: [verdict, i32, { call: [<.label.key, evt.key] }]
                              - if: { condition: { eq: [verdict, 2] }, then: [{ call: [<.commit_label] }] }
                              - if:
                                  condition: { eq: [verdict, 3] }
                                  then:
                                    - set: [<.editing, 0]
                                    - set: [<.edit_id, ""]
                                    - call: [<.label.stop]
                                    - set: [<.status, "verworfen"]
                      else:
                        - if:
                            condition: { eq: [evt.type, "key_down"] }
                            then: [{ call: [<.nav_key, evt.key] }]

      - def:
          name: nav_key
          static_off: ["same_arg", "str_cmp"]
          args: [[key, string]]
          body:
            - if: { condition: { eq: [key, "F5"] }, then: [{ set: [<.presenting, 1] }, { set: [<.sel, ""] }, { return: null }] }
            - if:
                condition: { eq: [key, "Escape"] }
                then:
                  - if: { condition: { eq: [<.menu.shown, 1] }, then: [{ call: [<.menu.close] }, { return: null }] }
                  - set: [<.presenting, 0]
                  - return: null
            - decl: [forward, i32, 0]
            - if: { condition: { eq: [key, "Right"] }, then: [{ set: [forward, 1] }] }
            - if: { condition: { eq: [key, "Space"] }, then: [{ set: [forward, 1] }] }
            - if: { condition: { eq: [key, "PageDown"] }, then: [{ set: [forward, 1] }] }
            - if:
                condition: { eq: [forward, 1] }
                then:
                  - if:
                      condition: { lt: [<.deck.current, { -: [<.deck.slides.len, 1] }] }
                      then: [{ set: [<.deck.current, { +: [<.deck.current, 1] }] }, { call: [<.clear_selection] }]
                  - return: null
            - decl: [back, i32, 0]
            - if: { condition: { eq: [key, "Left"] }, then: [{ set: [back, 1] }] }
            - if: { condition: { eq: [key, "PageUp"] }, then: [{ set: [back, 1] }] }
            - if:
                condition: { eq: [back, 1] }
                then:
                  - if:
                      condition: { gt: [<.deck.current, 0] }
                      then: [{ set: [<.deck.current, { -: [<.deck.current, 1] }] }, { call: [<.clear_selection] }]
                  - return: null
            - if: { condition: { eq: [key, "Home"] }, then: [{ set: [<.deck.current, 0] }, { call: [<.clear_selection] }, { return: null }] }
            - if: { condition: { eq: [key, "End"] }, then: [{ set: [<.deck.current, { -: [<.deck.slides.len, 1] }] }, { call: [<.clear_selection] }, { return: null }] }
            - if: { condition: { eq: [key, "N"] }, then: [{ set: [<.show_notes, { -: [1, <.show_notes] }] }, { return: null }] }
            - if: { condition: { eq: [key, "Delete"] }, then: [{ call: [<.dispatch, 20] }, { return: null }] }
            - decl: [holding, i32, 0]
            - if: { condition: { call: [input.key_down, "LCtrl"] }, then: [{ set: [holding, 1] }] }
            - if: { condition: { call: [input.key_down, "RCtrl"] }, then: [{ set: [holding, 1] }] }
            - call: [<.diag.say, "TASTE ${key} strg=${holding} auswahl='${<.sel}'"]
            - if:
                condition: { "&&": [{ eq: [holding, 1] }, { eq: [<.deck.slides.len, 0] }] }
                then: [{ return: null }]
            - if:
                condition: { eq: [holding, 1] }
                then:
                  - decl: [slide_c, ref<Sheet>, { at: [<.deck.slides, <.deck.current] }]
                  - decl: [wanted, i32, 0]
                  - if: { condition: { eq: [key, "C"] }, then: [{ set: [wanted, 1] }] }
                  - if: { condition: { eq: [key, "X"] }, then: [{ set: [wanted, 2] }] }
                  - if: { condition: { eq: [key, "V"] }, then: [{ set: [wanted, 3] }] }
                  - if:
                      condition: { "&&": [{ lt: [wanted, 3] }, { gt: [wanted, 0] }] }
                      then:
                        - if: { condition: { eq: [<.sel, ""] }, then: [{ set: [<.status, "erst ein Element waehlen"] }, { return: null }] }
                        - if:
                            condition: { eq: [{ call: [<.clip.copy, slide_c, <.sel] }, 1] }
                            then:
                              - set: [<.status, "kopiert"]
                              - if:
                                  condition: { eq: [wanted, 2] }
                                  then: [{ call: [<.dispatch, 20] }, { set: [<.status, "ausgeschnitten"] }]
                        - return: null
                  - if:
                      condition: { eq: [wanted, 3] }
                      then:
                        - decl: [made, string, { call: [<.clip.paste, slide_c] }]
                        - if:
                            condition: { neq: [made, ""] }
                            then:
                              - set: [<.sel, made]
                              - set: [<.sel_edge, ""]
                              - call: [<.touch]
                              - set: [<.status, "eingefuegt"]
                            else: [{ set: [<.status, "nichts in der Ablage"] }]
                        - return: null
            - if: { condition: { eq: [key, "S"] }, then: [{ call: [<.save_deck, ""] }, { return: null }] }
            - if: { condition: { eq: [key, "O"] }, then: [{ call: [<.dispatch, 60] }, { return: null }] }
            # Enter opens the selected node for editing (spec §6)
            - if:
                condition: { eq: [key, "Enter"] }
                then:
                  - if: { condition: { neq: [<.sel, ""] }, then: [{ call: [<.begin_edit, <.sel] }] }

      # Save goes through Files; the editor keeps only what the editor owns: which
      # path the deck came from, and whether it still differs from the file.
      - def:
          name: save_deck
          static_off: ["same_arg", "str_cmp"]
          args: [[where, string]]
          body:
            - decl: [written, string, { call: [<.files.save, <.deck, where, <.deck_path] }]
            - if:
                condition: { neq: [written, ""] }
                then:
                  - set: [<.deck_path, written]
                  - set: [<.dirty, 0]
            - set: [<.status, <.files.status]

      # A picture is stored relative to the deck when it lies below it (§16.3): a deck
      # moved with its images keeps working, and one pointing into a home directory
      # says so plainly instead of breaking somewhere else.
      - def:
          name: set_image
          static_off: ["same_arg", "str_cmp"]
          args: [[picture, string]]
          body:
            - decl: [kept, string, picture]
            - decl: [here, path, <.deck_path]
            - decl: [up_dir, path, { call: [here.parent] }]
            - decl: [folder, string, { call: [up_dir.to_string] }]
            - if:
                condition: { "&&": [{ neq: [folder, ""] }, { eq: [{ call: [picture.starts_with, "${folder}/"] }, 1] }] }
                then: [{ set: [kept, { call: [picture.substr, { +: [folder.len, 1] }, { -: [picture.len, { +: [folder.len, 1] }] }] }] }]
            - decl: [slide, ref<Sheet>, { at: [<.deck.slides, <.deck.current] }]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, slide.nodes.len] }
                body:
                  - decl: [node, ref<Node>, { at: [slide.nodes, idx] }]
                  - if:
                      condition: { eq: [node.ident, <.sel] }
                      then:
                        - if:
                            condition: { neq: [node.kind, NodeKind.image] }
                            then:
                              - set: [<.status, "das gewaehlte Element ist kein Bild"]
                              - return: null
                        - set: [node.src, kept]
                        - set: [<.dirty, 1]
                        - set: [<.status, "Bild: ${kept}"]
                        - return: null
                  - set: [idx, { +: [idx, 1] }]

      # Carry out what the menu picked.  The menu knows the target and the colour;
      # the sheet is changed here, because the sheet belongs to the editor.
      - def:
          name: menu_deed
          static_off: ["same_arg", "str_cmp"]
          body:
            - if: { condition: { eq: [<.menu.deed, 0] }, then: [{ return: null }] }
            - if: { condition: { eq: [<.deck.slides.len, 0] }, then: [{ return: null }] }
            - decl: [slide, ref<Sheet>, { at: [<.deck.slides, <.deck.current] }]
            - decl: [deed, i32, <.menu.deed]
            - decl: [tone, i32, <.menu.tone]
            - decl: [kind, i32, <.menu.kind]
            - decl: [ident, string, <.menu.ident]
            - call: [<.menu.close]
            - if: { condition: { eq: [deed, 3] }, then: [{ call: [<.dispatch, 20] }, { call: [<.touch] }, { return: null }] }
            - if:
                condition: { eq: [kind, 2] }
                then:
                  - decl: [pos_e, i32, 0]
                  - while:
                      condition: { lt: [pos_e, slide.edges.len] }
                      body:
                        - decl: [edge, ref<Edge>, { at: [slide.edges, pos_e] }]
                        - if:
                            condition: { eq: [edge.ident, ident] }
                            then:
                              - set: [edge.stroke, tone]
                              - call: [<.touch]
                              - set: [<.status, "Kantenfarbe gesetzt"]
                              - return: null
                        - set: [pos_e, { +: [pos_e, 1] }]
                  - return: null
            - decl: [pos, i32, 0]
            - while:
                condition: { lt: [pos, slide.nodes.len] }
                body:
                  - decl: [node, ref<Node>, { at: [slide.nodes, pos] }]
                  - if:
                      condition: { eq: [node.ident, ident] }
                      then:
                        - if: { condition: { eq: [deed, 1] }, then: [{ set: [node.fill, tone] }] }
                        - if: { condition: { eq: [deed, 2] }, then: [{ set: [node.stroke, tone] }] }
                        - call: [<.touch]
                        - set: [<.status, "Farbe gesetzt"]
                        - return: null
                  - set: [pos, { +: [pos, 1] }]

      # Picking something up ends the drawing (§7.5a): ink that produced nothing is
      # litter once the author has moved on to arranging.
      - def:
          name: drop_ink
          body:
            - if: { condition: { eq: [<.ink.count, 0] }, then: [{ return: null }] }
            - call: [<.ink.clear]
            - set: [<.read_at, 0]
            - set: [<.status, "Zeichnung verworfen -- Element gewaehlt"]

      - def:
          name: touch
          body:
            - set: [<.dirty, 1]

      - def:
          name: clear_selection
          body:
            - set: [<.sel_step, ""]
            - set: [<.sel, ""]
            - set: [<.sel_edge, ""]
            - set: [<.editing, 0]
            - set: [<.edit_id, ""]

      - def:
          name: begin_edit
          static_off: ["same_arg", "str_cmp"]
          args: [[ident, string]]
          body:
            - if: { condition: { eq: [<.deck.slides.len, 0] }, then: [{ return: null }] }
            - decl: [slide, ref<Sheet>, { at: [<.deck.slides, <.deck.current] }]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, slide.nodes.len] }
                body:
                  - decl: [node, ref<Node>, { at: [slide.nodes, idx] }]
                  - if:
                      condition: { eq: [node.ident, ident] }
                      then:
                        - set: [<.editing, 1]
                        - set: [<.edit_id, ident]
                        # A class is edited as ONE text: the name on the first line,
                        # a member per line after it (spec §5.8.2).  No second editor,
                        # and the compartments cannot drift away from the name.
                        - decl: [whole, string, node.text]
                        - decl: [ridx, i32, 0]
                        - while:
                            condition: { lt: [ridx, node.rows.len] }
                            body:
                              - decl: [row, string, { at: [node.rows, ridx] }]
                              - set: [whole, "${whole}\n${row}"]
                              - set: [ridx, { +: [ridx, 1] }]
                        - call: [<.label.begin, ident, whole]
                        - set: [<.sel, ident]
                        - set: [<.status, "tippen, Enter uebernimmt"]
                        - return: null
                  - set: [idx, { +: [idx, 1] }]

      # Commit and grow the box to the text: measured, never estimated (spec §6).
      - def:
          name: commit_label
          static_off: ["same_arg", "str_cmp"]
          body:
            - set: [<.editing, 0]
            - if: { condition: { eq: [<.edit_id, ""] }, then: [{ return: null }] }
            - call: [<.diag.say, "UEBERNOMMEN ${<.edit_id} = '${<.label.text}'"]
            - call: [<.touch]
            - decl: [slide, ref<Sheet>, { at: [<.deck.slides, <.deck.current] }]
            - if:
                condition: { eq: [<.edit_id, "#titel"] }
                then:
                  - set: [slide.title, <.label.text]
                  - set: [<.edit_id, ""]
                  - call: [<.label.stop]
                  - set: [<.status, "Ueberschrift uebernommen"]
                  - return: null
            - if:
                condition: { call: [<.edit_id.starts_with, "#step:"] }
                then:
                  - decl: [want, string, { call: [<.edit_id.substr, 6, { -: [<.edit_id.len, 6] }] }]
                  - decl: [sdx, i32, 0]
                  - while:
                      condition: { lt: [sdx, slide.steps.len] }
                      body:
                        - decl: [step, ref<Step>, { at: [slide.steps, sdx] }]
                        - if:
                            condition: { eq: [step.ident, want] }
                            then: [{ set: [step.text, <.label.text] }]
                        - set: [sdx, { +: [sdx, 1] }]
                  - set: [<.edit_id, ""]
                  - call: [<.label.stop]
                  - set: [<.status, "uebernommen"]
                  - return: null
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, slide.nodes.len] }
                body:
                  - decl: [node, ref<Node>, { at: [slide.nodes, idx] }]
                  - if:
                      condition: { eq: [node.ident, <.edit_id] }
                      then:
                        - if:
                            condition: { eq: [slide.dtype, DiagramType.class_diagram] }
                            then:
                              - call: [<.fill_rows, node]
                              - set: [<.edit_id, ""]
                              - call: [<.label.stop]
                              - set: [<.status, "uebernommen"]
                              - return: null
                        - set: [node.text, <.label.text]
                        - if:
                            condition: { gt: [<.last_scale, 0.0] }
                            then:
                              - decl: [lines, list<string>, { call: [<.label.text.split, "\n"] }]
                              - decl: [widest, f32, 0.0]
                              - decl: [line_i, i32, 0]
                              - while:
                                  condition: { lt: [line_i, lines.len] }
                                  body:
                                    - decl: [line, string, { at: [lines, line_i] }]
                                    - decl: [line_w, f32, { call: [ui.measure_text, line] }]
                                    - if: { condition: { gt: [line_w, widest] }, then: [{ set: [widest, line_w] }] }
                                    - set: [line_i, { +: [line_i, 1] }]
                              - decl: [want, f32, { +: [{ /: [widest, <.last_scale] }, 48.0] }]
                              - if: { condition: { gt: [want, node.width] }, then: [{ set: [node.width, want] }] }
                        - set: [<.edit_id, ""]
                        - call: [<.label.stop]
                        - set: [<.status, "uebernommen"]
                        - return: null
                  - set: [idx, { +: [idx, 1] }]
            - set: [<.edit_id, ""]

      # First line is the class name, the rest are its members (spec §5.8.2).  The
      # box grows to hold them: a compartment that is drawn outside its own frame is
      # worse than no compartment.
      - def:
          name: fill_rows
          static_off: ["same_arg", "str_cmp"]
          args: [[node, ref<Node>]]
          body:
            - decl: [lines, list<string>, { call: [<.label.text.split, "\n"] }]
            - call: [node.rows.clear]
            - set: [node.text, ""]
            - decl: [idx, i32, 0]
            - decl: [widest, f32, 0.0]
            - while:
                condition: { lt: [idx, lines.len] }
                body:
                  - decl: [line, string, { at: [lines, idx] }]
                  - decl: [line_w, f32, { call: [ui.measure_text, line] }]
                  - if: { condition: { gt: [line_w, widest] }, then: [{ set: [widest, line_w] }] }
                  - if:
                      condition: { eq: [idx, 0] }
                      then: [{ set: [node.text, line] }]
                      else: [{ call: [node.rows.push, line] }]
                  - set: [idx, { +: [idx, 1] }]
            - decl: [want_h, f32, { +: [36.0, { "*": [20.0, { cast: [node.rows.len, f32] }] }] }]
            - if: { condition: { gt: [want_h, node.height] }, then: [{ set: [node.height, want_h] }] }
            - if:
                condition: { gt: [<.last_scale, 0.0] }
                then:
                  - decl: [want_w, f32, { +: [{ /: [widest, <.last_scale] }, 40.0] }]
                  - if: { condition: { gt: [want_w, node.width] }, then: [{ set: [node.width, want_w] }] }

      # ── images ──────────────────────────────────────────────────────────────
      # Loaded once per distinct path when the deck is opened: a texture per frame
      # would re-upload every picture 60 times a second.
      # ── the loop ────────────────────────────────────────────────────────────
      - def:
          name: run
          static_off: ["same_arg", "str_cmp"]
          args: [[path, string], [frame_limit, i32], [shot_path, string], [opts, ref<ChartOptions>]]
          return: i32
          body:
            - set: [<.deck_path, path]
            - set: [<.armed, -1]
            - set: [<.sel, ""]
            - set: [<.drag_id, ""]
            - set: [<.presenting, 0]
            - set: [<.show_notes, 0]
            - set: [<.status, "bereit"]
            - if:
                condition: { eq: [{ call: [<.sheet_io.load, path, <.deck] }, 0] }
                then: [{ return: 1 }]
            - call: [<.ink.setup]
            - set: [<.diag.wanted, opts.diag]
            - if:
                condition: { neq: [opts.script, ""] }
                then:
                  - if:
                      condition: { eq: [{ call: [<.script.load, opts.script] }, 0] }
                      then: [{ return: 1 }]
            - set: [<.settle, { /: [{ cast: [opts.settle, f64] }, 1000.0] }]
            - set: [<.presenting, opts.present]
            - set: [<.show_notes, opts.notes]
            - set: [<.deck.current, { -: [opts.start, 1] }]
            - if: { condition: { lt: [<.deck.current, 0] }, then: [{ set: [<.deck.current, 0] }] }
            - if: { condition: { ge: [<.deck.current, <.deck.slides.len] }, then: [{ set: [<.deck.current, { -: [<.deck.slides.len, 1] }] }] }
            - decl: [win, window_handle, { call: [engine.create_window, 1400, 880, "chart"] }]
            - if:
                condition: { eq: [win, null] }
                then:
                  - call: [log.error, "chart: cannot open a window"]
                  - return: 1
            - call: [gl.init]
            - call: [ui.init]
            # Registers the GLFW callbacks. Without it every input call is a no-op
            # (aiml spec/44_0 §2): the window draws and nothing reacts.
            - call: [input.init, win]
            - decl: [font, ui_font, { call: [ui.load_font_default, 15.0] }]
            - if:
                condition: { peq: [font, null] }
                then:
                  - call: [log.error, "chart: no font"]
                  - return: 1
            - call: [ui.set_default_font, font]
            - call: [<.art.load_images, <.deck]

            - decl: [cols_show, buffer<f32>, [1.0]]
            - decl: [rows, buffer<f32>, [1.0]]

            - decl: [frame, i32, 0]
            - while:
                condition: { call: [engine.running, win] }
                body:
                  - set: [frame, { +: [frame, 1] }]
                  - call: [gl.clear_all, 0.09, 0.11, 0.14, 1.0]
                  - decl: [isize, ivec2, { call: [engine.window_size, win] }]
                  - decl: [fsize, vec2, { call: [math.ivec2_to_vec2, isize] }]
                  - decl: [win_w, f32, fsize.x]
                  - decl: [win_h, f32, fsize.y]
                  - call: [ui.begin, win]
                  - call: [ui.set_gap, 0.0, 0.0]
                  # One scripted step per frame (spec §9.1), BEFORE the events are
                  # drained: aiml_input_update clears the queue at the start of each
                  # frame, so a key posted after handle_events is wiped before anyone
                  # reads it -- the clicks worked (they are latches), the keys did not.
                  - if:
                      condition: { eq: [<.script.running, 1] }
                      then:
                        # the same rect the canvas gets: the strips took the top of
                        # the window (§8.0), and a step must land where the slide is
                        - decl: [sc_top, f32, { +: [{ call: [<.top_bar.height] }, { call: [<.tools.height] }] }]
                        - decl: [sc_cvs_h, f32, { -: [{ -: [win_h, sc_top] }, { call: [<.strip_bottom] }] }]
                        - decl: [sc_scale, f32, { call: [<.fit_scale, win_w, sc_cvs_h, 0.88] }]
                        - decl: [sc_org_x, f32, { /: [{ -: [win_w, { "*": [1280.0, sc_scale] }] }, 2.0] }]
                        - decl: [sc_org_y, f32, { +: [sc_top, { /: [{ -: [sc_cvs_h, { "*": [720.0, sc_scale] }] }, 2.0] }] }]
                        - decl: [verdict, i32, { call: [<.script.tick, sc_org_x, sc_org_y, sc_scale] }]
                        - if: { condition: { eq: [verdict, 2] }, then: [{ call: [<.save_deck, ""] }] }
                        # verdict 3 = shot: taken at the end of the frame, below
                        - if:
                            condition: { eq: [verdict, 4] }
                            then:
                              - call: [ui.end]
                              - call: [engine.swap, win]
                              - return: 0
                  - call: [<.handle_events]
                  - decl: [live_now, string, ""]
                  - if: { condition: { eq: [<.editing, 1] }, then: [{ set: [live_now, <.edit_id] }] }
                  - set: [<.art.live_id, live_now]
                  - if:
                      condition: { eq: [<.presenting, 1] }
                      then:
                        - call: [ui.begin_grid, cols_show, rows]
                        - call: [ui.begin_cell, 0, 0, 1, 1]
                        - call: [<.draw_slide, 0.0, 0.0, win_w, win_h, 0.98]
                        - call: [ui.end_cell]
                        - call: [ui.end_grid]
                      else:
                        # what the menu strip offers depends on the deck (§8.0)
                        - call: [<.feed_bar]
                        - decl: [action, i32, 0]
                        - call: [ui.begin_grid, cols_show, rows]
                        - call: [ui.begin_cell, 0, 0, 1, 1]
                        - decl: [strip_h, f32, { +: [{ call: [<.top_bar.height] }, { call: [<.tools.height] }] }]
                        - decl: [cvs_h, f32, { -: [{ -: [win_h, strip_h] }, { call: [<.strip_bottom] }] }]
                        - call: [<.draw_slide, 0.0, strip_h, win_w, cvs_h, 0.88]
                        - call: [<.menu.draw]
                        - call: [<.canvas_input, 0.0, strip_h, win_w, cvs_h, 0.88]
                        - call: [ui.end_cell]
                        - call: [ui.end_grid]
                        - call: [<.status_strip, win_w, win_h]
                        # The strips draw OUTSIDE the grid, over the full width: a
                        # widget in a cell cannot leave its cell, and a dropdown has to
                        # fall over the canvas (§8.0).
                        - decl: [bar_x, f32, { call: [input.mouse_pos_x] }]
                        - decl: [bar_y, f32, { call: [input.mouse_pos_y] }]
                        - decl: [menu_h, f32, { call: [<.top_bar.height] }]
                        - call: [<.top_bar.draw, win_w, bar_x, bar_y]
                        - decl: [dtype_now, i32, 0]
                        - if:
                            condition: { gt: [<.deck.slides.len, 0] }
                            then:
                              - decl: [slide_t, ref<Sheet>, { at: [<.deck.slides, <.deck.current] }]
                              - set: [dtype_now, slide_t.dtype]
                        - call: [<.tools.draw, win_w, menu_h, dtype_now, bar_x, bar_y]
                        - call: [<.top_bar.draw_open, bar_x, bar_y]
                        - if:
                            condition: { call: [input.mouse_pressed, 0] }
                            then:
                              - decl: [took, i32, { call: [<.top_bar.press, bar_x, bar_y] }]
                              - if:
                                  condition: { eq: [took, 1] }
                                  then: [{ set: [action, <.top_bar.deed] }]
                                  else:
                                    - decl: [took2, i32, { call: [<.tools.press, bar_x, bar_y, menu_h] }]
                                    - if: { condition: { eq: [took2, 1] }, then: [{ set: [action, <.tools.deed] }] }
                        - set: [<.last_action, action]
                        # DIAGNOSE: eine Leisten-Aktion wird eigenstaendig vermerkt,
                        # unabhaengig von der Maus-Flanke -- sonst haengt der Beweis,
                        # dass ein Knopf feuert, an der Protokollstelle daneben.
                        - if:
                            condition: { "&&": [{ neq: [action, 0] }, { neq: [<.diag.wanted, 0] }] }
                            then:
                              - call: [<.diag.say, "LEISTE aktion=${action}"]
                        - call: [<.dispatch, action]
                  - call: [ui.end]
                  - if:
                      condition: { eq: [<.script.shot_due, 1] }
                      then:
                        - call: [<.exporter.capture, <.script.arg, isize.x, isize.y]
                        - set: [<.script.shot_due, 0]
                  # The capture happens BEFORE the swap: after it the back buffer is
                  # undefined, and a screenshot of an undefined buffer is noise that
                  # looks like a rendering bug.
                  - if:
                      condition: { gt: [frame_limit, 0] }
                      then:
                        - if:
                            condition: { ge: [frame, frame_limit] }
                            then:
                              - if:
                                  condition: { neq: [shot_path, ""] }
                                  then: [{ call: [<.exporter.capture, shot_path, isize.x, isize.y] }]
                              - call: [engine.swap, win]
                              - return: 0
                  - call: [engine.swap, win]
            - return: 0

- classgroup:
    name: ChartRuntime
    instances:
      - class: SheetIO
        instance: sheet_io
      - class: SeqLayout
        instance: seq
      - class: SeqArt
        instance: seq_art
        sees: [seq, pen]
      - class: EdgeArt
        instance: edge_art
        sees: [pen, grip]
      - class: MermaidOut
        instance: mermaid
        sees: [seq]
      - class: MarkdownOut
        instance: markdown
      - class: SvgOut
        instance: svg
        sees: [pen, seq]
      - class: ZipOut
        instance: zip
      - class: PptxOut
        instance: pptx
        sees: [pen, svg, zip]
      - class: MermaidIn
        instance: mermaid_in
      - class: MarkdownIn
        instance: markdown_in
        sees: [mermaid_in]
      - class: Exporter
        instance: exporter
        sees: [sheet_io, mermaid, markdown, svg, pptx, mermaid_in, markdown_in]
      - class: Recognizer
        instance: recognizer
      - class: Ink
        instance: ink
        sees: [recognizer]
      - class: Pen
        instance: pen
      - class: Grip
        instance: grip
      - class: Menu
        instance: menu
      - class: LabelEdit
        instance: label
      - class: Clip
        instance: clip
      - class: Script
        instance: script
      - class: NodeArt
        instance: art
        sees: [pen, label]
      - class: TopBar
        instance: top_bar
      - class: ToolBar
        instance: tools
      - class: FileBrowser
        instance: browse
      - class: Files
        instance: files
        sees: [sheet_io, exporter, mermaid, pptx, browse]
      - class: Diag
        instance: diag
        sees: [exporter]
      - class: Reader
        instance: reader
        sees: [ink, diag]
      - class: Editor
        instance: editor
        sees: [sheet_io, mermaid, markdown, exporter, ink, pen, grip, files, diag, reader, menu, label, clip, script, art, top_bar, tools, seq, seq_art, edge_art]
