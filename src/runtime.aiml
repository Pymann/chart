# Composition of one headless export pass (doc/spec/chart.md §2, §13).
#
# Separate from the entry point on purpose: `main` has to instantiate a class declared
# in another file, otherwise a multi-file project is dead weight.
- import: "src/sheet.aiml"
- import: "src/mermaid.aiml"
- import: "src/markdown.aiml"
- import: "src/svg.aiml"
- import: "src/pptx.aiml"
- import: "src/mermaid_in.aiml"

- model:
    name: ChartOptions
    description: "Command line of chart"
    fields:
      - [sheet, string, ""]        # input: a single sheet (spec §4)
      - [deck, string, ""]         # input: a deck, or a sheet -- both load as a deck (spec §11.1)
      - [mermaid, string, ""]      # output: one .mmd, only for a one-slide deck
      - [markdown, string, ""]     # output: a directory, one Markdown file per slide (spec §13)
      - [svg, string, ""]          # output: a directory, one SVG per slide (spec §17.1)
      - [html, string, ""]         # output: one self-contained deck file (spec §17.3)
      - [pptx, string, ""]         # output: one editable PowerPoint file (spec §17.2)
      - [import, string, ""]   # input: read Mermaid back in (spec §18)
      - [out, string, ""]          # where the imported sheet is written
      # Testing and screenshots: run a fixed number of frames, optionally capture the
      # last one.  Without this the editor runs until the window closes, and a test
      # that waits for a human is a test nobody runs (aiml run_all_tests.sh: a
      # blocking test stops the whole suite).
      - [frames, i32, 0]           # 0 = until the window closes
      - [shot, string, ""]         # PNG of the last frame
      - [start, i32, 1]            # slide to open on, 1-based
      - [present, i32, 0]          # open straight in presentation mode (spec §14)
      - [notes, i32, 0]            # presenter notes visible from the start
      # --diag 1 writes every click and every bar action to diag.log. A live test
      # otherwise depends on reading a status line in an 18% wide bar, and the one
      # number that matters there is gone again by the time it is read.
      - [diag, i32, 0]
      # How long the ink waits before it is read, in milliseconds (spec §7.5a).
      # Guessed at 1000 and too short in practice: repositioning the pen between two
      # dashes takes longer than that, and the group was read half-drawn.
      - [settle, i32, 1600]

- class:
    name: Exporter
    description: "One headless export pass"
    members:
      - [sheet_io, ref<SheetIO>]      # borrow, wired by the classgroup (aiml spec/58 §5.1)
      - [mermaid, ref<MermaidOut>]
      - [markdown, ref<MarkdownOut>]
      - [svg, ref<SvgOut>]
      - [pptx, ref<PptxOut>]
      - [mermaid_in, ref<MermaidIn>]
    methods:
      # buffer.write_to reports a short write or a failed flush; io.write cannot
      # (aiml spec/23) -- and a half-written diagram must not pass for a written one.
      - def:
          name: write_file
          static_off: ["same_arg", "str_cmp"]
          args: [[file_path, string], [content, string]]
          return: i32
          body:
            - decl: [handle, file_handle, { call: [io.open, file_path, "w"] }]
            - if:
                condition: { eq: [handle, null] }
                then:
                  - call: [log.error, "chart: ${file_path}: cannot write"]
                  - return: 0
            - decl: [bytes, buffer<u8>]
            - call: [bytes.alloc, { +: [content.len, 1] }]
            - decl: [staged, i32, { call: [bytes.write_string, content] }]
            - if:
                condition: { lt: [staged, 0] }
                then:
                  - call: [io.close, handle]
                  - call: [log.error, "chart: ${file_path}: cannot stage ${content.len} bytes"]
                  - return: 0
            - decl: [written, i32, { call: [bytes.write_to, handle] }]
            - call: [io.close, handle]
            - if:
                condition: { lt: [written, content.len] }
                then:
                  - call: [log.error, "chart: ${file_path}: short write (${written} of ${content.len})"]
                  - return: 0
            - return: 1

      # One Markdown file per slide, plus the index (spec §13).
      - def:
          name: write_markdown
          static_off: ["same_arg", "str_cmp"]
          args: [[deck, ref<Deck>], [dir_path, string]]
          return: i32
          body:
            - call: [io.mkdir_all, dir_path]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, deck.slides.len] }
                body:
                  - decl: [slide, Sheet, { at: [deck.slides, idx] }]
                  - decl: [number, i32, { +: [idx, 1] }]
                  - decl: [chart_text, string, { call: [<.mermaid.emit, slide] }]
                  - decl: [page, string, { call: [<.markdown.slide_md, slide, chart_text] }]
                  - decl: [name, string, { call: [<.markdown.file_name, number, slide.title] }]
                  - if:
                      condition: { eq: [{ call: [<.write_file, "${dir_path}/${name}", page] }, 0] }
                      then: [{ return: 0 }]
                  - set: [idx, { +: [idx, 1] }]
            - decl: [index_page, string, { call: [<.markdown.index_md, deck] }]
            - return: { call: [<.write_file, "${dir_path}/README.md", index_page] }

      # One SVG per slide, named exactly as the Markdown export names its files
      # (spec §17.1), so a directory holding both lines up slide by slide.
      - def:
          name: write_svg
          static_off: ["same_arg", "str_cmp"]
          args: [[deck, ref<Deck>], [dir_path, string]]
          return: i32
          body:
            - call: [io.mkdir_all, dir_path]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, deck.slides.len] }
                body:
                  - decl: [slide, Sheet, { at: [deck.slides, idx] }]
                  - decl: [number, i32, { +: [idx, 1] }]
                  - decl: [name, string, { call: [<.markdown.stem, number, slide.title] }]
                  - decl: [page, string, { call: [<.svg.emit, slide] }]
                  - if:
                      condition: { eq: [{ call: [<.write_file, "${dir_path}/${name}.svg", page] }, 0] }
                      then: [{ return: 0 }]
                  - set: [idx, { +: [idx, 1] }]
            - return: 1

      # One file, no network (spec §17.3).  The slides are the same SVGs, inlined;
      # there is no second renderer to keep in step.
      - def:
          name: write_html
          static_off: ["same_arg", "str_cmp"]
          args: [[deck, ref<Deck>], [file_path, string]]
          return: i32
          body:
            - decl: [title, string, deck.title]
            - if: { condition: { eq: [title, ""] }, then: [{ set: [title, "chart"] }] }
            - decl: [out, string, "<!doctype html>\n<html lang=\"de\">\n<meta charset=\"utf-8\">\n"]
            - set: [out, "${out}<title>${ { call: [<.svg.esc, title] } }</title>\n"]
            - set: [out, "${out}<style>\n"]
            - set: [out, "${out}  html,body{margin:0;background:#101a24;color:#e8eef4;font:15px/1.5 system-ui,sans-serif}\n"]
            - set: [out, "${out}  .slide{display:none;height:100vh;align-items:center;justify-content:center}\n"]
            - set: [out, "${out}  .slide.on{display:flex}\n"]
            - set: [out, "${out}  svg{max-width:100vw;max-height:100vh;height:auto;width:auto;box-shadow:0 0 40px #0008}\n"]
            - set: [out, "${out}  #count{position:fixed;right:14px;bottom:10px;opacity:.55}\n"]
            - set: [out, "${out}</style>\n"]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, deck.slides.len] }
                body:
                  - decl: [slide, Sheet, { at: [deck.slides, idx] }]
                  - set: [out, "${out}<div class=\"slide\">\n${ { call: [<.svg.emit, slide] } }</div>\n"]
                  - set: [idx, { +: [idx, 1] }]
            - set: [out, "${out}<div id=\"count\"></div>\n<script>\n"]
            - set: [out, "${out}const pages=[...document.querySelectorAll('.slide')];\n"]
            - set: [out, "${out}let at=Math.min(Math.max(parseInt(new URLSearchParams(location.search).get('slide')||'1',10)-1,0),pages.length-1);\n"]
            - set: [out, "${out}function show(){pages.forEach((p,i)=>p.classList.toggle('on',i===at));document.getElementById('count').textContent=(at+1)+' / '+pages.length;}\n"]
            - set: [out, "${out}addEventListener('keydown',e=>{if(e.key==='ArrowRight'||e.key===' '||e.key==='PageDown'){at=Math.min(at+1,pages.length-1);show();}if(e.key==='ArrowLeft'||e.key==='PageUp'){at=Math.max(at-1,0);show();}if(e.key==='Home'){at=0;show();}if(e.key==='End'){at=pages.length-1;show();}});\n"]
            - set: [out, "${out}addEventListener('click',()=>{at=Math.min(at+1,pages.length-1);show();});\n"]
            - set: [out, "${out}show();\n</script>\n</html>\n"]
            - return: { call: [<.write_file, file_path, out] }

      # §18.1: an import is a reconstruction, so it writes a NEW sheet and never
      # over the source.  Refusing an existing target is the whole guard: a layout
      # someone arranged must not be replaced by one chart invented.
      - def:
          name: import_run
          static_off: ["same_arg", "str_cmp"]
          args: [[options, ChartOptions]]
          return: i32
          body:
            - decl: [target, string, options.out]
            - if:
                condition: { eq: [target, ""] }
                then:
                  - call: [log.error, "chart: --import braucht --out ZIEL.deck.yaml"]
                  - return: 1
            - decl: [there, path, target]
            - if:
                condition: { neq: [{ call: [io.is_file, there] }, 0] }
                then:
                  - call: [log.error, "chart: ${target} gibt es schon -- ein Import erfindet die Anordnung (spec §18.1) und darf keine ueberschreiben"]
                  - return: 1
            - decl: [handle, file_handle, { call: [io.open, options.import, "r"] }]
            - if:
                condition: { eq: [handle, null] }
                then:
                  - call: [log.error, "chart: ${options.import}: nicht lesbar"]
                  - return: 1
            - decl: [text, string, { call: [io.read_all, handle] }]
            - call: [io.close, handle]
            - decl: [deck, Deck]
            - decl: [sheet, Sheet]
            - if:
                condition: { eq: [{ call: [<.mermaid_in.read, text, sheet] }, 0] }
                then: [{ return: 1 }]
            - call: [deck.slides.push, sheet]
            - decl: [yaml_text, string, { call: [<.sheet_io.deck_yaml, deck] }]
            - if:
                condition: { eq: [{ call: [<.write_file, target, yaml_text] }, 0] }
                then: [{ return: 1 }]
            - if:
                condition: { neq: [<.mermaid_in.unread, ""] }
                then: [{ call: [log.warn, "chart: nicht gelesen (spec §18.2):\n${<.mermaid_in.unread}"] }]
            - call: [log.info, "chart: ${target} geschrieben -- die Anordnung ist erfunden (spec §18.3), zum Zurechtziehen gedacht"]
            - return: 0

      - def:
          name: run
          static_off: ["same_arg", "str_cmp"]
          args: [[options, ChartOptions]]
          return: i32
          body:
            - decl: [input, string, options.deck]
            - if: { condition: { eq: [input, ""] }, then: [{ set: [input, options.sheet] }] }
            - decl: [deck, Deck]
            - if:
                condition: { eq: [{ call: [<.sheet_io.load, input, deck] }, 0] }
                then: [{ return: 1 }]

            - if:
                condition: { neq: [options.markdown, ""] }
                then:
                  - if:
                      condition: { eq: [{ call: [<.write_markdown, deck, options.markdown] }, 0] }
                      then: [{ return: 1 }]

            - if:
                condition: { neq: [options.svg, ""] }
                then:
                  - if:
                      condition: { eq: [{ call: [<.write_svg, deck, options.svg] }, 0] }
                      then: [{ return: 1 }]

            - if:
                condition: { neq: [options.pptx, ""] }
                then:
                  # images hang off the deck file, so the deck's directory travels
                  # with the call (spec §16.3)
                  - decl: [here, path, input]
                  - decl: [up_dir, path, { call: [here.parent] }]
                  - decl: [folder, string, { call: [up_dir.to_string] }]
                  - if:
                      condition: { eq: [{ call: [<.pptx.emit, deck, options.pptx, folder] }, 0] }
                      then: [{ return: 1 }]

            - if:
                condition: { neq: [options.html, ""] }
                then:
                  - if:
                      condition: { eq: [{ call: [<.write_html, deck, options.html] }, 0] }
                      then: [{ return: 1 }]

            - if:
                condition: { neq: [options.mermaid, ""] }
                then:
                  # One .mmd is one diagram.  A deck of many slides has no single
                  # projection, and picking the first silently would export a third of
                  # a presentation and call it done.
                  - if:
                      condition: { neq: [deck.slides.len, 1] }
                      then:
                        - call: [log.error, "chart: --mermaid needs a one-slide deck; '${input}' has ${deck.slides.len} slides -- use --markdown DIR"]
                        - return: 1
                  - decl: [only, Sheet, { at: [deck.slides, 0] }]
                  - decl: [text, string, { call: [<.mermaid.emit, only] }]
                  - if: { condition: { eq: [text, ""] }, then: [{ return: 1 }] }
                  - if:
                      condition: { eq: [{ call: [<.write_file, options.mermaid, text] }, 0] }
                      then: [{ return: 1 }]
            - return: 0
