# Pure drawing: a rect with a pen, a line with a pen, and the geometry that decides
# where an edge stops (doc/spec/chart.md §15.2).
#
# Its own class because none of it touches editor state -- and because one file may
# not grow past 1499 lines (aiml spec/49 §3), which is a limit worth obeying rather
# than working around: the editor had quietly become four things.

- import: "src/model.aiml"

- model:
    name: Shape
    description: "A rect plus the pen that draws it -- what every canvas helper needs"
    fields:
      - [pos_x, f32, 0.0]
      - [pos_y, f32, 0.0]
      - [width, f32, 0.0]
      - [height, f32, 0.0]
      - [tint, i32, 0]
      - [thick, f32, 2.0]
      - [deco, i32, 0]                # 1 fett | 2 kursiv | 4 unterstrichen (§5.6a)

- model:
    name: Segment
    description: "A line with the pen that draws it"
    fields:
      - [from_x, f32, 0.0]
      - [from_y, f32, 0.0]
      - [to_x, f32, 0.0]
      - [to_y, f32, 0.0]
      - [tint, i32, 0]
      - [thick, f32, 2.0]

- class:
    name: Pen
    description: "Shapes, lines and text at a position; the text faces are its only state"
    members:
      # Bold and italic need a FACE, not a flag: stb_truetype has no synthetic bold
      # and no skew.  Loaded once from the system, because chart ships no fonts; if
      # they are not there, `faces` stays 2 and the canvas says so (§5.6a).
      - [face_bold, ui_label_style]
      - [face_ital, ui_label_style]
      - [face_both, ui_label_style]
      - [faces, i32]                  # 0 not tried, 1 loaded, 2 unavailable
    methods:
      - def:
          name: load_faces
          static_off: ["same_arg", "str_cmp"]
          body:
            - if: { condition: { neq: [<.faces, 0] }, then: [{ return: null }] }
            - decl: [root, string, "/usr/share/fonts/truetype/dejavu"]
            - decl: [bold, ui_font, { call: [ui.load_font, "${root}/DejaVuSansMono-Bold.ttf", 15.0] }]
            - decl: [ital, ui_font, { call: [ui.load_font, "${root}/DejaVuSansMono-Oblique.ttf", 15.0] }]
            - decl: [both, ui_font, { call: [ui.load_font, "${root}/DejaVuSansMono-BoldOblique.ttf", 15.0] }]
            - if:
                condition: { "||": [{ peq: [bold, null] }, { "||": [{ peq: [ital, null] }, { peq: [both, null] }] }] }
                then:
                  - set: [<.faces, 2]
                  - call: [log.info, "chart: keine fetten/kursiven Schnitte gefunden -- Text wird gerade gezeichnet (spec 5.6a)"]
                  - return: null
            - set: [<.face_bold, { call: [ui.label_style_new] }]
            - call: [<.face_bold.set_font, bold]
            - set: [<.face_ital, { call: [ui.label_style_new] }]
            - call: [<.face_ital.set_font, ital]
            - set: [<.face_both, { call: [ui.label_style_new] }]
            - call: [<.face_both.set_font, both]
            - set: [<.faces, 1]

      # One line, with whatever decoration the caller asked for.  The underline is
      # drawn, not styled: a font has no underline, and §5.6a keeps it anyway
      # because the sheet -- not Mermaid -- is the document.
      - def:
          name: say
          static_off: ["same_arg", "str_cmp"]
          args: [[at_x, f32], [at_y, f32], [text, string], [tint, i32], [deco, i32]]
          body:
            - if: { condition: { eq: [deco, 0] }, then: [{ call: [ui.draw_text, at_x, at_y, text, tint] }, { return: null }] }
            - call: [<.load_faces]
            - decl: [bold, i32, { band: [deco, 1] }]
            - decl: [ital, i32, { band: [deco, 2] }]
            - decl: [wide, f32, 0.0]
            - if:
                condition: { eq: [<.faces, 1] }
                then:
                  - decl: [face, ui_label_style, <.face_bold]
                  - if: { condition: { "&&": [{ eq: [bold, 0] }, { neq: [ital, 0] }] }, then: [{ set: [face, <.face_ital] }] }
                  - if: { condition: { "&&": [{ neq: [bold, 0] }, { neq: [ital, 0] }] }, then: [{ set: [face, <.face_both] }] }
                  - if:
                      condition: { "&&": [{ eq: [bold, 0] }, { eq: [ital, 0] }] }
                      then:
                        - call: [ui.draw_text, at_x, at_y, text, tint]
                        - set: [wide, { call: [ui.measure_text, text] }]
                      else:
                        - call: [ui.draw_text, at_x, at_y, text, tint, face]
                        - set: [wide, { call: [ui.measure_text, text, face] }]
                else:
                  # no faces: bold is drawn twice a hair apart, italic cannot be
                  # faked at all and is simply upright
                  - call: [ui.draw_text, at_x, at_y, text, tint]
                  - if: { condition: { neq: [bold, 0] }, then: [{ call: [ui.draw_text, { +: [at_x, 1.0] }, at_y, text, tint] }] }
                  - set: [wide, { call: [ui.measure_text, text] }]
            - if:
                condition: { eq: [{ band: [deco, 4] }, 4] }
                then:
                  - decl: [low, f32, { +: [at_y, { -: [{ call: [ui.text_height] }, 2.0] }] }]
                  - call: [ui.draw_line, at_x, low, { +: [at_x, wide] }, low, 1.0, tint]

      # Width of one line in the face that `say` would use -- so a caller can centre
      # text it has not drawn yet.
      - def:
          name: span_of
          static_off: ["same_arg", "str_cmp"]
          args: [[text, string], [deco, i32]]
          return: f32
          body:
            - if: { condition: { eq: [deco, 0] }, then: [{ return: { call: [ui.measure_text, text] } }] }
            - call: [<.load_faces]
            - if: { condition: { neq: [<.faces, 1] }, then: [{ return: { call: [ui.measure_text, text] } }] }
            - decl: [bold, i32, { band: [deco, 1] }]
            - decl: [ital, i32, { band: [deco, 2] }]
            - if: { condition: { "&&": [{ eq: [bold, 0] }, { eq: [ital, 0] }] }, then: [{ return: { call: [ui.measure_text, text] } }] }
            - decl: [face, ui_label_style, <.face_bold]
            - if: { condition: { "&&": [{ eq: [bold, 0] }, { neq: [ital, 0] }] }, then: [{ set: [face, <.face_ital] }] }
            - if: { condition: { "&&": [{ neq: [bold, 0] }, { neq: [ital, 0] }] }, then: [{ set: [face, <.face_both] }] }
            - return: { call: [ui.measure_text, text, face] }

      # Readable ink for a fill: luminance decides, not taste.  A node coloured dark
      # dst_cy its author would otherwise keep the dark default and lose its label.
      - def:
          name: ink_for
          args: [[fill, i32]]
          return: i32
          body:
            - decl: [red, i32, { band: [{ shr: [fill, 24] }, 255] }]
            - decl: [green, i32, { band: [{ shr: [fill, 16] }, 255] }]
            - decl: [blue, i32, { band: [{ shr: [fill, 8] }, 255] }]
            - decl: [lum, i32, { /: [{ +: [{ +: [{ "*": [red, 299] }, { "*": [green, 587] }] }, { "*": [blue, 114] }] }, 1000] }]
            - if: { condition: { lt: [lum, 140] }, then: [{ return: 0xF4F7FAFF }] }
            - return: 0x1A2430FF

      # Where the centre-to-centre line leaves the node's OUTLINE.  Using the
      # bounding box for every shape leaves a gap on a circle and overshoots a
      # diamond, and because the gap depends on the angle it only shows up while
      # something is being dragged -- which is exactly when it is most visible.
      - def:
          name: edge_stop
          args: [[half_w, f32], [half_h, f32], [uni_x, f32], [uni_y, f32], [kind, i32]]
          return: f32
          body:
            - decl: [abs_x, f32, { call: [math.abs, uni_x] }]
            - decl: [abs_y, f32, { call: [math.abs, uni_y] }]
            - if: { condition: { lt: [half_w, 0.01] }, then: [{ return: 0.0 }] }
            - if: { condition: { lt: [half_h, 0.01] }, then: [{ return: 0.0 }] }

            # ellipse: (t*ux/rx)^2 + (t*uy/ry)^2 = 1
            - decl: [round_shape, i32, 0]
            - if: { condition: { eq: [kind, NodeKind.circle] }, then: [{ set: [round_shape, 1] }] }
            - if: { condition: { eq: [kind, NodeKind.round] }, then: [{ set: [round_shape, 1] }] }
            - if: { condition: { eq: [kind, NodeKind.stadium] }, then: [{ set: [round_shape, 1] }] }
            - if:
                condition: { eq: [round_shape, 1] }
                then:
                  - decl: [part_x, f32, { /: [uni_x, half_w] }]
                  - decl: [part_y, f32, { /: [uni_y, half_h] }]
                  - decl: [denom, f32, { call: [math.sqrt, { +: [{ "*": [part_x, part_x] }, { "*": [part_y, part_y] }] }] }]
                  - if: { condition: { lt: [denom, 0.000001] }, then: [{ return: 0.0 }] }
                  - return: { /: [1.0, denom] }

            # diamond: |x|/rx + |y|/ry = 1
            - if:
                condition: { eq: [kind, NodeKind.diamond] }
                then:
                  - decl: [sum, f32, { +: [{ /: [abs_x, half_w] }, { /: [abs_y, half_h] }] }]
                  - if: { condition: { lt: [sum, 0.000001] }, then: [{ return: 0.0 }] }
                  - return: { /: [1.0, sum] }

            # rect, hexagon, cylinder, subroutine, image: the box
            - decl: [span, f32, 100000.0]
            - if:
                condition: { gt: [abs_x, 0.001] }
                then: [{ set: [span, { /: [half_w, abs_x] }] }]
            - if:
                condition: { gt: [abs_y, 0.001] }
                then: [{ set: [span, { call: [math.min, span, { /: [half_h, abs_y] }] }] }]
            - return: span

      # ── drawing helpers ─────────────────────────────────────────────────────
      - def:
          name: frame
          args: [[box, ref<Shape>]]
          body:
            - decl: [right, f32, { +: [box.pos_x, box.width] }]
            - decl: [bottom, f32, { +: [box.pos_y, box.height] }]
            - call: [ui.draw_line, box.pos_x, box.pos_y, right, box.pos_y, box.thick, box.tint]
            - call: [ui.draw_line, right, box.pos_y, right, bottom, box.thick, box.tint]
            - call: [ui.draw_line, right, bottom, box.pos_x, bottom, box.thick, box.tint]
            - call: [ui.draw_line, box.pos_x, bottom, box.pos_x, box.pos_y, box.thick, box.tint]

      # A closed polyline around the ellipse inscribed in the box.
      - def:
          name: ellipse
          args: [[box, ref<Shape>]]
          body:
            - decl: [steps, i32, 36]
            - decl: [rad_x, f32, { /: [box.width, 2.0] }]
            - decl: [rad_y, f32, { /: [box.height, 2.0] }]
            - decl: [mid_x, f32, { +: [box.pos_x, rad_x] }]
            - decl: [mid_y, f32, { +: [box.pos_y, rad_y] }]
            - decl: [pts, buffer<f32>]
            - call: [pts.alloc, 320]
            - decl: [idx, i32, 0]
            - while:
                condition: { le: [idx, steps] }
                body:
                  - decl: [turn, f32, { /: [{ "*": [6.2831853, { cast: [idx, f32] }] }, { cast: [steps, f32] }] }]
                  - call: [pts.write, { +: [mid_x, { "*": [rad_x, { call: [math.cos, turn] }] }] }, f32]
                  - call: [pts.write, { +: [mid_y, { "*": [rad_y, { call: [math.sin, turn] }] }] }, f32]
                  - set: [idx, { +: [idx, 1] }]
            - call: [ui.draw_polyline, pts, box.thick, box.tint]

      - def:
          name: diamond
          args: [[box, ref<Shape>]]
          body:
            - decl: [pts, buffer<f32>]
            - call: [pts.alloc, 48]
            - decl: [half_w, f32, { /: [box.width, 2.0] }]
            - decl: [half_h, f32, { /: [box.height, 2.0] }]
            - decl: [right, f32, { +: [box.pos_x, box.width] }]
            - decl: [bottom, f32, { +: [box.pos_y, box.height] }]
            - call: [pts.write, { +: [box.pos_x, half_w] }, f32]
            - call: [pts.write, box.pos_y, f32]
            - call: [pts.write, right, f32]
            - call: [pts.write, { +: [box.pos_y, half_h] }, f32]
            - call: [pts.write, { +: [box.pos_x, half_w] }, f32]
            - call: [pts.write, bottom, f32]
            - call: [pts.write, box.pos_x, f32]
            - call: [pts.write, { +: [box.pos_y, half_h] }, f32]
            - call: [pts.write, { +: [box.pos_x, half_w] }, f32]
            - call: [pts.write, box.pos_y, f32]
            - call: [ui.draw_polyline, pts, box.thick, box.tint]

      - def:
          name: hexagon
          args: [[box, ref<Shape>]]
          body:
            - decl: [pts, buffer<f32>]
            - call: [pts.alloc, 64]
            - decl: [inset, f32, { /: [box.width, 5.0] }]
            - decl: [half_h, f32, { /: [box.height, 2.0] }]
            - decl: [right, f32, { +: [box.pos_x, box.width] }]
            - decl: [bottom, f32, { +: [box.pos_y, box.height] }]
            - call: [pts.write, { +: [box.pos_x, inset] }, f32]
            - call: [pts.write, box.pos_y, f32]
            - call: [pts.write, { -: [right, inset] }, f32]
            - call: [pts.write, box.pos_y, f32]
            - call: [pts.write, right, f32]
            - call: [pts.write, { +: [box.pos_y, half_h] }, f32]
            - call: [pts.write, { -: [right, inset] }, f32]
            - call: [pts.write, bottom, f32]
            - call: [pts.write, { +: [box.pos_x, inset] }, f32]
            - call: [pts.write, bottom, f32]
            - call: [pts.write, box.pos_x, f32]
            - call: [pts.write, { +: [box.pos_y, half_h] }, f32]
            - call: [pts.write, { +: [box.pos_x, inset] }, f32]
            - call: [pts.write, box.pos_y, f32]
            - call: [ui.draw_polyline, pts, box.thick, box.tint]

      # Centred, multi-line.  Measured and drawn from the same two numbers
      # (aiml spec/44_3 §4.6), so the text sits where the box says it does.
      - def:
          name: text_block
          static_off: ["same_arg", "str_cmp"]
          args: [[box, ref<Shape>], [text, string]]
          body:
            - if: { condition: { eq: [text, ""] }, then: [{ return: null }] }
            - decl: [lines, list<string>, { call: [text.split, "\n"] }]
            - decl: [line_h, f32, { call: [ui.text_height] }]
            - decl: [total, f32, { "*": [line_h, { cast: [lines.len, f32] }] }]
            - decl: [line_y, f32, { +: [box.pos_y, { /: [{ -: [box.height, total] }, 2.0] }] }]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, lines.len] }
                body:
                  - decl: [line, string, { at: [lines, idx] }]
                  - decl: [line_w, f32, { call: [<.span_of, line, box.deco] }]
                  - decl: [left, f32, { +: [box.pos_x, { /: [{ -: [box.width, line_w] }, 2.0] }] }]
                  - call: [<.say, left, line_y, line, box.tint, box.deco]
                  - set: [line_y, { +: [line_y, line_h] }]
                  - set: [idx, { +: [idx, 1] }]

      # The shapes that are polygons (spec §5.2).  `lean` is how far the slanted side
      # is pushed in, as a fraction of the width, and the sign flips the direction --
      # a trapezoid and its mirror are one routine with a different sign.
      - def:
          name: slanted
          args: [[box, ref<Shape>], [top_lean, f32], [low_lean, f32]]
          body:
            - decl: [right, f32, { +: [box.pos_x, box.width] }]
            - decl: [low, f32, { +: [box.pos_y, box.height] }]
            - decl: [top_in, f32, { "*": [box.width, { call: [math.abs, top_lean] }] }]
            - decl: [low_in, f32, { "*": [box.width, { call: [math.abs, low_lean] }] }]
            - decl: [top_l, f32, { +: [box.pos_x, top_in] }]
            - decl: [top_r, f32, { -: [right, top_in] }]
            - decl: [low_l, f32, { +: [box.pos_x, low_in] }]
            - decl: [low_r, f32, { -: [right, low_in] }]
            - if: { condition: { lt: [top_lean, 0.0] }, then: [{ set: [top_l, box.pos_x] }, { set: [top_r, { -: [right, { "*": [top_in, 2.0] }] }] }] }
            - if: { condition: { lt: [low_lean, 0.0] }, then: [{ set: [low_l, box.pos_x] }, { set: [low_r, { -: [right, { "*": [low_in, 2.0] }] }] }] }
            - call: [ui.draw_line, top_l, box.pos_y, top_r, box.pos_y, box.thick, box.tint]
            - call: [ui.draw_line, top_r, box.pos_y, low_r, low, box.thick, box.tint]
            - call: [ui.draw_line, low_r, low, low_l, low, box.thick, box.tint]
            - call: [ui.draw_line, low_l, low, top_l, box.pos_y, box.thick, box.tint]

      # `>text]`: a rect whose left side points inward (spec §5.2).
      - def:
          name: asymmetric
          args: [[box, ref<Shape>]]
          body:
            - decl: [right, f32, { +: [box.pos_x, box.width] }]
            - decl: [low, f32, { +: [box.pos_y, box.height] }]
            - decl: [notch, f32, { "*": [box.width, 0.16] }]
            - decl: [mid_y, f32, { +: [box.pos_y, { /: [box.height, 2.0] }] }]
            - decl: [left_in, f32, { +: [box.pos_x, notch] }]
            - call: [ui.draw_line, left_in, box.pos_y, right, box.pos_y, box.thick, box.tint]
            - call: [ui.draw_line, right, box.pos_y, right, low, box.thick, box.tint]
            - call: [ui.draw_line, right, low, left_in, low, box.thick, box.tint]
            - call: [ui.draw_line, left_in, low, box.pos_x, mid_y, box.thick, box.tint]
            - call: [ui.draw_line, box.pos_x, mid_y, left_in, box.pos_y, box.thick, box.tint]

      # A stick figure (spec §3.2): head, body, arms, legs.  Use-case drawings need
      # it and Mermaid has nothing like it, so chart draws it itself.
      - def:
          name: actor
          args: [[box, ref<Shape>]]
          body:
            - decl: [mid_x, f32, { +: [box.pos_x, { /: [box.width, 2.0] }] }]
            - decl: [head_r, f32, { /: [box.height, 7.0] }]
            - decl: [head, Shape]
            - set: [head.pos_x, { -: [mid_x, head_r] }]
            - set: [head.pos_y, box.pos_y]
            - set: [head.width, { "*": [head_r, 2.0] }]
            - set: [head.height, { "*": [head_r, 2.0] }]
            - set: [head.tint, box.tint]
            - set: [head.thick, box.thick]
            - call: [<.ellipse, head]
            - decl: [neck, f32, { +: [box.pos_y, { "*": [head_r, 2.0] }] }]
            - decl: [hip, f32, { +: [box.pos_y, { "*": [box.height, 0.62] }] }]
            - decl: [low, f32, { +: [box.pos_y, box.height] }]
            - decl: [span, f32, { "*": [box.width, 0.30] }]
            - decl: [arm_y, f32, { +: [neck, { "*": [box.height, 0.12] }] }]
            - call: [ui.draw_line, mid_x, neck, mid_x, hip, box.thick, box.tint]
            - call: [ui.draw_line, { -: [mid_x, span] }, arm_y, { +: [mid_x, span] }, arm_y, box.thick, box.tint]
            - call: [ui.draw_line, mid_x, hip, { -: [mid_x, span] }, low, box.thick, box.tint]
            - call: [ui.draw_line, mid_x, hip, { +: [mid_x, span] }, low, box.thick, box.tint]

      # One end cap of a segment (spec §5.3).  `at_head` 1 = at `to`, 0 = at `from`;
      # the direction is taken from the segment itself, so a tail cap is the head's
      # mirror and neither can drift from the line it belongs to.
      - def:
          name: rhombus
          args: [[seg, ref<Segment>], [at_head, i32], [filled, i32]]
          body:
            - decl: [del_x, f32, { -: [seg.from_x, seg.to_x] }]
            - decl: [del_y, f32, { -: [seg.from_y, seg.to_y] }]
            - decl: [span, f32, { call: [math.sqrt, { +: [{ "*": [del_x, del_x] }, { "*": [del_y, del_y] }] }] }]
            - if: { condition: { lt: [span, 0.001] }, then: [{ return: null }] }
            - decl: [uni_x, f32, { /: [del_x, span] }]
            - decl: [uni_y, f32, { /: [del_y, span] }]
            - decl: [at_x, f32, seg.to_x]
            - decl: [at_y, f32, seg.to_y]
            - if:
                condition: { eq: [at_head, 0] }
                then:
                  - set: [at_x, seg.from_x]
                  - set: [at_y, seg.from_y]
                  - set: [uni_x, { -: [0.0, uni_x] }]
                  - set: [uni_y, { -: [0.0, uni_y] }]
            - decl: [reach, f32, 20.0]
            - decl: [mid_x, f32, { +: [at_x, { "*": [uni_x, { /: [reach, 2.0] }] }] }]
            - decl: [mid_y, f32, { +: [at_y, { "*": [uni_y, { /: [reach, 2.0] }] }] }]
            - decl: [far_x, f32, { +: [at_x, { "*": [uni_x, reach] }] }]
            - decl: [far_y, f32, { +: [at_y, { "*": [uni_y, reach] }] }]
            - decl: [side_x, f32, { "*": [{ -: [0.0, uni_y] }, 8.0] }]
            - decl: [side_y, f32, { "*": [uni_x, 8.0] }]
            - decl: [one_x, f32, { +: [mid_x, side_x] }]
            - decl: [one_y, f32, { +: [mid_y, side_y] }]
            - decl: [two_x, f32, { -: [mid_x, side_x] }]
            - decl: [two_y, f32, { -: [mid_y, side_y] }]
            - call: [ui.draw_line, at_x, at_y, one_x, one_y, seg.thick, seg.tint]
            - call: [ui.draw_line, one_x, one_y, far_x, far_y, seg.thick, seg.tint]
            - call: [ui.draw_line, far_x, far_y, two_x, two_y, seg.thick, seg.tint]
            - call: [ui.draw_line, two_x, two_y, at_x, at_y, seg.thick, seg.tint]
            # filled: strokes across the shape, there being no filled polygon call
            - if:
                condition: { eq: [filled, 1] }
                then:
                  - decl: [step, f32, 0.1]
                  - while:
                      condition: { lt: [step, 0.95] }
                      body:
                        - decl: [near_x, f32, { +: [at_x, { "*": [{ -: [one_x, at_x] }, step] }] }]
                        - decl: [near_y, f32, { +: [at_y, { "*": [{ -: [one_y, at_y] }, step] }] }]
                        - decl: [back_x, f32, { +: [at_x, { "*": [{ -: [two_x, at_x] }, step] }] }]
                        - decl: [back_y, f32, { +: [at_y, { "*": [{ -: [two_y, at_y] }, step] }] }]
                        - call: [ui.draw_line, near_x, near_y, back_x, back_y, 1.5, seg.tint]
                        - decl: [tip_x, f32, { +: [far_x, { "*": [{ -: [one_x, far_x] }, step] }] }]
                        - decl: [tip_y, f32, { +: [far_y, { "*": [{ -: [one_y, far_y] }, step] }] }]
                        - decl: [end_x, f32, { +: [far_x, { "*": [{ -: [two_x, far_x] }, step] }] }]
                        - decl: [end_y, f32, { +: [far_y, { "*": [{ -: [two_y, far_y] }, step] }] }]
                        - call: [ui.draw_line, tip_x, tip_y, end_x, end_y, 1.5, seg.tint]
                        - set: [step, { +: [step, 0.1] }]

      - def:
          name: cap
          args: [[seg, ref<Segment>], [at_head, i32], [cap, i32]]
          body:
            - if: { condition: { eq: [cap, EndCap.none] }, then: [{ return: null }] }
            - decl: [del_x, f32, { -: [seg.from_x, seg.to_x] }]
            - decl: [del_y, f32, { -: [seg.from_y, seg.to_y] }]
            - decl: [span, f32, { call: [math.sqrt, { +: [{ "*": [del_x, del_x] }, { "*": [del_y, del_y] }] }] }]
            - if: { condition: { lt: [span, 0.001] }, then: [{ return: null }] }
            - decl: [uni_x, f32, { /: [del_x, span] }]
            - decl: [uni_y, f32, { /: [del_y, span] }]
            - decl: [at_x, f32, seg.to_x]
            - decl: [at_y, f32, seg.to_y]
            - if:
                condition: { eq: [at_head, 0] }
                then:
                  - set: [at_x, seg.from_x]
                  - set: [at_y, seg.from_y]
                  - set: [uni_x, { -: [0.0, uni_x] }]
                  - set: [uni_y, { -: [0.0, uni_y] }]
            - decl: [reach, f32, 16.0]
            - decl: [per_x, f32, { -: [0.0, uni_y] }]
            - decl: [per_y, f32, uni_x]
            - if:
                condition: { eq: [cap, EndCap.circle] }
                then:
                  - decl: [ring, Shape]
                  - decl: [mid_x, f32, { +: [at_x, { "*": [uni_x, 7.0] }] }]
                  - decl: [mid_y, f32, { +: [at_y, { "*": [uni_y, 7.0] }] }]
                  - set: [ring.pos_x, { -: [mid_x, 7.0] }]
                  - set: [ring.pos_y, { -: [mid_y, 7.0] }]
                  - set: [ring.width, 14.0]
                  - set: [ring.height, 14.0]
                  - set: [ring.tint, seg.tint]
                  - set: [ring.thick, seg.thick]
                  - call: [<.ellipse, ring]
                  - return: null
            - if:
                condition: { eq: [cap, EndCap.cross] }
                then:
                  - decl: [cen_x, f32, { +: [at_x, { "*": [uni_x, 7.0] }] }]
                  - decl: [cen_y, f32, { +: [at_y, { "*": [uni_y, 7.0] }] }]
                  - decl: [arm, f32, 7.0]
                  - decl: [arm_ax, f32, { "*": [{ +: [uni_x, per_x] }, arm] }]
                  - decl: [arm_ay, f32, { "*": [{ +: [uni_y, per_y] }, arm] }]
                  - decl: [arm_bx, f32, { "*": [{ -: [uni_x, per_x] }, arm] }]
                  - decl: [arm_by, f32, { "*": [{ -: [uni_y, per_y] }, arm] }]
                  - call: [ui.draw_line, { -: [cen_x, arm_ax] }, { -: [cen_y, arm_ay] }, { +: [cen_x, arm_ax] }, { +: [cen_y, arm_ay] }, seg.thick, seg.tint]
                  - call: [ui.draw_line, { -: [cen_x, arm_bx] }, { -: [cen_y, arm_by] }, { +: [cen_x, arm_bx] }, { +: [cen_y, arm_by] }, seg.thick, seg.tint]
                  - return: null
            # arrow and hollow share the two barbs; hollow closes them into a triangle
            - decl: [one_x, f32, { +: [at_x, { "*": [{ -: [{ "*": [uni_x, 0.92] }, { "*": [uni_y, 0.40] }] }, reach] }] }]
            - decl: [one_y, f32, { +: [at_y, { "*": [{ +: [{ "*": [uni_y, 0.92] }, { "*": [uni_x, 0.40] }] }, reach] }] }]
            - decl: [two_x, f32, { +: [at_x, { "*": [{ +: [{ "*": [uni_x, 0.92] }, { "*": [uni_y, 0.40] }] }, reach] }] }]
            - decl: [two_y, f32, { +: [at_y, { "*": [{ -: [{ "*": [uni_y, 0.92] }, { "*": [uni_x, 0.40] }] }, reach] }] }]
            - call: [ui.draw_line, at_x, at_y, one_x, one_y, seg.thick, seg.tint]
            - call: [ui.draw_line, at_x, at_y, two_x, two_y, seg.thick, seg.tint]
            - if:
                condition: { eq: [cap, EndCap.hollow] }
                then: [{ call: [ui.draw_line, one_x, one_y, two_x, two_y, seg.thick, seg.tint] }]

      # Prose (spec §3.2): left-aligned, starting at the top edge.  A paragraph that
      # is centred line by line reads like a poster, which is exactly wrong for text
      # that came out of a document.
      - def:
          name: text_flow
          static_off: ["same_arg", "str_cmp"]
          args: [[box, ref<Shape>], [text, string]]
          body:
            - if: { condition: { eq: [text, ""] }, then: [{ return: null }] }
            - decl: [lines, list<string>, { call: [text.split, "\n"] }]
            - decl: [line_h, f32, { call: [ui.text_height] }]
            - decl: [line_y, f32, box.pos_y]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, lines.len] }
                body:
                  - decl: [line, string, { at: [lines, idx] }]
                  - call: [<.say, box.pos_x, line_y, line, box.tint, box.deco]
                  - set: [line_y, { +: [line_y, line_h] }]
                  - set: [idx, { +: [idx, 1] }]

      # Dashes along a line: a dotted edge has to LOOK dotted, otherwise the author
      # has to read the file to see what they drew (spec §5.3).
      - def:
          name: dashed
          args: [[seg, ref<Segment>]]
          body:
            - decl: [steps, i32, 16]
            - decl: [idx, i32, 0]
            - decl: [del_x, f32, { /: [{ -: [seg.to_x, seg.from_x] }, { cast: [steps, f32] }] }]
            - decl: [del_y, f32, { /: [{ -: [seg.to_y, seg.from_y] }, { cast: [steps, f32] }] }]
            - while:
                condition: { lt: [idx, steps] }
                body:
                  - decl: [part, f32, { cast: [idx, f32] }]
                  - decl: [dot_x, f32, { +: [seg.from_x, { "*": [del_x, part] }] }]
                  - decl: [dot_y, f32, { +: [seg.from_y, { "*": [del_y, part] }] }]
                  - call: [ui.draw_line, dot_x, dot_y, { +: [dot_x, { "*": [del_x, 0.55] }] }, { +: [dot_y, { "*": [del_y, 0.55] }] }, seg.thick, seg.tint]
                  - set: [idx, { +: [idx, 2] }]
