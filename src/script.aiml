# Driving the editor from a file (doc/spec/chart.md §9.1).
#
# The engine can post input events (aiml spec/44_0 §post_*), so a test can click and
# type IN PROCESS -- no X11 robot, no screen-scraping, and the same code path a hand
# takes.  A step runs per frame, because that is how a hand's input arrives too: a
# press and the release after it are different frames, and anything that collapses
# them tests something the editor never sees.
#
# Coordinates are SLIDE units, not window pixels: a test that hard-codes pixels breaks
# when the window size changes, and then it is testing the window manager.
- import: "src/sheet_model.aiml"
- import: "src/topbar.aiml"
- import: "src/toolbar.aiml"

- class:
    name: Script
    description: "A list of input steps, one per frame (spec §9.1)"
    members:
      # The strips, so a test can name a menu entry instead of a pixel.  Twice now a
      # new entry moved every coordinate in every script and three tests broke
      # without anything being wrong -- a test that measures the layout is testing
      # the wrong thing (spec §9.1).
      - [top_bar, ref<TopBar>]
      - [tools, ref<ToolBar>]
      - [steps, list<string>]
      - [step_at, i32]            # the next step
      - [waiting, i32]            # frames still to idle
      - [arg, string]             # the file name of a `shot` step
      - [shot_due, i32]           # 1 = capture at the END of this frame
      - [running, i32]
      - [last_x, f32]             # where the pointer was put, in window pixels
      - [last_y, f32]
      - [warm, i32]               # frames to let the window settle first
    methods:
      - def:
          name: load
          static_off: ["same_arg", "str_cmp"]
          args: [[path, string]]
          return: i32
          body:
            - decl: [handle, file_handle, { call: [io.open, path, "r"] }]
            - if:
                condition: { eq: [handle, null] }
                then:
                  - call: [log.error, "chart: ${path}: Skript nicht lesbar"]
                  - return: 0
            - decl: [text, string, { call: [io.read_all, handle] }]
            - call: [io.close, handle]
            - decl: [lines, list<string>, { call: [text.split, "\n"] }]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, lines.len] }
                body:
                  - decl: [raw, string, { at: [lines, idx] }]
                  - decl: [line, string, { call: [raw.trim] }]
                  - set: [idx, { +: [idx, 1] }]
                  # aiml has no `continue`: a `return` here would end the WHOLE load
                  # at the first blank line, which is what it did for one build
                  - decl: [keep, i32, 1]
                  - if: { condition: { eq: [line, ""] }, then: [{ set: [keep, 0] }] }
                  - if: { condition: { eq: [{ call: [line.starts_with, "#"] }, 1] }, then: [{ set: [keep, 0] }] }
                  - if: { condition: { eq: [keep, 1] }, then: [{ call: [<.steps.push, line] }] }
            - set: [<.running, 1]
            - set: [<.step_at, 0]
            # The window needs a few frames to map, and mapping produces real input:
            # a focus event, an enter event, a cursor position.  A script that starts
            # before that is overwritten by it -- which looked like "works with
            # --diag, does nothing without", because the logging slowed the frames
            # down enough to hide it.
            - set: [<.warm, 20]
            - return: 1

      # The word before the first space, and what follows it.
      - def:
          name: head_of
          static_off: ["same_arg", "str_cmp"]
          args: [[line, string]]
          return: string
          body:
            - decl: [space, i32, { call: [line.index_of, " "] }]
            - if: { condition: { lt: [space, 0] }, then: [{ return: line }] }
            - return: { call: [line.substr, 0, space] }

      - def:
          name: rest_of
          static_off: ["same_arg", "str_cmp"]
          args: [[line, string]]
          return: string
          body:
            - decl: [space, i32, { call: [line.index_of, " "] }]
            - if: { condition: { lt: [space, 0] }, then: [{ return: "" }] }
            - decl: [after, i32, { +: [space, 1] }]
            - decl: [tail, string, { call: [line.substr, after, { -: [line.len, after] }] }]
            - return: { call: [tail.trim] }

      - def:
          name: number_at
          static_off: ["same_arg", "str_cmp"]
          args: [[text, string], [which, i32]]
          return: f32
          body:
            - decl: [parts, list<string>, { call: [text.split, " "] }]
            - if: { condition: { ge: [which, parts.len] }, then: [{ return: 0.0 }] }
            - decl: [one, string, { at: [parts, which] }]
            - return: { call: [one.parse_f32] }

      # Insert the six steps a menu pick really is -- move, press, release, twice --
      # so every one of them still goes through the editor's own input path.
      - def:
          name: queue_click
          args: [[at_x, f32], [at_y, f32], [where, i32]]
          return: i32
          body:
            - call: [<.steps.insert, where, "at_win ${ { cast: [at_x, i32] } } ${ { cast: [at_y, i32] } }"]
            - call: [<.steps.insert, { +: [where, 1] }, "down 0"]
            - call: [<.steps.insert, { +: [where, 2] }, "up 0"]
            - return: { +: [where, 3] }

      - def:
          name: open_menu
          static_off: ["same_arg", "str_cmp"]
          args: [[rest, string]]
          return: i32
          body:
            - decl: [split, i32, { call: [rest.index_of, "|"] }]
            - if:
                condition: { lt: [split, 0] }
                then:
                  - call: [log.error, "chart: 'menu' will MENUE|Eintrag, bekam '${rest}'"]
                  - set: [<.running, 0]
                  - return: 4
            - decl: [after, i32, { +: [split, 1] }]
            # two locals: a flow mapping cannot carry a chained `.trim` (YAML)
            - decl: [menu_raw, string, { call: [rest.substr, 0, split] }]
            - decl: [entry_raw, string, { call: [rest.substr, after, { -: [rest.len, after] }] }]
            - decl: [want_menu, string, { call: [menu_raw.trim] }]
            - decl: [want_entry, string, { call: [entry_raw.trim] }]
            - decl: [names, list<string>, { call: [<.top_bar.titles] }]
            - decl: [which, i32, -1]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, names.len] }
                body:
                  - if: { condition: { eq: [{ at: [names, idx] }, want_menu] }, then: [{ set: [which, idx] }] }
                  - set: [idx, { +: [idx, 1] }]
            - if:
                condition: { lt: [which, 0] }
                then:
                  - call: [log.error, "chart: kein Menue '${want_menu}' in der Leiste"]
                  - set: [<.running, 0]
                  - return: 4
            - decl: [items, list<string>, { call: [<.top_bar.entries_of, which] }]
            - decl: [row, i32, -1]
            - set: [idx, 0]
            - while:
                condition: { lt: [idx, items.len] }
                body:
                  # trimmed on both sides: the slide list marks the current slide
                  # with "> ", so its labels carry leading blanks
                  - decl: [shown, string, { call: [<.top_bar.label_of, { at: [items, idx] }] }]
                  - decl: [tidy, string, { call: [shown.trim] }]
                  - if: { condition: { eq: [tidy, want_entry] }, then: [{ set: [row, idx] }] }
                  - set: [idx, { +: [idx, 1] }]
            - if:
                condition: { lt: [row, 0] }
                then:
                  - call: [log.error, "chart: kein Eintrag '${want_entry}' im Menue '${want_menu}'"]
                  - set: [<.running, 0]
                  - return: 4
            - decl: [left, f32, { call: [<.top_bar.title_x, which] }]
            - decl: [tall, f32, { call: [<.top_bar.height] }]
            - decl: [where, i32, { call: [<.queue_click, { +: [left, 6.0] }, { /: [tall, 2.0] }, <.step_at] }]
            - decl: [row_y, f32, { +: [{ +: [tall, 4.0] }, { +: [{ "*": [{ cast: [row, f32] }, 24.0] }, 12.0] }] }]
            - call: [<.queue_click, { +: [left, 20.0] }, row_y, where]
            - return: 1

      - def:
          name: pick_tool
          static_off: ["same_arg", "str_cmp"]
          args: [[rest, string]]
          return: i32
          body:
            - decl: [want, string, { call: [rest.trim] }]
            - decl: [names, list<string>, { call: [<.tools.shapes] }]
            - decl: [which, i32, -1]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, names.len] }
                body:
                  - if:
                      condition: { eq: [{ call: [<.tools.label_of, { at: [names, idx] }] }, want] }
                      then: [{ set: [which, idx] }]
                  - set: [idx, { +: [idx, 1] }]
            - if:
                condition: { lt: [which, 0] }
                then:
                  - call: [log.error, "chart: kein Werkzeug '${want}' in der Leiste"]
                  - set: [<.running, 0]
                  - return: 4
            - decl: [left, f32, { call: [<.tools.shape_x, which] }]
            - decl: [top, f32, { +: [{ call: [<.top_bar.height] }, { /: [{ call: [<.tools.height] }, 2.0] }] }]
            - call: [<.queue_click, { +: [left, 10.0] }, top, <.step_at]
            - return: 1

      # One step, or none when the script is waiting.  Returns:
      #   0 nothing to do   1 handled   2 save   3 shot (<.arg)   4 finished
      - def:
          name: tick
          static_off: ["same_arg", "str_cmp"]
          args: [[org_x, f32], [org_y, f32], [scale, f32]]
          return: i32
          body:
            - if: { condition: { eq: [<.running, 0] }, then: [{ return: 4 }] }
            - if:
                condition: { gt: [<.warm, 0] }
                then:
                  - set: [<.warm, { -: [<.warm, 1] }]
                  - return: 0
            - if:
                condition: { gt: [<.waiting, 0] }
                then:
                  - set: [<.waiting, { -: [<.waiting, 1] }]
                  - return: 0
            - if:
                condition: { ge: [<.step_at, <.steps.len] }
                then:
                  - set: [<.running, 0]
                  - return: 4
            - decl: [line, string, { at: [<.steps, <.step_at] }]
            - set: [<.step_at, { +: [<.step_at, 1] }]
            - decl: [word, string, { call: [<.head_of, line] }]
            - decl: [rest, string, { call: [<.rest_of, line] }]

            # `at X Y` -- slide units, converted the way the canvas converts them
            - if:
                condition: { eq: [word, "at"] }
                then:
                  - decl: [slide_x, f32, { call: [<.number_at, rest, 0] }]
                  - decl: [slide_y, f32, { call: [<.number_at, rest, 1] }]
                  - set: [<.last_x, { +: [org_x, { "*": [slide_x, scale] }] }]
                  - set: [<.last_y, { +: [org_y, { "*": [slide_y, scale] }] }]
                  - call: [input.post_mouse_move, <.last_x, <.last_y]
                  - return: 1
            # `at_win X Y` -- window pixels, for the action bar
            - if:
                condition: { eq: [word, "at_win"] }
                then:
                  - set: [<.last_x, { call: [<.number_at, rest, 0] }]
                  - set: [<.last_y, { call: [<.number_at, rest, 1] }]
                  - call: [input.post_mouse_move, <.last_x, <.last_y]
                  - return: 1
            - if:
                condition: { eq: [word, "down"] }
                then:
                  - call: [input.post_mouse_move, <.last_x, <.last_y]
                  - call: [input.post_mouse_down, { cast: [{ call: [<.number_at, rest, 0] }, i32] }]
                  - return: 1
            - if:
                condition: { eq: [word, "up"] }
                then:
                  - call: [input.post_mouse_move, <.last_x, <.last_y]
                  - call: [input.post_mouse_up, { cast: [{ call: [<.number_at, rest, 0] }, i32] }]
                  - return: 1
            - if: { condition: { eq: [word, "key"] }, then: [{ call: [input.post_key_down, rest] }, { call: [input.post_key_up, rest] }, { return: 1 }] }
            - if: { condition: { eq: [word, "hold"] }, then: [{ call: [input.post_key_repeat, rest] }, { return: 1 }] }
            - if: { condition: { eq: [word, "type"] }, then: [{ call: [input.post_text, rest] }, { return: 1 }] }
            - if:
                condition: { eq: [word, "wait"] }
                then:
                  - set: [<.waiting, { cast: [{ call: [<.number_at, rest, 0] }, i32] }]
                  - return: 1
            # `menu Datei|Speichern` and `tool Raute`: the step names what it wants
            # and the strip says where that is, this frame, at this window size.
            - if:
                condition: { eq: [word, "menu"] }
                then: [{ return: { call: [<.open_menu, rest] } }]
            - if:
                condition: { eq: [word, "tool"] }
                then: [{ return: { call: [<.pick_tool, rest] } }]
            - if: { condition: { eq: [word, "save"] }, then: [{ return: 2 }] }
            - if:
                condition: { eq: [word, "shot"] }
                then:
                  - set: [<.arg, rest]
                  # the frame has not been drawn yet when a step runs (§9.1): a
                  # capture here would be of a cleared buffer, which is what the
                  # first all-dark screenshot was
                  - set: [<.shot_due, 1]
                  - return: 3
            # An unknown step is an error, not a shrug: a test that silently skipped
            # half its steps would pass while checking nothing.
            - call: [log.error, "chart: Skriptschritt unbekannt: '${line}'"]
            - set: [<.running, 0]
            - return: 4
