# Projecting a Sheet to Mermaid (doc/spec/chart.md §5).  Pure: same sheet in, same
# bytes out (§2) -- which is why the output order in §5.5a is fixed, not incidental.
- import: "src/sheet_model.aiml"
- import: "src/seq.aiml"

- class:
    name: MermaidOut
    description: "The lossy projection of a sheet; never read back as the document"
    members:
      - [seq, ref<SeqLayout>]      # borrow, wired by the classgroup: the column order
    methods:
      # Label text.  Quoted unconditionally by the caller, so only the quote itself
      # and the line break need handling (spec §5.2).
      - def:
          name: esc
          static_off: ["same_arg", "str_cmp"]
          args: [[text, string]]
          return: string
          body:
            - decl: [flat, string, { call: [text.replace, "\"", "#quot;"] }]
            - set: [flat, { call: [flat.replace, "\n", "<br/>"] }]
            - return: flat

      - def:
          name: hex2
          args: [[value, i32]]
          return: string
          body:
            - decl: [digits, string, "0123456789abcdef"]
            - decl: [high, i32, { /: [value, 16] }]
            - decl: [low, i32, { -: [value, { "*": [high, 16] }] }]
            - decl: [hi_text, string, { call: [digits.substr, high, 1] }]
            - decl: [lo_text, string, { call: [digits.substr, low, 1] }]
            - return: "${hi_text}${lo_text}"

      # 0xRRGGBBAA -> "#rrggbb".  Masked after the shift, so the sign bits of a
      # negative i32 (every colour with alpha >= 0x80) cannot leak into a digit.
      - def:
          name: hex6
          args: [[color, i32]]
          return: string
          body:
            - decl: [red, i32, { band: [{ shr: [color, 24] }, 255] }]
            - decl: [green, i32, { band: [{ shr: [color, 16] }, 255] }]
            - decl: [blue, i32, { band: [{ shr: [color, 8] }, 255] }]
            - decl: [red_text, string, { call: [<.hex2, red] }]
            - decl: [green_text, string, { call: [<.hex2, green] }]
            - decl: [blue_text, string, { call: [<.hex2, blue] }]
            - return: "#${red_text}${green_text}${blue_text}"

      # "" when the node inherits the theme, else a key identifying the colour pair.
      - def:
          name: color_key
          args: [[node, Node]]
          return: string
          body:
            # Both must be 0.  A sum would call fill == -stroke "no colour".
            - if:
                condition: { eq: [node.fill, 0] }
                then:
                  - if:
                      condition: { "&&": [{ eq: [node.stroke, 0] }, { eq: [node.ink, 0] }] }
                      then: [{ return: "" }]
            - return: "${node.fill}:${node.stroke}:${node.ink}"

      # Bold and italic go in as a MARKDOWN STRING -- backticks inside the quotes,
      # `**` and `_` around the text.  That is the documented way (flowDb's
      # `sanitizeNodeLabelType`); `classDef font-weight:bold` is NOT, because only
      # entries matching /color/ reach the label.  Underlining has no form at all
      # and is a declared loss (spec §5.6a, §5.7).
      # Only what is actually set.  A node that carries just a text colour used to
      # get `fill:#000000,stroke:#000000` as well -- 0 means "inherit the theme"
      # (§5.6), and writing it out as black turned the box black.
      - def:
          name: paint_props
          static_off: ["same_arg", "str_cmp"]
          args: [[fill, i32], [stroke, i32], [ink, i32]]
          return: string
          body:
            - decl: [out, string, ""]
            - if:
                condition: { neq: [fill, 0] }
                then: [{ set: [out, "fill:${ { call: [<.hex6, fill] } }"] }]
            - if:
                condition: { neq: [stroke, 0] }
                then:
                  - if: { condition: { neq: [out, ""] }, then: [{ set: [out, "${out},"] }] }
                  - set: [out, "${out}stroke:${ { call: [<.hex6, stroke] } }"]
            - if:
                condition: { neq: [ink, 0] }
                then:
                  - if: { condition: { neq: [out, ""] }, then: [{ set: [out, "${out},"] }] }
                  - set: [out, "${out}color:${ { call: [<.hex6, ink] } }"]
            - return: out

      - def:
          name: marked
          static_off: ["same_arg", "str_cmp"]
          args: [[label, string], [deco, i32]]
          return: string
          body:
            - decl: [bold, i32, { band: [deco, 1] }]
            - decl: [ital, i32, { band: [deco, 2] }]
            - if: { condition: { "&&": [{ eq: [bold, 0] }, { eq: [ital, 0] }] }, then: [{ return: label }] }
            - decl: [body, string, label]
            - if: { condition: { neq: [ital, 0] }, then: [{ set: [body, "_${body}_"] }] }
            - if: { condition: { neq: [bold, 0] }, then: [{ set: [body, "**${body}**"] }] }
            - decl: [tick, string, "`"]
            - return: "${tick}${body}${tick}"

      - def:
          name: node_decl
          static_off: ["same_arg", "str_cmp"]
          args: [[node, Node]]
          return: string
          body:
            - decl: [label, string, { call: [<.marked, { call: [<.esc, node.text] }, node.deco] }]
            - if: { condition: { eq: [node.kind, NodeKind.round] },      then: [{ return: "${node.ident}(\"${label}\")" }] }
            - if: { condition: { eq: [node.kind, NodeKind.stadium] },    then: [{ return: "${node.ident}([\"${label}\"])" }] }
            - if: { condition: { eq: [node.kind, NodeKind.circle] },     then: [{ return: "${node.ident}((\"${label}\"))" }] }
            - if: { condition: { eq: [node.kind, NodeKind.diamond] },    then: [{ return: "${node.ident}{\"${label}\"}" }] }
            - if: { condition: { eq: [node.kind, NodeKind.hexagon] },    then: [{ return: "${node.ident}{{\"${label}\"}}" }] }
            - if: { condition: { eq: [node.kind, NodeKind.cylinder] },   then: [{ return: "${node.ident}[(\"${label}\")]" }] }
            - if: { condition: { eq: [node.kind, NodeKind.subroutine] }, then: [{ return: "${node.ident}[[\"${label}\"]]" }] }
            - if: { condition: { eq: [node.kind, NodeKind.asymmetric] }, then: [{ return: "${node.ident}>\"${label}\"]" }] }
            - if: { condition: { eq: [node.kind, NodeKind.trapezoid] }, then: [{ return: "${node.ident}[/\"${label}\"\\]" }] }
            - if: { condition: { eq: [node.kind, NodeKind.trapezoid_alt] }, then: [{ return: "${node.ident}[\\\"${label}\"/]" }] }
            - if: { condition: { eq: [node.kind, NodeKind.parallelogram] }, then: [{ return: "${node.ident}[/\"${label}\"/]" }] }
            - if: { condition: { eq: [node.kind, NodeKind.parallelogram_alt] }, then: [{ return: "${node.ident}[\\\"${label}\"\\]" }] }
            - if: { condition: { eq: [node.kind, NodeKind.double_circle] }, then: [{ return: "${node.ident}(((\"${label}\")))" }] }
            # Mermaid has no actor (§5.7): a stadium is the nearest, and a drawn actor
            # must not vanish on export
            - if: { condition: { eq: [node.kind, NodeKind.actor] }, then: [{ return: "${node.ident}([\"${label}\"])" }] }
            - return: "${node.ident}[\"${label}\"]"

      # One node line at `depth`, with its colour class appended when it has one.
      - def:
          name: node_line
          static_off: ["same_arg", "str_cmp"]
          args: [[node, Node], [depth, i32], [class_of, map<string:string>]]
          return: string
          body:
            # §5.7: prose is not part of the graph.  Leaving it out beats inventing a
            # box around a paragraph that nobody drew.
            - if: { condition: { eq: [node.kind, NodeKind.text] }, then: [{ return: "" }] }
            - decl: [pad, string, ""]
            - decl: [step, i32, 0]
            - while:
                condition: { lt: [step, depth] }
                body:
                  - set: [pad, "${pad}    "]
                  - set: [step, { +: [step, 1] }]
            - decl: [decl_text, string, { call: [<.node_decl, node] }]
            - decl: [key, string, { call: [<.color_key, node] }]
            - if:
                condition: { eq: [{ call: [class_of.contains, key] }, 1] }
                then:
                  - decl: [cls, string, { call: [class_of.get, key] }]
                  - return: "${pad}${decl_text}:::${cls}\n"
            - return: "${pad}${decl_text}\n"

      # The pipe form carries every label, so one quoting rule covers them all (§5.3).
      - def:
          name: edge_line
          static_off: ["same_arg", "str_cmp"]
          args: [[edge, Edge]]
          return: string
          body:
            # Composed from the line and the two caps (§5.3), not looked up whole.
            - decl: [link, string, { call: [<.connector, edge] }]
            # An invisible link has no place to put a label, so it loses it (§5.3).
            - if:
                condition: { eq: [edge.line, LineStyle.invisible] }
                then: [{ return: "    ${edge.from_id} ${link} ${edge.to_id}\n" }]
            - if:
                condition: { neq: [edge.text, ""] }
                then:
                  - decl: [label, string, { call: [<.marked, { call: [<.esc, edge.text] }, edge.deco] }]
                  - return: "    ${edge.from_id} ${link}|\"${label}\"| ${edge.to_id}\n"
            - return: "    ${edge.from_id} ${link} ${edge.to_id}\n"

      # line + caps -> the Mermaid connector.  Mermaid cannot mix caps and has no
      # hollow end, so both are degraded here and reported by `emit` -- a silent flip
      # of one end would draw a different diagram than the sheet shows (§5.7).
      - def:
          name: connector
          args: [[edge, Edge]]
          return: string
          body:
            - if: { condition: { eq: [edge.line, LineStyle.invisible] }, then: [{ return: "~~~" }] }
            - decl: [body_text, string, "--"]
            - if: { condition: { eq: [edge.line, LineStyle.dotted] }, then: [{ set: [body_text, "-.-"] }] }
            - if: { condition: { eq: [edge.line, LineStyle.thick] }, then: [{ set: [body_text, "=="] }] }
            - decl: [head_cap, i32, edge.head]
            - if: { condition: { eq: [head_cap, EndCap.hollow] }, then: [{ set: [head_cap, EndCap.arrow] }] }
            - decl: [tail_cap, i32, edge.tail]
            - if: { condition: { eq: [tail_cap, EndCap.hollow] }, then: [{ set: [tail_cap, EndCap.arrow] }] }
            # a mixed pair: the head wins on both ends
            - if:
                condition: { "&&": [{ neq: [tail_cap, EndCap.none] }, { neq: [tail_cap, head_cap] }] }
                then: [{ set: [tail_cap, head_cap] }]
            - decl: [mark_head, string, ""]
            - if: { condition: { eq: [head_cap, EndCap.arrow] }, then: [{ set: [mark_head, ">"] }] }
            - if: { condition: { eq: [head_cap, EndCap.circle] }, then: [{ set: [mark_head, "o"] }] }
            - if: { condition: { eq: [head_cap, EndCap.cross] }, then: [{ set: [mark_head, "x"] }] }
            - decl: [mark_tail, string, ""]
            - if: { condition: { eq: [tail_cap, EndCap.arrow] }, then: [{ set: [mark_tail, "<"] }] }
            - if: { condition: { eq: [tail_cap, EndCap.circle] }, then: [{ set: [mark_tail, "o"] }] }
            - if: { condition: { eq: [tail_cap, EndCap.cross] }, then: [{ set: [mark_tail, "x"] }] }
            # a bare line needs a third dash: `--` alone is not a link
            - if:
                condition: { "&&": [{ eq: [mark_head, ""] }, { eq: [mark_tail, ""] }] }
                then:
                  - if: { condition: { eq: [edge.line, LineStyle.solid] }, then: [{ return: "---" }] }
                  - if: { condition: { eq: [edge.line, LineStyle.thick] }, then: [{ return: "===" }] }
                  - return: "-.-"
            - return: "${mark_tail}${body_text}${mark_head}"

      # One subgraph block: its own nodes, then its nested groups (§5.5).
      - def:
          name: group_block
          static_off: ["same_arg", "str_cmp"]
          args: [[sheet, ref<Sheet>], [group, Group], [depth, i32], [class_of, map<string:string>]]
          return: string
          body:
            - decl: [pad, string, ""]
            - decl: [step, i32, 0]
            - while:
                condition: { lt: [step, depth] }
                body:
                  - set: [pad, "${pad}    "]
                  - set: [step, { +: [step, 1] }]
            - decl: [title, string, { call: [<.esc, group.title] }]
            - decl: [out, string, "${pad}subgraph ${group.ident} [\"${title}\"]\n"]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, sheet.nodes.len] }
                body:
                  - decl: [node, Node, { at: [sheet.nodes, idx] }]
                  - if:
                      condition: { eq: [node.group, group.ident] }
                      then:
                        - set: [out, "${out}${ { call: [<.node_line, node, { +: [depth, 1] }, class_of] } }"]
                  - set: [idx, { +: [idx, 1] }]
            - decl: [gidx, i32, 0]
            - while:
                condition: { lt: [gidx, sheet.groups.len] }
                body:
                  - decl: [child, Group, { at: [sheet.groups, gidx] }]
                  - if:
                      condition: { eq: [child.parent, group.ident] }
                      then:
                        - set: [out, "${out}${ { call: [<.group_block, sheet, child, { +: [depth, 1] }, class_of] } }"]
                  - set: [gidx, { +: [gidx, 1] }]
            - return: "${out}${pad}end\n"

      # The whole projection (§5.5a fixes the order).
      # ── the other three diagram types (spec §5.8) ───────────────────────────
      # Each is its own projection, not a variation of the flowchart: a state
      # chart has terminals, a class diagram has compartments, and a sequence has
      # no positions at all.

      # A state chart (spec §5.8.1).  Positions are stored as in a flowchart; what
      # differs is the vocabulary.
      - def:
          name: emit_state
          static_off: ["same_arg", "str_cmp"]
          args: [[sheet, ref<Sheet>]]
          return: string
          body:
            - decl: [dir_name, string, { call: [enums.name, "Direction", sheet.dir] }]
            - decl: [out, string, "stateDiagram-v2\n    direction ${dir_name}\n"]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, sheet.nodes.len] }
                body:
                  - decl: [node, Node, { at: [sheet.nodes, idx] }]
                  - set: [out, "${out}${ { call: [<.state_decl, node] } }"]
                  - set: [idx, { +: [idx, 1] }]
            - set: [idx, 0]
            - while:
                condition: { lt: [idx, sheet.edges.len] }
                body:
                  - decl: [edge, Edge, { at: [sheet.edges, idx] }]
                  - decl: [from_word, string, { call: [<.state_ref, sheet, edge.from_id] }]
                  - decl: [to_word, string, { call: [<.state_ref, sheet, edge.to_id] }]
                  - set: [out, "${out}    ${from_word} --> ${to_word}"]
                  - if:
                      condition: { neq: [edge.text, ""] }
                      then: [{ set: [out, "${out} : ${ { call: [<.esc, edge.text] } }"] }]
                  - set: [out, "${out}\n"]
                  - set: [idx, { +: [idx, 1] }]
            - return: out

      # A terminal is never declared: it stands as `[*]` wherever an edge touches
      # it (spec §5.8.1), so start and end cannot disagree with the arrows.
      - def:
          name: state_decl
          static_off: ["same_arg", "str_cmp"]
          args: [[node, Node]]
          return: string
          body:
            - if: { condition: { eq: [node.kind, NodeKind.terminal] }, then: [{ return: "" }] }
            # prose has no state to hang on (§5.7)
            - if: { condition: { eq: [node.kind, NodeKind.text] }, then: [{ return: "" }] }
            - if:
                condition: { eq: [node.kind, NodeKind.diamond] }
                then: [{ return: "    state ${node.ident} <<choice>>\n" }]
            - if: { condition: { eq: [node.text, ""] }, then: [{ return: "" }] }
            - return: "    state \"${ { call: [<.esc, node.text] } }\" as ${node.ident}\n"

      - def:
          name: state_ref
          static_off: ["same_arg", "str_cmp"]
          args: [[sheet, ref<Sheet>], [ident, string]]
          return: string
          body:
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, sheet.nodes.len] }
                body:
                  - decl: [node, Node, { at: [sheet.nodes, idx] }]
                  - if:
                      condition: { eq: [node.ident, ident] }
                      then:
                        - if: { condition: { eq: [node.kind, NodeKind.terminal] }, then: [{ return: "[*]" }] }
                        - return: ident
                  - set: [idx, { +: [idx, 1] }]
            - return: ident

      # A class diagram (spec §5.8.2).
      - def:
          name: emit_class
          static_off: ["same_arg", "str_cmp"]
          args: [[sheet, ref<Sheet>]]
          return: string
          body:
            - decl: [out, string, "classDiagram\n"]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, sheet.nodes.len] }
                body:
                  - decl: [node, Node, { at: [sheet.nodes, idx] }]
                  - if:
                      condition: { neq: [node.kind, NodeKind.text] }
                      then:
                        - decl: [name, string, node.text]
                        - if: { condition: { eq: [name, ""] }, then: [{ set: [name, node.ident] }] }
                        - decl: [head, string, "    class ${node.ident}[\"${ { call: [<.esc, name] } }\"]"]
                        - if:
                            condition: { eq: [node.rows.len, 0] }
                            then: [{ set: [out, "${out}${head}\n"] }]
                            else:
                              - set: [out, "${out}${head} {\n"]
                              - decl: [ridx, i32, 0]
                              - while:
                                  condition: { lt: [ridx, node.rows.len] }
                                  body:
                                    - decl: [row, string, { at: [node.rows, ridx] }]
                                    - set: [out, "${out}        ${row}\n"]
                                    - set: [ridx, { +: [ridx, 1] }]
                              - set: [out, "${out}    }\n"]
                  - set: [idx, { +: [idx, 1] }]
            - set: [idx, 0]
            - while:
                condition: { lt: [idx, sheet.edges.len] }
                body:
                  - decl: [edge, Edge, { at: [sheet.edges, idx] }]
                  - set: [out, "${out}${ { call: [<.class_line, edge] } }"]
                  - set: [idx, { +: [idx, 1] }]
            - return: out

      - def:
          name: class_line
          static_off: ["same_arg", "str_cmp"]
          args: [[edge, Edge]]
          return: string
          body:
            - decl: [oper, string, "-->"]
            - if: { condition: { eq: [edge.rel, RelKind.inherit] },   then: [{ set: [oper, "--|>"] }] }
            - if: { condition: { eq: [edge.rel, RelKind.realize] },   then: [{ set: [oper, "..|>"] }] }
            - if: { condition: { eq: [edge.rel, RelKind.compose] },   then: [{ set: [oper, "*--"] }] }
            - if: { condition: { eq: [edge.rel, RelKind.aggregate] }, then: [{ set: [oper, "o--"] }] }
            - if: { condition: { eq: [edge.rel, RelKind.depend] },    then: [{ set: [oper, "..>"] }] }
            - decl: [left, string, edge.from_id]
            - if:
                condition: { neq: [edge.from_text, ""] }
                then: [{ set: [left, "${left} \"${ { call: [<.esc, edge.from_text] } }\""] }]
            - decl: [right, string, edge.to_id]
            - if:
                condition: { neq: [edge.to_text, ""] }
                then: [{ set: [right, "\"${ { call: [<.esc, edge.to_text] } }\" ${right}"] }]
            - decl: [out, string, "    ${left} ${oper} ${right}"]
            - if:
                condition: { neq: [edge.text, ""] }
                then: [{ set: [out, "${out} : ${ { call: [<.esc, edge.text] } }"] }]
            - return: "${out}\n"

      # A sequence (spec §5.8.3).  The participants come from the nodes in x order
      # -- their column -- and the steps are the document, in their own order.
      - def:
          name: emit_sequence
          static_off: ["same_arg", "str_cmp"]
          args: [[sheet, ref<Sheet>]]
          return: string
          body:
            - decl: [out, string, "sequenceDiagram\n"]
            - decl: [order, list<i32>, { call: [<.seq.columns, sheet] }]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, order.len] }
                body:
                  - decl: [node, Node, { at: [sheet.nodes, { at: [order, idx] }] }]
                  - if:
                      condition: { neq: [node.kind, NodeKind.text] }
                      then:
                        - decl: [word, string, "participant"]
                        - if: { condition: { eq: [node.kind, NodeKind.actor] }, then: [{ set: [word, "actor"] }] }
                        - set: [out, "${out}    ${word} ${node.ident}"]
                        - if:
                            condition: { neq: [node.text, ""] }
                            then: [{ set: [out, "${out} as ${ { call: [<.esc, node.text] } }"] }]
                        - set: [out, "${out}\n"]
                  - set: [idx, { +: [idx, 1] }]
            - decl: [depth, i32, 0]
            - set: [idx, 0]
            - while:
                condition: { lt: [idx, sheet.steps.len] }
                body:
                  - decl: [step, Step, { at: [sheet.steps, idx] }]
                  - if:
                      condition: { eq: [step.kind, StepKind.block_close] }
                      then:
                        - if:
                            condition: { le: [depth, 0] }
                            then:
                              - call: [log.error, "chart: step '${step.ident}': 'end' ohne offenen Block (spec §5.8.3)"]
                              - return: ""
                        - set: [depth, { -: [depth, 1] }]
                  - decl: [pad, string, { call: [<.indent, depth] }]
                  - set: [out, "${out}${pad}${ { call: [<.step_line, step] } }"]
                  - if:
                      condition: { eq: [step.kind, StepKind.block_open] }
                      then: [{ set: [depth, { +: [depth, 1] }] }]
                  - set: [idx, { +: [idx, 1] }]
            - if:
                condition: { gt: [depth, 0] }
                then:
                  - call: [log.error, "chart: ${depth} Block(e) ohne 'end' -- Mermaid wuerde etwas zeichnen, nur nicht dieses Diagramm (spec §5.8.3)"]
                  - return: ""
            - return: out

      - def:
          name: indent
          args: [[depth, i32]]
          return: string
          body:
            - decl: [out, string, "    "]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, depth] }
                body:
                  - set: [out, "${out}    "]
                  - set: [idx, { +: [idx, 1] }]
            - return: out

      - def:
          name: step_line
          static_off: ["same_arg", "str_cmp"]
          args: [[step, Step]]
          return: string
          body:
            - if:
                condition: { eq: [step.kind, StepKind.block_close] }
                then: [{ return: "end\n" }]
            - if:
                condition: { eq: [step.kind, StepKind.block_open] }
                then:
                  - decl: [word, string, step.word]
                  - if: { condition: { eq: [word, ""] }, then: [{ set: [word, "loop"] }] }
                  - if: { condition: { eq: [step.text, ""] }, then: [{ return: "${word}\n" }] }
                  - return: "${word} ${ { call: [<.esc, step.text] } }\n"
            - if:
                condition: { eq: [step.kind, StepKind.note] }
                then:
                  - if:
                      condition: { eq: [step.to_id, ""] }
                      then: [{ return: "Note right of ${step.from_id}: ${ { call: [<.esc, step.text] } }\n" }]
                  - return: "Note over ${step.from_id},${step.to_id}: ${ { call: [<.esc, step.text] } }\n"
            - decl: [arrow, string, "->>"]
            - decl: [dotted, i32, 0]
            - if: { condition: { eq: [step.line, LineStyle.dotted] }, then: [{ set: [dotted, 1] }] }
            - if:
                condition: { eq: [dotted, 1] }
                then:
                  - set: [arrow, "-->>"]
                  - if: { condition: { eq: [step.head, EndCap.none] },  then: [{ set: [arrow, "-->"] }] }
                  - if: { condition: { eq: [step.head, EndCap.cross] }, then: [{ set: [arrow, "--x"] }] }
                else:
                  - if: { condition: { eq: [step.head, EndCap.none] },  then: [{ set: [arrow, "->"] }] }
                  - if: { condition: { eq: [step.head, EndCap.cross] }, then: [{ set: [arrow, "-x"] }] }
            - return: "${step.from_id}${arrow}${step.to_id}: ${ { call: [<.esc, step.text] } }\n"

      - def:
          name: emit
          static_off: ["same_arg", "str_cmp"]
          args: [[sheet, ref<Sheet>]]
          return: string
          body:
            # each type is its own projection (spec §5.8)
            - if: { condition: { eq: [sheet.dtype, DiagramType.state] },          then: [{ return: { call: [<.emit_state, sheet] } }] }
            - if: { condition: { eq: [sheet.dtype, DiagramType.class_diagram] },  then: [{ return: { call: [<.emit_class, sheet] } }] }
            - if: { condition: { eq: [sheet.dtype, DiagramType.sequence] },       then: [{ return: { call: [<.emit_sequence, sheet] } }] }
            - decl: [dir_name, string, { call: [enums.name, "Direction", sheet.dir] }]
            - decl: [out, string, "flowchart ${dir_name}\n"]

            # ── colour: a pair used twice or more becomes a class (§5.6) ─────
            - decl: [counts, map<string:i32>]
            - decl: [keys, list<string>]
            - decl: [fills, list<i32>]
            - decl: [strokes, list<i32>]
            - decl: [inks, list<i32>]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, sheet.nodes.len] }
                body:
                  - decl: [node, Node, { at: [sheet.nodes, idx] }]
                  - decl: [key, string, { call: [<.color_key, node] }]
                  # prose is not declared (§5.7), so its colour must not make a
                  # class that nothing then uses
                  - if: { condition: { eq: [node.kind, NodeKind.text] }, then: [{ set: [key, ""] }] }
                  - if:
                      condition: { neq: [key, ""] }
                      then:
                        - if:
                            condition: { eq: [{ call: [counts.contains, key] }, 1] }
                            then:
                              - call: [counts.put, key, { +: [{ call: [counts.get, key] }, 1] }]
                            else:
                              - call: [counts.put, key, 1]
                              - call: [keys.push, key]
                              - call: [fills.push, node.fill]
                              - call: [strokes.push, node.stroke]
                              - call: [inks.push, node.ink]
                  - set: [idx, { +: [idx, 1] }]
            - decl: [class_of, map<string:string>]
            - decl: [class_no, i32, 1]
            - set: [idx, 0]
            - while:
                condition: { lt: [idx, keys.len] }
                body:
                  - decl: [key, string, { at: [keys, idx] }]
                  - if:
                      condition: { ge: [{ call: [counts.get, key] }, 2] }
                      then:
                        - decl: [cls, string, "c${class_no}"]
                        - call: [class_of.put, key, cls]
                        # `color:` is the one text property Mermaid carries to the
                        # label (flowDb's /color/ split), so the ink goes here
                        - decl: [props, string, { call: [<.paint_props, { at: [fills, idx] }, { at: [strokes, idx] }, { at: [inks, idx] }] }]
                        - set: [out, "${out}    classDef ${cls} ${props}\n"]
                        - set: [class_no, { +: [class_no, 1] }]
                  - set: [idx, { +: [idx, 1] }]

            # ── groups, then ungrouped nodes, then edges ─────────────────────
            - set: [idx, 0]
            - while:
                condition: { lt: [idx, sheet.groups.len] }
                body:
                  - decl: [group, Group, { at: [sheet.groups, idx] }]
                  - if:
                      condition: { eq: [group.parent, ""] }
                      then:
                        - set: [out, "${out}${ { call: [<.group_block, sheet, group, 1, class_of] } }"]
                  - set: [idx, { +: [idx, 1] }]
            - set: [idx, 0]
            - while:
                condition: { lt: [idx, sheet.nodes.len] }
                body:
                  - decl: [node, Node, { at: [sheet.nodes, idx] }]
                  - if:
                      condition: { eq: [node.group, ""] }
                      then:
                        - set: [out, "${out}${ { call: [<.node_line, node, 1, class_of] } }"]
                  - set: [idx, { +: [idx, 1] }]
            - set: [idx, 0]
            - while:
                condition: { lt: [idx, sheet.edges.len] }
                body:
                  - decl: [edge, Edge, { at: [sheet.edges, idx] }]
                  - set: [out, "${out}${ { call: [<.edge_line, edge] } }"]
                  - set: [idx, { +: [idx, 1] }]

            # ── one-off colours (§5.6) ──────────────────────────────────────
            - set: [idx, 0]
            - while:
                condition: { lt: [idx, sheet.nodes.len] }
                body:
                  - decl: [node, Node, { at: [sheet.nodes, idx] }]
                  - decl: [key, string, { call: [<.color_key, node] }]
                  - if:
                      condition: { neq: [key, ""] }
                      then:
                        - if:
                            condition: { eq: [{ call: [class_of.contains, key] }, 0] }
                            then:
                              - decl: [props, string, { call: [<.paint_props, node.fill, node.stroke, node.ink] }]
                              - set: [out, "${out}    style ${node.ident} ${props}\n"]
                  - set: [idx, { +: [idx, 1] }]

            # An edge's own colour, as `linkStyle N` -- numbered in declaration order,
            # which is the order the edges were just written (spec §18.2).
            - set: [idx, 0]
            - while:
                condition: { lt: [idx, sheet.edges.len] }
                body:
                  - decl: [edge_c, Edge, { at: [sheet.edges, idx] }]
                  - if:
                      condition: { neq: [edge_c.stroke, 0] }
                      then:
                        - decl: [edge_hex, string, { call: [<.hex6, edge_c.stroke] }]
                        - set: [out, "${out}    linkStyle ${idx} stroke:${edge_hex}\n"]
                  - if:
                      condition: { neq: [edge_c.ink, 0] }
                      then:
                        - decl: [lab_hex, string, { call: [<.hex6, edge_c.ink] }]
                        - set: [out, "${out}    linkStyle ${idx} color:${lab_hex}\n"]
                  - set: [idx, { +: [idx, 1] }]
            - return: out
