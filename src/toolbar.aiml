# The tool strip (doc/spec/chart.md §8.0): the diagram type, then the shapes.
#
# The type sits first because it is the one choice that changes what every other
# control in the strip means.
- import: "src/sheet_model.aiml"

- class:
    name: ToolBar
    description: "Diagram type and the shape palette (spec §8.0)"
    members:
      - [deed, i32]               # the action a click produced, 0 = none
      - [type_open, i32]          # the type dropdown is open
      - [hot, i32]
      - [dtype, i32]              # the type the palette belongs to, set in draw
    methods:
      - def:
          name: height
          return: f32
          body:
            - return: 46.0

      - def:
          name: type_width
          return: f32
          body:
            - return: 190.0

      # The palette IS the diagram type's vocabulary (spec §8.0/§5.8).  Each entry is
      # "Label|action", like the menu strip's: one place decides what a button says
      # AND what it makes, so a renamed button cannot start making something else.
      # A button names what it makes in THAT diagram, not the geometric shape it
      # happens to use -- "Zustand", not "Rund".
      - def:
          name: shapes
          return: list<string>
          body:
            - if:
                condition: { eq: [<.dtype, DiagramType.state] }
                then:
                  - decl: [state_tools, list<string>, ["Zustand|111", "Start/Ende|126", "Wahl|114", "Notiz|119"]]
                  - return: state_tools
            - if:
                condition: { eq: [<.dtype, DiagramType.class_diagram] }
                then:
                  - decl: [class_tools, list<string>, ["Klasse|110", "Schnittstelle|117", "Notiz|119"]]
                  - return: class_tools
            - if:
                condition: { eq: [<.dtype, DiagramType.sequence] }
                then:
                  - decl: [seq_tools, list<string>, ["Teilnehmer|110", "Akteur|126", "Nachricht|19",
                                                     "Notiz|201", "Block|202"]]
                  - return: seq_tools
            - decl: [out, list<string>, ["Kasten|110", "Rund|111", "Kapsel|112", "Kreis|113",
                                         "Raute|114", "Sechseck|115", "Zylinder|116",
                                         "Unterprog.|117", "Bild|118", "Text|119",
                                         "Asym.|120", "Trapez|121", "Trapez2|122",
                                         "Parall.|123", "Parall2|124", "Doppelkr.|125",
                                         "Akteur|126"]]
            - return: out

      - def:
          name: label_of
          static_off: ["same_arg", "str_cmp"]
          args: [[entry, string]]
          return: string
          body:
            - decl: [bar, i32, { call: [entry.index_of, "|"] }]
            - if: { condition: { lt: [bar, 0] }, then: [{ return: entry }] }
            - return: { call: [entry.substr, 0, bar] }

      - def:
          name: action_of
          static_off: ["same_arg", "str_cmp"]
          args: [[entry, string]]
          return: i32
          body:
            - decl: [bar, i32, { call: [entry.index_of, "|"] }]
            - if: { condition: { lt: [bar, 0] }, then: [{ return: 0 }] }
            - decl: [after, i32, { +: [bar, 1] }]
            - decl: [digits, string, { call: [entry.substr, after, { -: [entry.len, after] }] }]
            - return: { call: [digits.parse_i32] }

      - def:
          name: type_words
          return: list<string>
          body:
            - decl: [out, list<string>, ["Flussdiagramm", "Sequenz", "Zustand", "Klassen"]]
            - return: out

      # Measured like the menu titles (§8.0): "Unterprog." ran out of its 80 px
      # button and into the next one.
      - def:
          name: shape_w
          static_off: ["same_arg", "str_cmp"]
          args: [[which, i32]]
          return: f32
          body:
            - decl: [names, list<string>, { call: [<.shapes] }]
            - if: { condition: { ge: [which, names.len] }, then: [{ return: 0.0 }] }
            - decl: [name, string, { call: [<.label_of, { at: [names, which] }] }]
            - decl: [wide, f32, { +: [{ call: [ui.measure_text, name] }, 18.0] }]
            - if: { condition: { lt: [wide, 64.0] }, then: [{ set: [wide, 64.0] }] }
            - return: wide

      - def:
          name: shape_x
          static_off: ["same_arg", "str_cmp"]
          args: [[which, i32]]
          return: f32
          body:
            - decl: [cursor, f32, { +: [{ call: [<.type_width] }, 16.0] }]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, which] }
                body:
                  - set: [cursor, { +: [cursor, { +: [{ call: [<.shape_w, idx] }, 6.0] }] }]
                  - set: [idx, { +: [idx, 1] }]
            - return: cursor

      - def:
          name: draw
          static_off: ["same_arg", "str_cmp"]
          args: [[win_w, f32], [top, f32], [dtype, i32], [at_x, f32], [at_y, f32]]
          body:
            - set: [<.dtype, dtype]
            - decl: [tall, f32, { call: [<.height] }]
            - call: [ui.draw_rect, 0.0, top, win_w, tall, 0x1E2A36FF]
            - call: [ui.draw_rect, 0.0, { -: [{ +: [top, tall] }, 1.0] }, win_w, 1.0, 0x2A3744FF]
            # the diagram type, first (§8.0)
            - decl: [words, list<string>, { call: [<.type_words] }]
            - decl: [word, string, "Flussdiagramm"]
            - if: { condition: { lt: [dtype, words.len] }, then: [{ set: [word, { at: [words, dtype] }] }] }
            - call: [ui.draw_rect, 8.0, { +: [top, 8.0] }, { call: [<.type_width] }, { -: [tall, 16.0] }, 0x24354AFF]
            - call: [ui.draw_text, 18.0, { +: [top, 14.0] }, "${word}  v", 0xD8E2ECFF]
            - decl: [names, list<string>, { call: [<.shapes] }]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, names.len] }
                body:
                  - decl: [name, string, { call: [<.label_of, { at: [names, idx] }] }]
                  - decl: [left, f32, { call: [<.shape_x, idx] }]
                  - decl: [wide, f32, { call: [<.shape_w, idx] }]
                  - if:
                      condition: { lt: [{ +: [left, wide] }, win_w] }
                      then:
                        - decl: [over, i32, 0]
                        - if:
                            condition: { "&&": [{ ge: [at_x, left] }, { lt: [at_x, { +: [left, wide] }] }] }
                            then:
                              - if:
                                  condition: { "&&": [{ ge: [at_y, top] }, { lt: [at_y, { +: [top, tall] }] }] }
                                  then: [{ set: [over, 1] }]
                        - decl: [paint, i32, 0x24354AFF]
                        - if: { condition: { eq: [over, 1] }, then: [{ set: [paint, 0x2F4A68FF] }] }
                        - call: [ui.draw_rect, left, { +: [top, 8.0] }, wide, { -: [tall, 16.0] }, paint]
                        - call: [ui.draw_text, { +: [left, 9.0] }, { +: [top, 14.0] }, name, 0xD8E2ECFF]
                  - set: [idx, { +: [idx, 1] }]
            - if: { condition: { eq: [<.type_open, 1] }, then: [{ call: [<.draw_types, top, at_x, at_y] }] }

      - def:
          name: draw_types
          static_off: ["same_arg", "str_cmp"]
          args: [[top, f32], [at_x, f32], [at_y, f32]]
          body:
            - decl: [words, list<string>, { call: [<.type_words] }]
            - decl: [first, f32, { +: [top, { call: [<.height] }] }]
            - call: [ui.draw_rect, 8.0, first, { call: [<.type_width] }, { +: [{ "*": [{ cast: [words.len, f32] }, 24.0] }, 8.0] }, 0x1E2A36FF]
            - call: [ui.draw_rect, 8.0, first, { call: [<.type_width] }, 2.0, 0x2F80EDFF]
            - set: [<.hot, -1]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, words.len] }
                body:
                  - decl: [word, string, { at: [words, idx] }]
                  - decl: [row_y, f32, { +: [{ +: [first, 4.0] }, { "*": [{ cast: [idx, f32] }, 24.0] }] }]
                  - decl: [over, i32, 0]
                  - if:
                      condition: { "&&": [{ ge: [at_x, 8.0] }, { lt: [at_x, { +: [8.0, { call: [<.type_width] }] }] }] }
                      then:
                        - if:
                            condition: { "&&": [{ ge: [at_y, row_y] }, { lt: [at_y, { +: [row_y, 24.0] }] }] }
                            then: [{ set: [over, 1] }, { set: [<.hot, idx] }]
                  - if: { condition: { eq: [over, 1] }, then: [{ call: [ui.draw_rect, 8.0, row_y, { call: [<.type_width] }, 24.0, 0x2F4A68FF] }] }
                  - call: [ui.draw_text, 18.0, { +: [row_y, 4.0] }, word, 0xD8E2ECFF]
                  - set: [idx, { +: [idx, 1] }]

      # Returns 1 when the press was ours.  The action comes from the entry itself
      # (§8.3): 110+NodeKind arms a shape, 70+n picks a diagram type, and a palette
      # may carry an action that is not a shape at all -- a sequence's "Nachricht"
      # arms the connect gesture.
      - def:
          name: press
          static_off: ["same_arg", "str_cmp"]
          args: [[at_x, f32], [at_y, f32], [top, f32]]
          return: i32
          body:
            - set: [<.deed, 0]
            - decl: [tall, f32, { call: [<.height] }]
            - if:
                condition: { eq: [<.type_open, 1] }
                then:
                  - if:
                      condition: { ge: [<.hot, 0] }
                      then:
                        - set: [<.deed, { +: [70, <.hot] }]
                        - set: [<.type_open, 0]
                        - return: 1
                  - set: [<.type_open, 0]
                  - return: 1
            - if: { condition: { lt: [at_y, top] }, then: [{ return: 0 }] }
            - if: { condition: { ge: [at_y, { +: [top, tall] }] }, then: [{ return: 0 }] }
            - if:
                condition: { lt: [at_x, { +: [8.0, { call: [<.type_width] }] }] }
                then:
                  - set: [<.type_open, 1]
                  - return: 1
            - decl: [names, list<string>, { call: [<.shapes] }]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, names.len] }
                body:
                  - decl: [left, f32, { call: [<.shape_x, idx] }]
                  - decl: [wide, f32, { call: [<.shape_w, idx] }]
                  - if:
                      condition: { "&&": [{ ge: [at_x, left] }, { lt: [at_x, { +: [left, wide] }] }] }
                      then:
                        - set: [<.deed, { call: [<.action_of, { at: [names, idx] }] }]
                        - return: 1
                  - set: [idx, { +: [idx, 1] }]
            - return: 1
