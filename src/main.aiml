# chart -- a drawing surface that writes Mermaid (doc/spec/chart.md).
- import: "src/editor.aiml"

- def:
    name: usage
    body:
      - call: [log.error, "usage: chart (--deck FILE | --sheet FILE) [--mermaid OUT.mmd] [--markdown DIR]"]
      - call: [log.error, "       without an output option the editor opens (spec §15)"]
      - call: [log.error, "       --frames N --shot FILE.png: N frames, capture the last one"]

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [options, ChartOptions]
      - call: [sys.arg_dump, options]
      - decl: [input, string, options.deck]
      - if: { condition: { eq: [input, ""] }, then: [{ set: [input, options.sheet] }] }
      - if:
          condition: { eq: [input, ""] }
          then:
            - call: [usage]
            - return: 2
      - decl: [runtime, ptr<ChartRuntime>, { new: ChartRuntime }]
      - decl: [code, i32, 0]
      - if:
          condition: { eq: [options.mermaid, ""] }
          then:
            - if:
                condition: { eq: [options.markdown, ""] }
                then: [{ set: [code, { call: [runtime.editor.run, input, options.frames, options.shot, options] }] }]
                else: [{ set: [code, { call: [runtime.exporter.run, options] }] }]
          else: [{ set: [code, { call: [runtime.exporter.run, options] }] }]
      - free: runtime
      - return: code
