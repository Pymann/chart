# chart -- a drawing surface that writes Mermaid (doc/spec/chart.md).
- import: "src/editor.aiml"

- def:
    name: usage
    body:
      - call: [log.error, "usage: chart (--deck FILE | --sheet FILE) [OUTPUT ...]"]
      - call: [log.error, "       outputs: --mermaid OUT.mmd  --markdown DIR  --svg DIR  --html OUT.html  --pptx OUT.pptx"]
      - call: [log.error, "       without an output option the editor opens (spec §15)"]
      - call: [log.error, "       --frames N --shot FILE.png: N frames, capture the last one"]

- def:
    name: main
    static_off: ["str_cmp"]
    return: i32
    body:
      - decl: [options, ChartOptions]
      - call: [sys.arg_dump, options]
      - decl: [input, string, options.deck]
      - if: { condition: { eq: [input, ""] }, then: [{ set: [input, options.sheet] }] }
      - if:
          condition: { eq: [input, ""] }
          then:
            - call: [usage]
            - return: 2
      - decl: [runtime, ptr<ChartRuntime>, { new: ChartRuntime }]
      - decl: [code, i32, 0]
      # Any output option makes this a headless pass; without one the editor opens.
      - decl: [exporting, i32, 0]
      - if: { condition: { neq: [options.mermaid, ""] }, then: [{ set: [exporting, 1] }] }
      - if: { condition: { neq: [options.markdown, ""] }, then: [{ set: [exporting, 1] }] }
      - if: { condition: { neq: [options.svg, ""] }, then: [{ set: [exporting, 1] }] }
      - if: { condition: { neq: [options.html, ""] }, then: [{ set: [exporting, 1] }] }
      - if: { condition: { neq: [options.pptx, ""] }, then: [{ set: [exporting, 1] }] }
      - if:
          condition: { eq: [exporting, 1] }
          then: [{ set: [code, { call: [runtime.exporter.run, options] }] }]
          else: [{ set: [code, { call: [runtime.editor.run, input, options.frames, options.shot, options] }] }]
      - free: runtime
      - return: code
