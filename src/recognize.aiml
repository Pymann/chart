# Stroke recognition (doc/spec/chart.md §7) and straightening (§7.6).
#
# A PURE function over a point list (§7.1, normative): no engine state, no frame, no
# window. That is what makes it testable without a display -- a recogniser entangled
# with the draw loop can only be checked by hand, and then it is tuned blind.
- import: "src/sheet_model.aiml"

- model:
    name: Guess
    description: "What a stroke was taken for, and the box it straightens to (§7.6)"
    fields:
      - [kind, NodeKind, NodeKind.rect]
      - [found, i32, 0]               # 0 = no match; the stroke is discarded (§7.3 row 7)
      - [pos_x, f32, 0.0]             # straightened, axis-aligned box
      - [pos_y, f32, 0.0]
      - [width, f32, 0.0]
      - [height, f32, 0.0]
      - [closed, f32, 0.0]            # features, kept for the test to assert on
      - [fill, f32, 0.0]
      - [turn, f32, 0.0]
      - [corners, i32, 0]
      # open strokes: where the line really ends, and whether a head was drawn
      - [has_head, i32, 0]
      - [tip_x, f32, 0.0]
      - [tip_y, f32, 0.0]

- class:
    name: Recognizer
    description: "Points in, a shape and a box out; nothing else is touched"
    methods:
      - def:
          name: path_length
          args: [[pts, buffer<f32>], [count, i32]]
          return: f32
          body:
            - decl: [total, f32, 0.0]
            - decl: [idx, i32, 1]
            - while:
                condition: { lt: [idx, count] }
                body:
                  - decl: [del_x, f32, { -: [{ call: [pts.get, { "*": [idx, 2] }] }, { call: [pts.get, { "*": [{ -: [idx, 1] }, 2] }] }] }]
                  - decl: [del_y, f32, { -: [{ call: [pts.get, { +: [{ "*": [idx, 2] }, 1] }] }, { call: [pts.get, { +: [{ "*": [{ -: [idx, 1] }, 2] }, 1] }] }] }]
                  - set: [total, { +: [total, { call: [math.sqrt, { +: [{ "*": [del_x, del_x] }, { "*": [del_y, del_y] }] }] }] }]
                  - set: [idx, { +: [idx, 1] }]
            - return: total

      # Twice the signed area (shoelace).  |area| / (w*h) is the fill ratio of §7.2.
      - def:
          name: shoelace
          args: [[pts, buffer<f32>], [count, i32]]
          return: f32
          body:
            - decl: [total, f32, 0.0]
            - if: { condition: { lt: [count, 3] }, then: [{ return: 0.0 }] }
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, count] }
                body:
                  - decl: [nxt, i32, { +: [idx, 1] }]
                  - if: { condition: { ge: [nxt, count] }, then: [{ set: [nxt, 0] }] }
                  - decl: [cur_x, f32, { call: [pts.get, { "*": [idx, 2] }] }]
                  - decl: [cur_y, f32, { call: [pts.get, { +: [{ "*": [idx, 2] }, 1] }] }]
                  - decl: [nxt_x, f32, { call: [pts.get, { "*": [nxt, 2] }] }]
                  - decl: [nxt_y, f32, { call: [pts.get, { +: [{ "*": [nxt, 2] }, 1] }] }]
                  - set: [total, { +: [total, { -: [{ "*": [cur_x, nxt_y] }, { "*": [nxt_x, cur_y] }] }] }]
                  - set: [idx, { +: [idx, 1] }]
            - return: { call: [math.abs, { /: [total, 2.0] }] }

      # Sum of absolute turn angles, and the corner count in one pass: a corner is a
      # turn above the threshold, with the next few samples suppressed so one corner
      # is not counted three times.
      - def:
          name: measure_turns
          args: [[pts, buffer<f32>], [count, i32], [out, ref<Guess>]]
          body:
            - decl: [total, f32, 0.0]
            - decl: [corners, i32, 0]
            - decl: [cooldown, i32, 0]
            - decl: [idx, i32, 1]
            - while:
                condition: { lt: [idx, { -: [count, 1] }] }
                body:
                  - decl: [prv_x, f32, { call: [pts.get, { "*": [{ -: [idx, 1] }, 2] }] }]
                  - decl: [prv_y, f32, { call: [pts.get, { +: [{ "*": [{ -: [idx, 1] }, 2] }, 1] }] }]
                  - decl: [cur_x, f32, { call: [pts.get, { "*": [idx, 2] }] }]
                  - decl: [cur_y, f32, { call: [pts.get, { +: [{ "*": [idx, 2] }, 1] }] }]
                  - decl: [nxt_x, f32, { call: [pts.get, { "*": [{ +: [idx, 1] }, 2] }] }]
                  - decl: [nxt_y, f32, { call: [pts.get, { +: [{ "*": [{ +: [idx, 1] }, 2] }, 1] }] }]
                  - decl: [ang_a, f32, { call: [math.atan2, { -: [cur_y, prv_y] }, { -: [cur_x, prv_x] }] }]
                  - decl: [ang_b, f32, { call: [math.atan2, { -: [nxt_y, cur_y] }, { -: [nxt_x, cur_x] }] }]
                  - decl: [diff, f32, { -: [ang_b, ang_a] }]
                  - while: { condition: { gt: [diff, 3.14159265] }, body: [{ set: [diff, { -: [diff, 6.28318531] }] }] }
                  - while: { condition: { lt: [diff, -3.14159265] }, body: [{ set: [diff, { +: [diff, 6.28318531] }] }] }
                  - decl: [mag, f32, { call: [math.abs, diff] }]
                  - set: [total, { +: [total, mag] }]
                  - if:
                      condition: { gt: [cooldown, 0] }
                      then: [{ set: [cooldown, { -: [cooldown, 1] }] }]
                      else:
                        - if:
                            condition: { gt: [mag, 0.87] }
                            then:
                              - set: [corners, { +: [corners, 1] }]
                              - set: [cooldown, 3]
                  - set: [idx, { +: [idx, 1] }]
            - set: [out.turn, total]
            - set: [out.corners, corners]

      # §7.6: the principal axis, from the covariance of the points.  theta = 0 when
      # the shape is near-square -- a square has no principal axis, and without this
      # gate a hand-drawn one jitters through every angle between two redraws.
      - def:
          name: principal_angle
          args: [[pts, buffer<f32>], [count, i32]]
          return: f32
          body:
            - if: { condition: { lt: [count, 3] }, then: [{ return: 0.0 }] }
            - decl: [sum_x, f32, 0.0]
            - decl: [sum_y, f32, 0.0]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, count] }
                body:
                  - set: [sum_x, { +: [sum_x, { call: [pts.get, { "*": [idx, 2] }] }] }]
                  - set: [sum_y, { +: [sum_y, { call: [pts.get, { +: [{ "*": [idx, 2] }, 1] }] }] }]
                  - set: [idx, { +: [idx, 1] }]
            - decl: [mid_x, f32, { /: [sum_x, { cast: [count, f32] }] }]
            - decl: [mid_y, f32, { /: [sum_y, { cast: [count, f32] }] }]
            - decl: [var_xx, f32, 0.0]
            - decl: [var_yy, f32, 0.0]
            - decl: [var_xy, f32, 0.0]
            - set: [idx, 0]
            - while:
                condition: { lt: [idx, count] }
                body:
                  - decl: [off_x, f32, { -: [{ call: [pts.get, { "*": [idx, 2] }] }, mid_x] }]
                  - decl: [off_y, f32, { -: [{ call: [pts.get, { +: [{ "*": [idx, 2] }, 1] }] }, mid_y] }]
                  - set: [var_xx, { +: [var_xx, { "*": [off_x, off_x] }] }]
                  - set: [var_yy, { +: [var_yy, { "*": [off_y, off_y] }] }]
                  - set: [var_xy, { +: [var_xy, { "*": [off_x, off_y] }] }]
                  - set: [idx, { +: [idx, 1] }]
            # eigenvalue ratio gate (§7.6 step 2)
            - decl: [trace, f32, { +: [var_xx, var_yy] }]
            - decl: [root, f32, { call: [math.sqrt, { +: [{ "*": [{ -: [var_xx, var_yy] }, { -: [var_xx, var_yy] }] }, { "*": [4.0, { "*": [var_xy, var_xy] }] }] }] }]
            - decl: [big, f32, { /: [{ +: [trace, root] }, 2.0] }]
            - decl: [small, f32, { /: [{ -: [trace, root] }, 2.0] }]
            - if: { condition: { lt: [small, 0.000001] }, then: [{ set: [small, 0.000001] }] }
            - if: { condition: { lt: [{ /: [big, small] }, 1.25] }, then: [{ return: 0.0 }] }
            - decl: [turn_angle, f32, { "*": [0.5, { call: [math.atan2, { "*": [2.0, var_xy] }, { -: [var_xx, var_yy] }] }] }]
            # fold into [-45, 45] degrees: a rect at 91 degrees is one at 1 with w/h swapped
            - while: { condition: { gt: [turn_angle, 0.785398] }, body: [{ set: [turn_angle, { -: [turn_angle, 1.570796] }] }] }
            - while: { condition: { lt: [turn_angle, -0.785398] }, body: [{ set: [turn_angle, { +: [turn_angle, 1.570796] }] }] }
            - return: turn_angle

      # §7.6 steps 4-5: de-rotate about the centroid, take the bbox THERE, emit the
      # box axis-aligned.  The raw bbox of a tilted rect is larger than the rect --
      # at 10 degrees about 1.16x per axis -- so snapping to it inflates every
      # crooked box, and the more crooked it is the more it grows.
      - def:
          name: straighten
          args: [[pts, buffer<f32>], [count, i32], [out, ref<Guess>]]
          body:
            - if: { condition: { lt: [count, 2] }, then: [{ return: null }] }
            - decl: [turn_angle, f32, { call: [<.principal_angle, pts, count] }]
            - decl: [cos_a, f32, { call: [math.cos, { -: [0.0, turn_angle] }] }]
            - decl: [sin_a, f32, { call: [math.sin, { -: [0.0, turn_angle] }] }]
            - decl: [sum_x, f32, 0.0]
            - decl: [sum_y, f32, 0.0]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, count] }
                body:
                  - set: [sum_x, { +: [sum_x, { call: [pts.get, { "*": [idx, 2] }] }] }]
                  - set: [sum_y, { +: [sum_y, { call: [pts.get, { +: [{ "*": [idx, 2] }, 1] }] }] }]
                  - set: [idx, { +: [idx, 1] }]
            - decl: [mid_x, f32, { /: [sum_x, { cast: [count, f32] }] }]
            - decl: [mid_y, f32, { /: [sum_y, { cast: [count, f32] }] }]
            - decl: [low_x, f32, 1000000.0]
            - decl: [low_y, f32, 1000000.0]
            - decl: [high_x, f32, -1000000.0]
            - decl: [high_y, f32, -1000000.0]
            - set: [idx, 0]
            - while:
                condition: { lt: [idx, count] }
                body:
                  - decl: [off_x, f32, { -: [{ call: [pts.get, { "*": [idx, 2] }] }, mid_x] }]
                  - decl: [off_y, f32, { -: [{ call: [pts.get, { +: [{ "*": [idx, 2] }, 1] }] }, mid_y] }]
                  - decl: [rot_x, f32, { -: [{ "*": [off_x, cos_a] }, { "*": [off_y, sin_a] }] }]
                  - decl: [rot_y, f32, { +: [{ "*": [off_x, sin_a] }, { "*": [off_y, cos_a] }] }]
                  - if: { condition: { lt: [rot_x, low_x] }, then: [{ set: [low_x, rot_x] }] }
                  - if: { condition: { lt: [rot_y, low_y] }, then: [{ set: [low_y, rot_y] }] }
                  - if: { condition: { gt: [rot_x, high_x] }, then: [{ set: [high_x, rot_x] }] }
                  - if: { condition: { gt: [rot_y, high_y] }, then: [{ set: [high_y, rot_y] }] }
                  - set: [idx, { +: [idx, 1] }]
            - decl: [box_w, f32, { -: [high_x, low_x] }]
            - decl: [box_h, f32, { -: [high_y, low_y] }]
            - if: { condition: { lt: [box_w, 60.0] }, then: [{ set: [box_w, 60.0] }] }
            - if: { condition: { lt: [box_h, 36.0] }, then: [{ set: [box_h, 36.0] }] }
            - set: [out.width, box_w]
            - set: [out.height, box_h]
            - set: [out.pos_x, { -: [mid_x, { /: [box_w, 2.0] }] }]
            - set: [out.pos_y, { -: [mid_y, { /: [box_h, 2.0] }] }]

      # An arrowhead is drawn by going past the tip and coming BACK: project every
      # point on the line's own direction, and the farthest projection is the real
      # tip. If the last point sits well behind it, the pen returned -- that is the
      # head. Measuring the return rather than looking for a "V" costs one pass and
      # does not care which way round the head was drawn.
      - def:
          name: stroke_end
          args: [[pts, buffer<f32>], [count, i32], [out, ref<Guess>]]
          body:
            - set: [out.has_head, 0]
            - if: { condition: { lt: [count, 3] }, then: [{ return: null }] }
            - decl: [first_x, f32, { call: [pts.get, 0] }]
            - decl: [first_y, f32, { call: [pts.get, 1] }]
            - decl: [last_x, f32, { call: [pts.get, { "*": [{ -: [count, 1] }, 2] }] }]
            - decl: [last_y, f32, { call: [pts.get, { +: [{ "*": [{ -: [count, 1] }, 2] }, 1] }] }]
            - set: [out.tip_x, last_x]
            - set: [out.tip_y, last_y]
            - decl: [dir_x, f32, { -: [last_x, first_x] }]
            - decl: [dir_y, f32, { -: [last_y, first_y] }]
            - decl: [span, f32, { call: [math.sqrt, { +: [{ "*": [dir_x, dir_x] }, { "*": [dir_y, dir_y] }] }] }]
            - if: { condition: { lt: [span, 1.0] }, then: [{ return: null }] }
            - set: [dir_x, { /: [dir_x, span] }]
            - set: [dir_y, { /: [dir_y, span] }]
            - decl: [best, f32, -1000000.0]
            - decl: [best_x, f32, last_x]
            - decl: [best_y, f32, last_y]
            - decl: [idx, i32, 0]
            - while:
                condition: { lt: [idx, count] }
                body:
                  - decl: [spot_x, f32, { call: [pts.get, { "*": [idx, 2] }] }]
                  - decl: [spot_y, f32, { call: [pts.get, { +: [{ "*": [idx, 2] }, 1] }] }]
                  - decl: [along, f32, { +: [{ "*": [{ -: [spot_x, first_x] }, dir_x] }, { "*": [{ -: [spot_y, first_y] }, dir_y] }] }]
                  - if:
                      condition: { gt: [along, best] }
                      then:
                        - set: [best, along]
                        - set: [best_x, spot_x]
                        - set: [best_y, spot_y]
                  - set: [idx, { +: [idx, 1] }]
            - decl: [end_along, f32, { +: [{ "*": [{ -: [last_x, first_x] }, dir_x] }, { "*": [{ -: [last_y, first_y] }, dir_y] }] }]
            - decl: [back, f32, { -: [best, end_along] }]
            # a head is a visible return, not a wobble: 6% of the line, at least 6 units
            - decl: [need, f32, { "*": [span, 0.06] }]
            - if: { condition: { lt: [need, 6.0] }, then: [{ set: [need, 6.0] }] }
            - if:
                condition: { gt: [back, need] }
                then:
                  - set: [out.has_head, 1]
                  - set: [out.tip_x, best_x]
                  - set: [out.tip_y, best_y]

      # §7.3: the decision table.  Ordered; first match wins.
      - def:
          name: guess
          args: [[pts, buffer<f32>], [count, i32], [out, ref<Guess>]]
          return: i32
          body:
            - set: [out.found, 0]
            - if: { condition: { lt: [count, 4] }, then: [{ return: 0 }] }

            - decl: [span, f32, { call: [<.path_length, pts, count] }]
            - if: { condition: { lt: [span, 1.0] }, then: [{ return: 0 }] }
            - decl: [first_x, f32, { call: [pts.get, 0] }]
            - decl: [first_y, f32, { call: [pts.get, 1] }]
            - decl: [last_x, f32, { call: [pts.get, { "*": [{ -: [count, 1] }, 2] }] }]
            - decl: [last_y, f32, { call: [pts.get, { +: [{ "*": [{ -: [count, 1] }, 2] }, 1] }] }]
            - decl: [gap, f32, { call: [math.sqrt, { +: [{ "*": [{ -: [last_x, first_x] }, { -: [last_x, first_x] }] }, { "*": [{ -: [last_y, first_y] }, { -: [last_y, first_y] }] }] }] }]
            - set: [out.closed, { /: [gap, span] }]
            - call: [<.measure_turns, pts, count, out]
            - call: [<.straighten, pts, count, out]
            - decl: [area, f32, { call: [<.shoelace, pts, count] }]
            - set: [out.fill, { /: [area, { "*": [out.width, out.height] }] }]

            # open stroke -> a connector, which the editor turns into an edge
            - if:
                condition: { gt: [out.closed, 0.15] }
                then: [{ return: 0 }]

            - if:
                condition: { "&&": [{ eq: [out.corners, 4] }, { gt: [out.fill, 0.80] }] }
                then: [{ set: [out.kind, NodeKind.rect] }, { set: [out.found, 1] }, { return: 1 }]
            - if:
                condition: { "&&": [{ eq: [out.corners, 4] }, { "&&": [{ gt: [out.fill, 0.38] }, { lt: [out.fill, 0.68] }] }] }
                then: [{ set: [out.kind, NodeKind.diamond] }, { set: [out.found, 1] }, { return: 1 }]
            - if:
                condition: { "&&": [{ ge: [out.corners, 5] }, { "&&": [{ le: [out.corners, 7] }, { gt: [out.fill, 0.70] }] }] }
                then: [{ set: [out.kind, NodeKind.hexagon] }, { set: [out.found, 1] }, { return: 1 }]
            - if:
                condition: { "&&": [{ le: [out.corners, 1] }, { gt: [out.fill, 0.62] }] }
                then:
                  - decl: [ratio, f32, { /: [out.width, out.height] }]
                  - if:
                      condition: { "&&": [{ gt: [ratio, 0.85] }, { lt: [ratio, 1.18] }] }
                      then: [{ set: [out.kind, NodeKind.circle] }]
                      else: [{ set: [out.kind, NodeKind.round] }]
                  - set: [out.found, 1]
                  - return: 1
            # a closed stroke that fits nothing is still a box: the author drew a
            # closed shape, and discarding it would lose the work
            - set: [out.kind, NodeKind.rect]
            - set: [out.found, 1]
            - return: 1
